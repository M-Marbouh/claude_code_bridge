    "codex": ("CODEX_SESSION_ID", "CODEX_RUNTIME_DIR"),
    "gemini": ("GEMINI_SESSION_ID", "GEMINI_RUNTIME_DIR"),
    "opencode": ("OPENCODE_SESSION_ID", "OPENCODE_RUNTIME_DIR"),
}


def _queued_notice(provider: str, route: ResolvedRoute, work_dir: Path) -> str:
    """Describe the exact destination queue without holding up submission."""
    result: list[str] = []

    def probe() -> None:
        try:
            result.append(_query_queued_notice(provider, route, work_dir))
        except Exception:
            return

    thread = threading.Thread(target=probe, daemon=True)
    thread.start()
    thread.join(timeout=0.25)
    return result[0] if result else ""


def _query_queued_notice(provider: str, route: ResolvedRoute, work_dir: Path) -> str:
    """Describe a busy exact destination queue when askd status is available."""
    if not route.present:
        return ""
    expected_key = route_session_key(provider, route)
    try:
        queues = daemon_queue_status(
            work_dir,
            provider,
            expected_key,
            timeout_s=0.25,
        )
    except Exception:
        return ""
    try:
        queue = next((item for item in queues if item.get("session_key") == expected_key), None)
        if queue is None or not queue.get("in_flight"):
            return ""
        task = queue["in_flight"]
        req_id = str(task.get("req_id") or "")
        running_s = task.get("running_s")
        waiting = int(queue.get("waiting") or 0)
        if not req_id or running_s is None:
            return ""
        return f"[CCB_QUEUED waiting={waiting} busy_with={req_id} running={running_s}s]"
    except Exception:
        return ""



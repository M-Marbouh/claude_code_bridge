def _caller_pane_info() -> tuple[str, str]:
    """Return (pane_id, terminal_type) from the current environment."""
    tmux = (os.environ.get("TMUX_PANE") or "").strip()
    if tmux:
        return tmux, "tmux"
    wez = (os.environ.get("WEZTERM_PANE") or "").strip()
    if wez:
        return wez, "wezterm"
    return "", ""


# A route resolved by one `ask` invocation's preflight must reach the
# `--foreground` re-invocation the default async path spawns as a detached
# child process, WITHOUT that child resolving it again — these are the only
# channel between the two: plain environment variables, the same mechanism
# already used to carry caller pane identity across that same boundary.
_ROUTE_ENV_LIVE_ID = "CCB_ROUTE_LIVE_ID"
_ROUTE_ENV_LAUNCH_ID = "CCB_ROUTE_LAUNCH_ID"
_ROUTE_ENV_CALLER_LIVE_ID = "CCB_ROUTE_CALLER_LIVE_ID"
_ROUTE_ENV_CALLER_TOKEN = "CCB_ROUTE_CALLER_TOKEN"
_ROUTE_ENV_CALLER_PANE_ID = "CCB_ROUTE_CALLER_PANE_ID"
_ROUTE_ENV_CALLER_TERMINAL = "CCB_ROUTE_CALLER_TERMINAL"
_ROUTE_ENV_PANE_ID = "CCB_ROUTE_PANE_ID"
_ROUTE_ENV_TERMINAL = "CCB_ROUTE_TERMINAL"
_ROUTE_ENV_SESSION_FILE = "CCB_ROUTE_SESSION_FILE"
_ROUTE_ENV_PROJECT_ID = "CCB_ROUTE_PROJECT_ID"
# Binds the exported route to the ONE task it was resolved for. Without
# this, a route env var left over in a reused/inherited shell environment
# could be mistaken for a fresh preflight result by a later, unrelated
# invocation that happens to inherit the same environment.
_ROUTE_ENV_TASK_ID = "CCB_ROUTE_TASK_ID"

_ROUTE_ENV_FIELD_NAMES = {
    "live_id": _ROUTE_ENV_LIVE_ID,
    "launch_id": _ROUTE_ENV_LAUNCH_ID,
    "caller_live_id": _ROUTE_ENV_CALLER_LIVE_ID,
    "caller_token": _ROUTE_ENV_CALLER_TOKEN,
    "caller_pane_id": _ROUTE_ENV_CALLER_PANE_ID,
    "caller_terminal": _ROUTE_ENV_CALLER_TERMINAL,
    "pane_id": _ROUTE_ENV_PANE_ID,
    "terminal": _ROUTE_ENV_TERMINAL,
    "session_file": _ROUTE_ENV_SESSION_FILE,
    "ccb_project_id": _ROUTE_ENV_PROJECT_ID,
}


def _inherited_route_from_env() -> "ResolvedRoute | None":
    """A route carried in from a parent `ask` process's preflight, if any.

    Returns `None` when there is nothing to inherit for THIS invocation --
    no route env vars set at all, or a task-id marker mismatch (leftover
    or stale values from an unrelated invocation sharing this environment)
    -- the caller must then resolve fresh via `_preflight_target`, exactly
    once, itself. A route that WAS meant for this invocation (its task id
    matches `CCB_REQ_ID`) but is malformed raises `MalformedRouteError`:
    that must never be silently treated as absent.
    """
    task_id = (os.environ.get(_ROUTE_ENV_TASK_ID) or "").strip()
    req_id = (os.environ.get("CCB_REQ_ID") or "").strip()
    if not task_id or not req_id or task_id != req_id:
        return None
    raw = {field: (os.environ.get(env_name) or "") for field, env_name in _ROUTE_ENV_FIELD_NAMES.items()}
    route = parse_route_mapping(raw)
    return route if route.present else None


def _ps1_literal(value: str) -> str:
    """A PowerShell single-quoted string literal for `value`.

    Single-quoted PowerShell strings are fully literal -- no variable
    interpolation, no escape sequences -- so the only encoding a value
    ever needs is doubling an embedded `'`. This is deliberately NOT naive
    double-quote interpolation (`"{value}"`), which a value containing a
    `"`, a backtick, or a `$` could break out of or be interpreted inside.
    """
    return "'" + value.replace("'", "''") + "'"


def _route_env_export_lines(route: "ResolvedRoute | None", *, style: str, task_id: str) -> str:
    """Shell (`style="sh"`) or PowerShell (`style="ps1"`) lines exporting a
    resolved route -- plus the `task_id` marker `_inherited_route_from_env`
    requires to match `CCB_REQ_ID` -- for the detached child process to
    inherit. Empty when there is no route to carry — a no-inventory ask
    exports nothing, so the child's own `_inherited_route_from_env` sees
    exactly what it sees today: nothing.
    """
    if route is None or not route.present:
        return ""
    pairs = [(_ROUTE_ENV_TASK_ID, task_id)]
    for field, env_name in _ROUTE_ENV_FIELD_NAMES.items():
        value = getattr(route, field)
        if value:
            pairs.append((env_name, value))
    if style == "ps1":
        return "".join(f"$env:{name} = {_ps1_literal(value)}\n" for name, value in pairs)
    return "".join(f"export {name}={shlex.quote(value)}\n" for name, value in pairs)


def _env_int(name: str, default: int) -> int:
    raw = (os.environ.get(name) or "").strip()
    if not raw:
        return default
    try:
        return int(raw)
    except Exception:
        return default


def _cleanup_task_logs(log_dir: Path, *, preserve_task_id: str = "") -> None:
    """Keep latest task logs under log_dir."""
    max_files = _env_int("CCB_TASK_LOG_MAX_FILES", 100)
    if max_files <= 0:
        return
    try:
        logs = list(log_dir.glob("ask-*.log"))
    except Exception:
        return
    if len(logs) <= max_files:
        return
    try:
        logs.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    except Exception:
        logs.sort(key=lambda p: p.name, reverse=True)
    for path in logs[max_files:]:
        if preserve_task_id and path.stem.endswith(f"-{preserve_task_id}"):
            continue
        prefix = path.name[:-4]  # strip .log
        for ext in (".log", ".sh", ".ps1", ".msg", ".status", ".json", ".reply"):
            try:
                (log_dir / f"{prefix}{ext}").unlink(missing_ok=True)
            except Exception:
                pass


def _normalize_caller(raw: str) -> str:
    caller = (raw or "").strip().lower()
    if caller in VALID_CALLERS:
        return caller
    return ""


def _load_json_dict(path: Path) -> dict:
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict):
            return data
    except Exception:
        pass
    return {}


def _infer_caller_from_pane() -> str:
    pane_id = (os.environ.get("TMUX_PANE") or os.environ.get("WEZTERM_PANE") or "").strip()
    if not pane_id:
        return ""

    # Fast-path: CCB may export known pane ids in env for cross-pane routing.
    for caller, keys in CALLER_PANE_ENV_HINTS.items():
        for key in keys:
            value = (os.environ.get(key) or "").strip()
            if value and value == pane_id:
                return caller

    # Fallback: resolve by local session files for the current project/cwd.
    cwd = Path.cwd()
    for caller, session_filename in CALLER_SESSION_FILES.items():
        try:
            session_file = find_project_session_file(cwd, session_filename)
        except Exception:
            session_file = None
        if not session_file:
            continue
        data = _load_json_dict(session_file)
        session_pane = str(data.get("pane_id") or data.get("tmux_session") or "").strip()
        if session_pane and session_pane == pane_id:
            return caller

    return ""


def _infer_caller_from_env_hints() -> str:
    matches: list[str] = []
    for caller, keys in CALLER_ENV_HINTS.items():
        if any((os.environ.get(key) or "").strip() for key in keys):
            matches.append(caller)
    if len(matches) == 1:
        return matches[0]
    return ""


def _detect_caller() -> str:
    direct = _normalize_caller(os.environ.get("CCB_CALLER", ""))
    if direct:
        return direct

    # Email worker may carry email metadata even when CCB_CALLER isn't exported.
    if (os.environ.get("CCB_EMAIL_REQ_ID") or "").strip():
        return "email"

    pane = _infer_caller_from_pane()
    if pane:
        return pane

    hinted = _infer_caller_from_env_hints()
    if hinted:
        return hinted

    return ""


def _append_task_status_line(status_file: Path, line: str) -> None:
    """Append one timestamped lifecycle line for async task observability."""
    ts = datetime.now().strftime("%Y-%m-%dT%H:%M:%S%z")
    try:
        status_file.parent.mkdir(parents=True, exist_ok=True)
        with status_file.open("a", encoding="utf-8") as handle:
            handle.write(f"{ts} {line}\n")
    except Exception:
        pass


def _use_unified_daemon() -> bool:
    """Check if unified askd daemon should be used (default: True)."""
    val = (os.environ.get("CCB_UNIFIED_ASKD") or "").strip().lower()
    if val in ("0", "false", "no", "off"):
        return False
    return True  # Default to unified daemon


def _route_bool(value: bool) -> str:
    return "true" if bool(value) else "false"


def _route_error_line(target: str, status: ProviderRuntimeStatus, *, reason: str = "not_mounted") -> str:
    return (
        f"CCB_ROUTE_ERROR target={target} reason={reason}"
        f" configured={_route_bool(status.configured)}"
        f" registered={_route_bool(status.registered)}"
        f" pane_alive={_route_bool(status.pane_alive)}"
        f" session_bound={_route_bool(status.session_bound)}"
        f" daemon_online={_route_bool(status.daemon_online)}"
    )


def _preflight_target(
    provider: str,
    *,
    work_dir: str | Path | None = None,
    caller_pane_id: str = "",
    caller_terminal: str = "",
    caller_live_id: str = "",
    caller_token: str = "",
    caller_member_id: str = "",
    caller_member_token: str = "",
    caller_launch_id: str = "",
    route_out: dict | None = None,
    target_live_id: str = "",
) -> bool:
    """Answer whether `provider` can be reached, and -- when the record this
    answer is based on carries a `live_sessions` inventory -- resolve the
    exact destination too, writing it into `route_out` (when given) before
    returning.

    Two independent checks feed the answer:
      - `provider_status_for_target`, unchanged, is the ONLY check for a
        record with no inventory: this is the byte-identical path every
        existing caller of this function already exercises.
      - `resolve_live_route` is consulted only for records that DO carry an
        inventory. It supersedes the status check for those records rather
        than adding to it, because status's ambiguity detection has no
        caller context and cannot know a caller-specific sibling pick is
        actually unambiguous -- this is the whole reason a second live pane
        of one provider can ever be reached at all.

    `route_out`, when given, is populated in place rather than returned, so
    this function's return type stays a plain bool -- existing callers, and
    existing tests that assert `is True`/`is False` on it directly, are
    completely unaffected by a `route_out=None` default they never pass.
    """
    try:
        status = provider_status_for_target(provider, work_dir=work_dir or Path.cwd())
    except Exception as exc:
        print(f"[ERROR] Provider runtime status unavailable: {exc}", file=sys.stderr)
        return False

    try:
        outcome = resolve_live_route(
            provider,
            work_dir or Path.cwd(),
            caller_pane_id=caller_pane_id,
            caller_terminal=caller_terminal,
            caller_live_id=caller_live_id,
            caller_token=caller_token,
            caller_member_id=caller_member_id,
            caller_member_token=caller_member_token,
            caller_launch_id=caller_launch_id,
            target_live_id=target_live_id,
        )
    except Exception as exc:
        print(f"[ERROR] Live-session route unavailable: {exc}", file=sys.stderr)
        return False

    if outcome is None and target_live_id:
        # Without a live-session inventory there is no exact session to
        # name; falling through would send to the provider default instead.
        print(
            f"CCB_ROUTE_ERROR target={provider} reason=no_inventory "
            f"detail={shlex.quote('this launch has no live session IDs to address')}",
            file=sys.stderr,
        )
        return False

    if outcome is not None:
        resolution, caller = outcome
        if not resolution.ok:
            print(
                f"CCB_ROUTE_ERROR target={provider} reason={resolution.error} "
                f"detail={shlex.quote(resolution.detail)}",
                file=sys.stderr,
            )
            return False
        if route_out is not None:
            route_out.update(
                live_id=resolution.session.live_id,
                launch_id=resolution.session.launch_id,
                caller_live_id=caller.live_id if caller else "",
                caller_token=caller_token if caller else "",
                caller_pane_id=caller.pane_id if caller else "",
                caller_terminal=caller.terminal if caller else "",
                pane_id=resolution.session.pane_id,
                terminal=resolution.session.terminal,
                session_file=resolution.session.session_file,
                ccb_project_id=resolution.session.ccb_project_id,
            )
        return True

    if status.mounted:
        return True
    print(_route_error_line(provider, status), file=sys.stderr)
    return False


def _find_running_unified_state_file(
    *,
    work_dir: str | Path | None = None,
    timeout_s: float = 0.5,
) -> Path | None:
    """Locate a reachable project askd without relying on inherited CCB_RUN_DIR."""
    from askd_runtime import find_running_state_file

    return find_running_state_file(
        "askd.json",
        protocol_prefix="ask",
        work_dir=work_dir or Path.cwd(),
        timeout_s=timeout_s,
    )


def _resolve_unified_daemon_context() -> _UnifiedDaemonContext | None:
    """Resolve one reachable daemon state for availability, preflight, and dispatch."""
    import askd_rpc

    state_file = _find_running_unified_state_file()
    if state_file is None and _maybe_start_unified_daemon():
        state_file = _find_running_unified_state_file()
    if state_file is None:
        return None
    state = askd_rpc.read_state(state_file)
    if not isinstance(state, dict):
        return None
    work_dir = daemon_work_dir_from_state(state, fallback=Path.cwd())
    return _UnifiedDaemonContext(state_file=state_file, state=state, work_dir=work_dir)


def _maybe_start_unified_daemon() -> bool:
    """Try to start unified askd daemon if not running."""
    import shutil
    import time
    import sys
    from askd_runtime import state_file_candidates
    from askd.daemon import ping_daemon

    autostart_raw = (os.environ.get("CCB_ASKD_AUTOSTART") or "").strip().lower()
    if autostart_raw in ("0", "false", "no", "off"):
        return False

    # Check every project-aware candidate before starting another daemon.
    running_state = _find_running_unified_state_file()
    if running_state is not None:
        return True

    candidates = state_file_candidates("askd.json", work_dir=Path.cwd())
    state_file = candidates[0]

    # A managed Codex client cannot launch a useful terminal-aware daemon from
    # inside its sandbox. The CCB-owned host daemon must be restarted instead.
    if inside_managed_codex_sandbox():
        return False

    # Find askd binary
    candidates: list[str] = []
    local = (Path(__file__).resolve().parent / "askd")
    if local.exists():
        candidates.append(str(local))
    found = shutil.which("askd")
    if found:
        candidates.append(found)
    if not candidates:
        return False

    # Prepare command with cross-platform handling
    entry = candidates[0]
    lower = entry.lower()
    if lower.endswith((".cmd", ".bat", ".exe")):
        argv = [entry]
    else:
        argv = [sys.executable, entry]

    # Start daemon in background with platform-specific flags
    try:
        child_env = os.environ.copy()
        child_env.pop("CCB_PARENT_PID", None)
        child_env.pop("CCB_MANAGED", None)
        child_env["CCB_RUN_DIR"] = str(state_file.parent)
        kwargs = {
            "stdin": subprocess.DEVNULL,
            "stdout": subprocess.DEVNULL,
            "stderr": subprocess.DEVNULL,
            "close_fds": True,
            "env": child_env,
        }
        if os.name == "nt":
            kwargs["creationflags"] = getattr(subprocess, "DETACHED_PROCESS", 0) | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
        else:
            kwargs["start_new_session"] = True
        subprocess.Popen(argv, **kwargs)
    except Exception:
        return False

    # Wait for daemon to be ready
    deadline = time.time() + 2.0
    while time.time() < deadline:
        if ping_daemon(timeout_s=0.2, state_file=state_file):
            return True
        time.sleep(0.1)

    return False


def _send_via_unified_daemon(
    provider: str,
    message: str,
    timeout: float,
    no_wrap: bool,
    caller: str,
    *,
    delivery_only: bool = False,
    suppress_completion_hook: bool = False,
    daemon_context: _UnifiedDaemonContext | None = None,
    route: ResolvedRoute | None = None,
    async_submit: bool = False,
    request_id: str = "",
    timeout_explicit: bool = True,
    kind: str = "",
    to_role: str = "",
    reply_to: str = "",
    preflight_done: bool = False,
) -> int:
    # `reply_to` marks a correlated reply: it returns to its original
    # requester, so the host judges it as kind=reply rather than as new work.
    """Send request via unified askd daemon with auto-start retry."""
    import askd_rpc

    context = daemon_context or _resolve_unified_daemon_context()
    if context is None:
        print("[ERROR] Unified askd daemon not running", file=sys.stderr)
        return EXIT_ERROR
    state = context.state
    token = state.get("token") or ""
    daemon_work_dir = str(context.work_dir)

    if not token:
        print("[ERROR] Invalid askd state", file=sys.stderr)
        return EXIT_ERROR

    caller_pane_id, caller_terminal = _caller_pane_info()
    if route is not None and route.present and route.caller_live_id and route.caller_token:
        # The host already authenticated this caller and returned its exact
        # launch pane. Do not replace that evidence with an unrelated outer
        # terminal variable retained by a provider sandbox.
        caller_pane_id = route.caller_pane_id
        caller_terminal = route.caller_terminal

    req = {
        "type": "ask.request",
        "v": 1,
        "id": make_task_id(),
        "token": token,
        "provider": provider,
        "work_dir": daemon_work_dir,
        "timeout_s": timeout,
        "timeout_explicit": timeout_explicit,
        "message": message,
        "no_wrap": no_wrap,
        "caller": caller,
        "caller_pane_id": caller_pane_id,
        "caller_terminal": caller_terminal,
        "delivery_only": delivery_only,
        "suppress_completion_hook": suppress_completion_hook,
        "async_submit": async_submit,
        "kind": kind,
        "to_role": to_role,
    }
    if reply_to:
        req["reply_to"] = reply_to
    sender_member_id, sender_member_token = _sender_credential()
    if sender_member_id and sender_member_token:
        # The sender's own launch credential: the daemon verifies it and
        # derives the sender role host-side. It is never used to pick a
        # destination.
        req["sender_member_id"] = sender_member_id
        req["sender_member_token"] = sender_member_token
    from providers import PROGRESS_MODE_PROVIDERS
    progress_mode = provider in PROGRESS_MODE_PROVIDERS and not timeout_explicit and not delivery_only
    progress_max_wait = codex_max_wait_s() if progress_mode else None
    if progress_mode:
        req["idle_timeout_s"] = codex_idle_timeout_s()
        req["max_wait_s"] = progress_max_wait
    # Async callers create the durable task ID before entering foreground mode.
    # Preserve it as the provider request ID so receipts, CCB_REQ_ID, completion
    # hooks, and `pend <task-id>` all refer to one canonical identity.
    outer_req_id = (request_id or os.environ.get("CCB_REQ_ID") or "").strip()
    if outer_req_id:
        req["req_id"] = outer_req_id
    if _env_bool("CCB_CODEX_SHOW_TIER", False):
        req["show_tier"] = True
    if route is not None and route.present:
        # A route resolved once in client-side preflight, carried unchanged
        # into the request the daemon will enqueue and validate — never
        # re-resolved here or anywhere downstream. Includes the endpoint
        # evidence (pane/terminal/session_file/project) it was resolved
        # against, so the daemon can detect a replacement rather than
        # silently following it.
        req["route"] = {
            "live_id": route.live_id,
            "launch_id": route.launch_id,
            "caller_live_id": route.caller_live_id,
            "caller_token": route.caller_token,
            "caller_pane_id": route.caller_pane_id,
            "caller_terminal": route.caller_terminal,
            "pane_id": route.pane_id,
            "terminal": route.terminal,
            "session_file": route.session_file,
            "ccb_project_id": route.ccb_project_id,
        }

    if not preflight_done and (to_role or _local_policy_needs_gate(provider, route, daemon_work_dir)):
        # G3a: a sync submit gates too, not only the announcing async paths.
        allowed, refusal = _preflight_delivery(
            provider,
            daemon_context=context,
            work_dir=daemon_work_dir,
            route=route,
            to_role=to_role,
            kind=kind or "request",
            delivery_only=delivery_only,
            reply_to=reply_to,
        )
        if not allowed:
            print(f"[ERROR] {refusal}", file=sys.stderr)
            return EXIT_ERROR

    # Pass email-related env vars for email caller
    if caller == "email":
        req["email_req_id"] = os.environ.get("CCB_EMAIL_REQ_ID", "")
        req["email_msg_id"] = os.environ.get("CCB_EMAIL_MSG_ID", "")
        req["email_from"] = os.environ.get("CCB_EMAIL_FROM", "")

    # Try to send request, with one retry on connection failure only
    for attempt in range(2):
        try:
            resp = askd_rpc.request_daemon(
                state,
                req,
                connect_timeout_s=5.0,
                response_timeout_s=(
                    progress_max_wait + 10
                    if progress_mode
                    else (timeout + 10 if timeout > 0 else None)
                ),
            )
            exit_code = int(resp.get("exit_code") or 0)
            reply = resp.get("reply") or ""
            if reply:
                reply_req_id = str(
                    resp.get("req_id") or req.get("req_id") or req["id"]
                )
                print(prepare_agent_visible_reply(reply, reply_req_id))
            return exit_code
        except askd_rpc.DaemonConnectionError as e:
            if attempt == 0:
                replacement = _resolve_unified_daemon_context()
                if replacement is not None:
                    state = replacement.state
                    token = state.get("token") or ""
                    req["token"] = token
                    continue  # Retry with new connection info
            print(f"[ERROR] {e}", file=sys.stderr)
            return EXIT_ERROR
        except Exception as e:
            print(f"[ERROR] {e}", file=sys.stderr)
            return EXIT_ERROR

    return EXIT_ERROR


def _env_bool(name: str, default: bool = False) -> bool:
    val = (os.environ.get(name) or "").strip().lower()
    if not val:
        return default
    return val not in ("0", "false", "no", "off")


def _default_foreground() -> bool:
    # Allow explicit override
    if _env_bool("CCB_ASK_BACKGROUND", False):
        return False
    if _env_bool("CCB_ASK_FOREGROUND", False):
        return True
    # Default async only for Claude caller to preserve historical guardrail behavior.
    # Other callers (codex/gemini/opencode/manual) default to foreground.
    caller = _detect_caller()
    if caller == "claude":
        return False
    return True


def _should_emit_async_guardrail(caller: str) -> bool:
    """
    Decide whether to print strict async guardrail text.

    Override with CCB_ASK_EMIT_GUARDRAIL=0/1.
    Default: enabled only when caller is Claude.
    """
    raw = (os.environ.get("CCB_ASK_EMIT_GUARDRAIL") or "").strip().lower()
    if raw:
        return raw not in ("0", "false", "no", "off")
    return (caller or "").strip().lower() == "claude"


def _require_caller() -> str:
    caller = _detect_caller()
    if caller:
        return caller
    default_caller = _normalize_caller(os.environ.get("CCB_CALLER_DEFAULT", ""))
    if not default_caller:
        default_caller = "manual"
    print(
        f"[WARN] CCB_CALLER not set; using '{default_caller}'. "
        "Set CCB_CALLER explicitly to override.",
        file=sys.stderr,
    )
    return default_caller


ROLE_NAMES = ("lead", "implementer", "ratifier")
DAEMON_CAPABILITY_REFUSAL = (
    "cannot confirm the CCB daemon supports role policy; restart this CCB launch"
)


def _sender_credential() -> tuple[str, str]:
    """This session's own launch credential, as exported into its pane."""
    member_id = (os.environ.get("CCB_MEMBER_ID") or "").strip()
    member_token = (os.environ.get("CCB_MEMBER_TOKEN") or "").strip()
    if not member_id or not member_token:
        member_id = member_id or (os.environ.get("CCB_LIVE_ID") or "").strip()
        member_token = member_token or (os.environ.get("CCB_LIVE_TOKEN") or "").strip()
    return member_id, member_token


def _member_credential() -> tuple[str, str]:
    """The MEMBER credential only: CCB_MEMBER_ID/CCB_MEMBER_TOKEN.

    Deliberately no LIVE fallback. Route resolution authenticates the caller's
    launch with this exact pair; the pair LIVE credential is passed alongside
    it unchanged for pair launches, which export both forms.
    """
    return (
        (os.environ.get("CCB_MEMBER_ID") or "").strip(),
        (os.environ.get("CCB_MEMBER_TOKEN") or "").strip(),
    )


def _normalized_role(value: str) -> str:
    role = (value or "").strip().lower()
    return role if role in ROLE_NAMES else ""


def _policy_check(
    destination,
    *,
    provider: str,
    to_role: str,
    kind: str,
    delivery_only: bool,
    reply_to: str = "",
    has_peer: bool = False,
) -> tuple[bool, str]:
    """Client-side mirror of the host decision, for paths with no daemon."""
    from delivery_policy import evaluate, identify_sender

    member_id, member_token = _sender_credential()
    sender = identify_sender(destination, member_id, member_token)
    decision = evaluate(
        destination=destination,
        sender=sender,
        kind=kind,
        to_role=to_role,
        delivery_only=delivery_only,
        has_peer=has_peer,
        reply_to=reply_to,
    )
    return decision.allowed, decision.reason


def _client_destination(provider: str, *, route=None, peer_target: str = "", work_dir: str = ""):
    """Best-effort destination for any client-side policy check.

    Delegates entirely to `delivery_policy`, which resolves an unrouted
    directory through the provider's OWN session loader -- the same upward
    walk the adapter performs -- so a request from a subdirectory is judged
    by the launch its binding names, not by a hash of that subdirectory.
    """
    from delivery_policy import (
        destination_from_launch,
        destination_from_project_hint,
        destination_from_work_dir,
    )

    if route is not None and getattr(route, "present", False):
        return destination_from_launch(provider, route.launch_id, route.live_id)
    if peer_target:
        return destination_from_project_hint(provider, peer_target)
    return destination_from_work_dir(provider, work_dir or Path.cwd())


def _legacy_policy_refusal(
    provider: str,
    *,
    peer_target: str,
    to_role: str,
    kind: str,
    delivery_only: bool,
    route=None,
    work_dir: str = "",
    reply_to: str = "",
) -> str:
    """Refusal for ANY delivery path that would bypass the daemon gate.

    Covers `CCB_UNIFIED_ASKD=0` and the per-provider legacy notify/foreground
    branches that the unified daemon does not serve (G2). An enforcing
    destination always refuses here, because this path cannot ask the host
    to recheck before injection.
    """
    from delivery_policy import MODE_ENFORCE

    destination = _client_destination(
        provider, route=route, peer_target=peer_target, work_dir=work_dir
    )
    if destination.mode == MODE_ENFORCE:
        return (
            "role policy requires the unified daemon: this destination enforces roles and "
            "legacy delivery would bypass the gate"
        )
    allowed, reason = _policy_check(
        destination,
        provider=provider,
        to_role=to_role,
        kind=kind,
        delivery_only=delivery_only,
        has_peer=bool(peer_target),
        reply_to=reply_to,
    )
    return "" if allowed else reason


def gate_required(
    provider: str,
    *,
    to_role: str = "",
    route=None,
    peer_target: str = "",
    work_dir: str = "",
) -> bool:
    """Does this delivery need the host's gate?

    An explicit --to-role always does. So does a destination whose own
    policy is enforcing (or unreadable), because the client cannot verify
    the matrix on its own.
    """
    if (to_role or "").strip():
        return True
    from delivery_policy import MODE_ENFORCE, MODE_ERROR, destination_is_known

    try:
        destination = _client_destination(
            provider, route=route, peer_target=peer_target, work_dir=work_dir
        )
    except Exception:
        return True
    return destination_is_known(destination) and destination.mode in (MODE_ENFORCE, MODE_ERROR)


def _local_policy_needs_gate(provider: str, route, work_dir: str) -> bool:
    """Does this destination require the host's gate (cheap client-side read)?"""
    from delivery_policy import MODE_ENFORCE, MODE_ERROR

    try:
        destination = _client_destination(provider, route=route, work_dir=work_dir)
    except Exception:
        return True
    return destination.mode in (MODE_ENFORCE, MODE_ERROR)


def _peer_preflight_kind(intent: str, reply_to: str) -> str:
    """Logical kind of a peer dispatch: replies are not new work."""
    if (reply_to or "").strip():
        return "reply"
    return "notify" if intent == "notify" else "request"


def _preflight_delivery(
    provider: str,
    *,
    daemon_context: _UnifiedDaemonContext | None,
    work_dir: str,
    route: ResolvedRoute | None = None,
    peer_target: str = "",
    to_role: str = "",
    kind: str = "request",
    delivery_only: bool = False,
    reply_to: str = "",
    live_id: str = "",
) -> tuple[bool, str]:
    """Read-only host-side preflight, so a refusal is never announced as a submission.

    Advisory: the daemon's accept gate remains authoritative for the real
    request. When the op is unavailable this returns allow rather than
    inventing a second policy engine in the client.
    """
    import askd_rpc

    if daemon_context is None:
        return True, ""
    state = daemon_context.state
    token = state.get("token") or ""
    if not token:
        return True, ""
    member_id, member_token = _sender_credential()
    req = {
        "type": "ask.request",
        "v": 1,
        "id": make_task_id(),
        "token": token,
        "operation": "check_delivery",
        "provider": "",
        "target_provider": provider,
        "work_dir": str(work_dir or ""),
        "kind": kind,
        "to_role": to_role,
        "delivery_only": delivery_only,
        "reply_to": reply_to,
        "sender_member_id": member_id,
        "sender_member_token": member_token,
        "caller": _require_caller(),
    }
    if route is not None and route.present:
        req["route"] = {
            "live_id": route.live_id,
            "launch_id": route.launch_id,
            "caller_live_id": route.caller_live_id,
            "caller_token": route.caller_token,
            "caller_pane_id": route.caller_pane_id,
            "caller_terminal": route.caller_terminal,
            "pane_id": route.pane_id,
            "terminal": route.terminal,
            "session_file": route.session_file,
            "ccb_project_id": route.ccb_project_id,
        }
    if peer_target:
        req["project_hint"] = peer_target
        # A peer target is always a delivery-only send, so the logical kind
        # check must treat it as the peer transport it is.
        req["peer_transport"] = True
    if live_id:
        req["target_live_id"] = live_id
    try:
        response = askd_rpc.request_daemon(
            state, req, connect_timeout_s=5.0, response_timeout_s=10.0
        )
    except Exception:
        # H3a: when the gate is required, an unreachable capability probe is
        # a refusal, not a pass.
        if gate_required(
            provider, to_role=to_role, route=route,
            peer_target=peer_target, work_dir=work_dir,
        ):
            return False, DAEMON_CAPABILITY_REFUSAL
        return True, ""
    if not isinstance(response, dict):
        if gate_required(
            provider, to_role=to_role, route=route,
            peer_target=peer_target, work_dir=work_dir,
        ):
            return False, DAEMON_CAPABILITY_REFUSAL
        return True, ""
    if "allowed" not in response:
        # Mixed versions (H3a). A daemon that does not answer this op cannot
        # gate anything, so it may only be used where nothing needs gating:
        # no explicit assertion and a destination that is not enforcing.
        if gate_required(
            provider, to_role=to_role, route=route,
            peer_target=peer_target, work_dir=work_dir,
        ):
            return False, DAEMON_CAPABILITY_REFUSAL
        return True, ""
    if response.get("allowed") is False:
        return False, str(response.get("reason") or "role policy refused this delivery")
    return True, ""


def make_task_id() -> str:
    """Generate task ID: YYYYMMDD-HHMMSS-mmm-PID"""
    now = datetime.now()
    ms = now.microsecond // 1000
    return f"{now.strftime('%Y%m%d-%H%M%S')}-{ms:03d}-{os.getpid()}"


def _read_resend_message(task_id: str) -> tuple[str | None, str]:
    if not _TASK_ID_RE.fullmatch(task_id):
        return None, "[ERROR] Invalid --resend task ID"
    try:
        datetime.strptime(task_id[:15], "%Y%m%d-%H%M%S")
    except ValueError:
        return None, "[ERROR] Invalid --resend task ID"

    log_dir = Path(tempfile.gettempdir()) / "ccb-tasks"
    candidates = [
        log_dir / f"ask-{source_provider}-{task_id}.msg"
        for source_provider in PROVIDER_DAEMONS
    ] + [
        log_dir / f"ask-peer-{source_provider}-{task_id}.msg"
        for source_provider in PROVIDER_DAEMONS
    ]
    matches = [path for path in candidates if path.exists()]
    if not matches:
        return None, f"[ERROR] No retained message file for task ID {task_id}"
    if len(matches) > 1:
        return None, f"[ERROR] Multiple retained message files match task ID {task_id}"

    try:
        message = matches[0].read_bytes().decode("utf-8")
    except (OSError, UnicodeError) as exc:
        return None, f"[ERROR] Cannot read retained message file for task ID {task_id}: {exc}"
    if not message:
        return None, f"[ERROR] Retained message file is empty for task ID {task_id}"
    return message, ""


def _usage() -> None:
    print("Usage: ask <provider> [options] <message>", file=sys.stderr)
    print("       ask --peer <target> [options] <message>", file=sys.stderr)
    print("", file=sys.stderr)
    print("Providers:", file=sys.stderr)
    print("  gemini, codex, opencode, claude, hermes, pi", file=sys.stderr)
    print("", file=sys.stderr)
    print("Options:", file=sys.stderr)
    print("  -h, --help              Show this help message", file=sys.stderr)
    print("  -t, --timeout SECONDS   Request timeout (default: 3600)", file=sys.stderr)
    print("  --notify                One-way notification; peer messages expect no reply", file=sys.stderr)
    print("  --foreground            Run in foreground (no nohup/background)", file=sys.stderr)
    print("  --background            Background task or non-blocking peer consultation", file=sys.stderr)
    print("  --no-wrap               Don't wrap with CCB protocol markers", file=sys.stderr)
    print("  --peer TARGET           Send to the selected provider in another CCB project", file=sys.stderr)
    print("                          TARGET may be <project> (local) or <host>::<project> (another", file=sys.stderr)
    print("                          machine, one-way delivery: no reply, no wait, never retried)", file=sys.stderr)
    print("  --wait                  Peer reply blocks the sender's next action (default)", file=sys.stderr)
    print("  --reply-to TASK_ID      Correlate a peer response with an earlier task", file=sys.stderr)
    print("  --live-id ID            Deliver to this exact live session (this launch, or --peer's)", file=sys.stderr)
    print("  --to-role ROLE          Require the destination session's role (lead/implementer/ratifier)", file=sys.stderr)
    print("  --resend TASK_ID        Re-send a retained .msg body as a new request; requires --live-id", file=sys.stderr)
    print("                          The original task is untouched; no deduplication or exactly-once delivery is promised.", file=sys.stderr)
    print("                          Cleanup keeps the newest 100 logs and removes each .msg with its log; /tmp has no reboot guarantee.", file=sys.stderr)
    print("                          Only detached local and peer tasks retain .msg files.", file=sys.stderr)
    print("", file=sys.stderr)
    print("Role policy: a launch started with --role-policy enforce (or role_policy=enforce in", file=sys.stderr)
    print("ccb.config) refuses role-violating asks. It guards against misrouting, not permissions:", file=sys.stderr)
    print("it restricts edits, push or deploy to nothing.", file=sys.stderr)
    print("", file=sys.stderr)
    print("Local pair: in ccb codex codex, ask codex addresses the verified sibling.", file=sys.stderr)
    print("Peer targets must be unique in the remote project; ambiguity is an error.", file=sys.stderr)
    print("Use --live-id (from ccb-list --json) to name one session when several are live.", file=sys.stderr)


def _peer_caller_pane_info() -> tuple[str, str]:
    pane_id = (os.environ.get("CCB_CALLER_PANE_ID") or "").strip()
    terminal = (os.environ.get("CCB_CALLER_TERMINAL") or "").strip()
    if pane_id and terminal:
        return pane_id, terminal
    detected_pane_id, detected_terminal = _caller_pane_info()
    return pane_id or detected_pane_id, terminal or detected_terminal


def _normalized_work_dir(value: str | Path | None) -> Path | None:
    raw = str(value or "").strip()
    if not raw:
        return None
    candidate = Path(raw).expanduser()
    try:
        return candidate.resolve()
    except Exception:
        return candidate.absolute()


def _same_work_dir(left: str | Path, right: str | Path) -> bool:
    left_path = _normalized_work_dir(left)
    right_path = _normalized_work_dir(right)
    return left_path is not None and right_path is not None and left_path == right_path


def _active_sender_records(candidate: Path, caller: str) -> list[RegistryProviderRecord]:
    if not candidate.is_dir():
        return []
    try:
        project_id = compute_ccb_project_id(candidate)
        records = [
            record
            for record in iter_registry_provider_records(project_id=project_id)
            if _same_work_dir(record.work_dir, candidate)
        ]
    except Exception:
        return []

    if caller in PEER_PROVIDERS:
        records = [record for record in records if record.provider == caller]
    return records


def _sender_candidate_evidence(candidate: Path, caller: str) -> _SenderCandidateEvidence:
    if not candidate.is_dir():
        return _SenderCandidateEvidence(False, frozenset())

    # Task 2 / Item 3: identify the caller's OWN exact candidate session
    # first, validated against ITS OWN operational availability -- never
    # against a sibling's, and never against the provider-wide aggregate,
    # which reports the whole provider "ambiguous"/unmounted the instant
    # two live sessions of it exist (e.g. two Codex panes in one launch),
    # regardless of which one is actually asking. This works the same way
    # in both execution contexts below (it proxies through the host daemon
    # when sandboxed -- see `peer_routing.identify_sender`).
    caller_pane_id, caller_terminal = _peer_caller_pane_info()
    try:
        resolution = identify_sender(candidate, caller, pane_id=caller_pane_id, terminal=caller_terminal)
    except Exception:
        return _SenderCandidateEvidence(False, frozenset())
    if resolution is not None and resolution.ok:
        return _SenderCandidateEvidence(True, frozenset({resolution.candidate.pane_id}))
    if resolution is not None and resolution.error and resolution.error != peer_routing.NO_CANDIDATES:
        # Item 2 (the eighth instance of this defect): the authoritative
        # inventory WAS consulted -- ambiguity, an invalid inventory, or
        # an operational failure on the caller's own exact candidate --
        # and it gave a definitive "no". That must STOP the ask outright;
        # it must never resume the older, less rigorous legacy lookup
        # below, which could accept a pane the authoritative source just
        # refused. Only `NO_CANDIDATES` -- genuinely nothing for the
        # inventory to have an opinion about (no evidence, or no
        # registered session anywhere for this provider/project) -- falls
        # through to today's per-context behaviour below, unchanged.
        return _SenderCandidateEvidence(False, frozenset())

    if inside_managed_codex_sandbox():
        try:
            status = provider_status_for_target(caller, work_dir=candidate)
        except Exception:
            return _SenderCandidateEvidence(False, frozenset())
        pane_id = str(status.pane_id or "").strip()
        return _SenderCandidateEvidence(
            bool(status.mounted),
            frozenset({pane_id}) if pane_id else frozenset(),
        )

    records = _active_sender_records(candidate, caller)
    pane_ids = frozenset(
        str(record.provider_entry.get("pane_id") or "").strip()
        for record in records
        if str(record.provider_entry.get("pane_id") or "").strip()
    )
    return _SenderCandidateEvidence(bool(records), pane_ids)


def _sender_pane_conflicts(evidence: _SenderCandidateEvidence, caller: str) -> bool:
    if caller not in PEER_PROVIDERS or not evidence.valid:
        return False
    pane_id, _terminal = _peer_caller_pane_info()
    return bool(pane_id and evidence.pane_ids and pane_id not in evidence.pane_ids)


def _resolve_sender_work_dir(caller: str) -> Path | _SenderWorkDirFailure:
    """Resolve a validated, reply-addressable sender project without daemon autostart."""
    env_candidate = _normalized_work_dir(os.environ.get("CCB_WORK_DIR"))
    env_evidence = (
        _sender_candidate_evidence(env_candidate, caller)
        if env_candidate
        else _SenderCandidateEvidence(False, frozenset())
    )

    try:
        daemon_candidate = _normalized_work_dir(resolve_daemon_work_dir())
    except Exception:
        daemon_candidate = _normalized_work_dir(Path.cwd())
    daemon_evidence = (
        _sender_candidate_evidence(daemon_candidate, caller)
        if daemon_candidate
        else _SenderCandidateEvidence(False, frozenset())
    )

    if env_evidence.valid and env_candidate is not None:
        if _sender_pane_conflicts(env_evidence, caller):
            return _SenderWorkDirFailure(
                "sender_project_mismatch",
                env_candidate,
                daemon_candidate if daemon_evidence.valid else None,
            )
        if daemon_evidence.valid and daemon_candidate is not None and daemon_candidate != env_candidate:
            return _SenderWorkDirFailure("sender_project_mismatch", env_candidate, daemon_candidate)
        return env_candidate
    if daemon_evidence.valid and daemon_candidate is not None:
        if _sender_pane_conflicts(daemon_evidence, caller):
            return _SenderWorkDirFailure("sender_project_mismatch", daemon_candidate)
        return daemon_candidate

    rejected = env_candidate or daemon_candidate or _normalized_work_dir(Path.cwd()) or Path.cwd()
    return _SenderWorkDirFailure("unmounted_sender", rejected)


def _sender_route_error_line(
    peer_provider: str,
    caller: str,
    failure: _SenderWorkDirFailure,
) -> str:
    evidence = (
        f" evidence_work_dir={shlex.quote(str(failure.evidence))}"
        if failure.evidence is not None
        else ""
    )
    return (
        f"CCB_ROUTE_ERROR target={peer_provider} reason={failure.reason}"
        f" sender_work_dir={shlex.quote(str(failure.candidate))}"
        f"{evidence}"
        f" caller={caller} provider={peer_provider}"
    )


def _notify_requests_reply(message: str) -> bool:
    """Reject the clearest contradictory intent: a notification ending in a question."""
    return (message or "").rstrip().endswith("?")


def _valid_peer_correlation_id(value: str) -> bool:
    return not value or _PEER_CORRELATION_ID_RE.fullmatch(value) is not None


def _valid_peer_live_id(value: str) -> bool:
    # The registry owns live-ID syntax. The client only requires the
    # non-empty opaque value emitted by ccb-list.
    return bool(value.strip())


def _peer_live_id_error(
    live_id: str,
    live_id_seen: bool,
    peer_target: str,
    reply_to: str,
) -> str:
    """Every `--live-id` refusal, applied before any dispatch.

    The selector names an exact session: in another project with --peer,
    or in this launch without it. It must never compete with the saved
    return address of a correlated reply -- that destination is already
    pinned by the receipt -- so that case refuses outright rather than
    resolving a precedence rule the sender cannot see.
    """
    if not live_id_seen:
        return ""
    if not live_id:
        return "[ERROR] --live-id requires a live session ID"
    if not _valid_peer_live_id(live_id):
        # Checked before the peer-target rule so a selector that swallowed
        # the following option token reports its real cause.
        return "[ERROR] Invalid --live-id"
    if reply_to:
        return (
            "[ERROR] --live-id cannot be combined with --reply-to; a correlated "
            "reply is delivered to the saved return session"
        )
    return ""


def _peer_bridge_cmd(
    peer_target: str,
    peer_provider: str,
    timeout: float,
    caller_pane_id: str,
    caller_terminal: str,
    sender_work_dir: str,
    caller: str,
    intent: str,
    task_id: str = "",
    reply_to: str = "",
    foreground: bool = False,
    live_id: str = "",
    to_role: str = "",
) -> list[str]:
    bridge_cmd = Path(__file__).resolve().parent / "ccb-bridge-ask"
    cmd = [
        sys.executable,
        str(bridge_cmd),
        "--target",
        peer_target,
        "--provider",
        peer_provider,
        "--timeout",
        str(timeout),
        "--caller-pane-id",
        caller_pane_id,
        "--caller-terminal",
        caller_terminal,
        "--sender-work-dir",
        sender_work_dir,
        "--caller",
        caller,
        "--intent",
        intent,
    ]
    if task_id:
        cmd.extend(["--peer-task-id", task_id])
    if reply_to:
        cmd.extend(["--reply-to", reply_to])
    if live_id:
        # Threaded as its own option -- never folded into the target
        # string or the message body, so the bridge resolves the project
        # and the session selector independently.
        cmd.extend(["--live-id", live_id])
    if to_role:
        cmd.extend(["--to-role", to_role])
    if foreground:
        cmd.append("--foreground")
    return cmd


def _run_peer_bridge_foreground(
    peer_target: str,
    peer_provider: str,
    timeout: float,
    message: str,
    caller: str,
    intent: str,
    reply_to: str,
    sender_work_dir: Path,
    *,
    live_id: str = "",
    preserve_task_id: str = "",
    to_role: str = "",
) -> int:
    caller_pane_id, caller_terminal = _peer_caller_pane_info()
    sender_work_dir_str = str(sender_work_dir)
    task = None
    if intent != "notify":
        task = _prepare_peer_task(
            peer_provider,
            message,
            caller,
            intent,
            sender_work_dir,
            timeout,
            caller_pane_id,
            caller_terminal,
            preserve_task_id=preserve_task_id,
        )
        if task is None:
            return EXIT_ERROR
    cmd = _peer_bridge_cmd(
        peer_target,
        peer_provider,
        timeout,
        caller_pane_id,
        caller_terminal,
        sender_work_dir_str,
        caller,
        intent,
        task_id=task.task_id if task is not None else "",
        reply_to=reply_to,
        foreground=True,
        live_id=live_id,
        to_role=to_role,
    )
    env = os.environ.copy()
    env["CCB_CALLER"] = caller
    env["CCB_WORK_DIR"] = sender_work_dir_str
    if task is not None:
        env["CCB_REQ_ID"] = task.task_id
        env["CCB_PEER_STATUS_FILE"] = str(task.status_file)
        env["CCB_PEER_LOG_FILE"] = str(task.log_file)
        env["CCB_PEER_PROVIDER"] = peer_provider
    if reply_to:
        env["CCB_PEER_REPLY_TO"] = reply_to
    if caller_pane_id:
        env["CCB_CALLER_PANE_ID"] = caller_pane_id
    if caller_terminal:
        env["CCB_CALLER_TERMINAL"] = caller_terminal
    try:
        result = subprocess.run(cmd, input=message, text=True, env=env)
        if result.returncode == EXIT_OK and task is not None:
            _print_peer_task_submission(peer_provider, intent, task, caller)
        return result.returncode
    except Exception as e:
        print(f"[ERROR] {e}", file=sys.stderr)
        return EXIT_ERROR


def _prepare_peer_task(
    peer_provider: str,
    message: str,
    caller: str,
    intent: str,
    sender_work_dir: Path,
    timeout: float,
    caller_pane_id: str,
    caller_terminal: str,
    *,
    preserve_task_id: str = "",
) -> _PeerTaskFiles | None:
    task_id = make_task_id()
    if preserve_task_id and task_id == preserve_task_id:
        print("[ERROR] Could not create a fresh task ID for --resend", file=sys.stderr)
        return None
    log_dir = Path(tempfile.gettempdir()) / "ccb-tasks"
    log_file = log_dir / f"ask-peer-{peer_provider}-{task_id}.log"
    status_file = log_dir / f"ask-peer-{peer_provider}-{task_id}.status"
    msg_file = log_dir / f"ask-peer-{peer_provider}-{task_id}.msg"
    reply_file = log_dir / f"ask-peer-{peer_provider}-{task_id}.reply"
    receipt_file = receipt_path(f"peer-{peer_provider}", task_id, root=log_dir)

    try:
        caller_live_id = ""
        caller_registry_session_id = ""
        caller_pane_title_marker = ""
        if caller in PEER_PROVIDERS:
            resolution = identify_sender(
                sender_work_dir,
                caller,
                pane_id=caller_pane_id,
                terminal=caller_terminal,
            )
            if resolution.ok:
                candidate = resolution.candidate
                caller_live_id = candidate.live_id
                caller_registry_session_id = candidate.launch_id
                caller_pane_title_marker = candidate.pane_title_marker
            elif resolution.error != peer_routing.NO_CANDIDATES:
                raise RuntimeError(
                    resolution.detail or "could not pin the peer sender's live session"
                )
        log_dir.mkdir(parents=True, exist_ok=True)
        log_file.touch(exist_ok=True)
        status_file.touch(exist_ok=True)
        if preserve_task_id:
            with msg_file.open("w", encoding="utf-8", newline="") as msg_handle:
                msg_handle.write(message)
        else:
            msg_file.write_text(message, encoding="utf-8")
        reply_file.touch(exist_ok=True)
        write_receipt(
            receipt_file,
            new_peer_receipt(
                task_id=task_id,
                peer_provider=peer_provider,
                caller=caller,
                intent=intent,
                work_dir=sender_work_dir,
                status_file=status_file,
                log_file=log_file,
                reply_file=reply_file,
                timeout_seconds=timeout,
                caller_pane_id=caller_pane_id,
                caller_terminal=caller_terminal,
                caller_live_id=caller_live_id,
                caller_registry_session_id=caller_registry_session_id,
                caller_pane_title_marker=caller_pane_title_marker,
            ),
        )
    except Exception as e:
        print(f"[ERROR] Failed to create peer task receipt: {e}", file=sys.stderr)
        return None
    if preserve_task_id:
        _cleanup_task_logs(log_dir, preserve_task_id=preserve_task_id)
    else:
        _cleanup_task_logs(log_dir)
    return _PeerTaskFiles(task_id, log_file, status_file, msg_file, reply_file)


def _print_peer_task_submission(
    peer_provider: str,
    intent: str,
    task: _PeerTaskFiles,
    caller: str,
) -> None:
    if intent == "background":
        print(f"[CCB_BACKGROUND_SUBMITTED provider=peer-{peer_provider} intent=background]")
        print(f"Peer {display_name(peer_provider)} consulted in background (task: {task.task_id}); continue current work.")
    else:
        print(f"[CCB_ASYNC_SUBMITTED provider=peer-{peer_provider} intent=wait]")
        print(f"Peer {display_name(peer_provider)} processing (task: {task.task_id})")
    print(f"[CCB_ASYNC_STATUS_FILE task={task.task_id}] {task.status_file}")
    print(f"[CCB_ASYNC_LOG_FILE task={task.task_id}] {task.log_file}")
    if intent == "wait" and _should_emit_async_guardrail(caller):
        print(
            f"MANDATORY: END YOUR TURN NOW. Reply ONLY "
            f"'Peer {display_name(peer_provider)} processing...', then stop."
        )


def _run_peer_bridge_background(
    peer_target: str,
    peer_provider: str,
    timeout: float,
    message: str,
    caller: str,
    intent: str,
    reply_to: str,
    sender_work_dir: Path,
    *,
    live_id: str = "",
    preserve_task_id: str = "",
    to_role: str = "",
) -> int:
    caller_pane_id, caller_terminal = _peer_caller_pane_info()
    # Phase 3 (E4/G5): the peer background path announces a submission, so
    # the read-only preflight runs before anything is spawned. A correlated
    # reply is kind=reply -- it returns to its original requester and must
    # not be judged by the external/role matrix on the way out.
    allowed, refusal = _preflight_delivery(
        peer_provider,
        daemon_context=_resolve_unified_daemon_context(),
        work_dir=str(sender_work_dir),
        peer_target=peer_target,
        to_role=to_role,
        kind=_peer_preflight_kind(intent, reply_to),
        delivery_only=True,
        reply_to=reply_to,
        live_id=live_id,
    )
    if not allowed:
        print(f"[ERROR] {refusal}", file=sys.stderr)
        return EXIT_ERROR
    task = _prepare_peer_task(
        peer_provider,
        message,
        caller,
        intent,
        sender_work_dir,
        timeout,
        caller_pane_id,
        caller_terminal,
        preserve_task_id=preserve_task_id,
    )
    if task is None:
        return EXIT_ERROR
    task_id = task.task_id
    log_file = task.log_file
    status_file = task.status_file
    msg_file = task.msg_file
    sender_work_dir_str = str(sender_work_dir)
    bridge_cmd = _peer_bridge_cmd(
        peer_target,
        peer_provider,
        timeout,
        caller_pane_id,
        caller_terminal,
        sender_work_dir_str,
        caller,
        intent,
        task_id,
        reply_to,
        live_id=live_id,
        to_role=to_role,
    )
    env = os.environ.copy()
    env["CCB_REQ_ID"] = task_id
    env["CCB_CALLER"] = caller
    env["CCB_WORK_DIR"] = sender_work_dir_str
    env["CCB_PEER_STATUS_FILE"] = str(status_file)
    env["CCB_PEER_LOG_FILE"] = str(log_file)
    env["CCB_PEER_PROVIDER"] = peer_provider
    if reply_to:
        env["CCB_PEER_REPLY_TO"] = reply_to
    if caller_pane_id:
        env["CCB_CALLER_PANE_ID"] = caller_pane_id
    if caller_terminal:
        env["CCB_CALLER_TERMINAL"] = caller_terminal

    try:
        with msg_file.open("r", encoding="utf-8") as msg_handle, log_file.open("a", encoding="utf-8") as log_handle:
            kwargs = {
                "stdin": msg_handle,
                "stdout": log_handle,
                "stderr": subprocess.STDOUT,
                "close_fds": True,
                "env": env,
            }
            if os.name == "nt":
                kwargs["creationflags"] = (
                    getattr(subprocess, "DETACHED_PROCESS", 0)
                    | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
                )
            else:
                kwargs["start_new_session"] = True
            proc = subprocess.Popen(bridge_cmd, **kwargs)
    except Exception as e:
        print(f"[ERROR] {e}", file=sys.stderr)
        return EXIT_ERROR

    _append_task_status_line(
        status_file,
        f"submitted task={task_id} provider=peer-{peer_provider} caller={caller} "
        f"target={peer_target} work_dir={sender_work_dir_str}",
    )
    _append_task_status_line(status_file, f"spawned pid={proc.pid}")

    if intent == "notify":
        print(f"[CCB_NOTIFY_SUBMITTED provider=peer-{peer_provider} intent=notify]")
        print(f"Peer {display_name(peer_provider)} notified (task: {task_id}); continue current work.")
        print(f"[CCB_ASYNC_STATUS_FILE task={task_id}] {status_file}")
        print(f"[CCB_ASYNC_LOG_FILE task={task_id}] {log_file}")
    else:
        _print_peer_task_submission(peer_provider, intent, task, caller)
    print(f"[CCB_ASYNC_PID task={task_id} pid={proc.pid}]")
    return EXIT_OK


def _remote_peer_refusal(
    *,
    provider: str,
    reply_to: str,
    wait_explicit: bool,
    foreground_explicit: bool,
    resend_seen: bool,
    to_role: str,
) -> str:
    """Why this remote peer request cannot be delivered as asked, else "".

    This milestone is delivery-only, so anything that expects a reply is
    refused BEFORE a receipt is written or a connection is made.
    """
    if provider not in ("claude", "codex"):
        return (
            f"[ERROR] Cross-machine delivery supports claude and codex only, not {provider}"
        )
    if reply_to:
        return "[ERROR] --reply-to is not available for cross-machine delivery (no reply in this milestone)"
    if wait_explicit:
        return "[ERROR] --wait is not available for cross-machine delivery: this milestone is one-way"
    if foreground_explicit:
        return "[ERROR] --foreground is not available for cross-machine delivery: this milestone is one-way"
    if resend_seen:
        return "[ERROR] --resend is not available for cross-machine delivery"
    role = (to_role or "").strip().lower()
    if role and role != "lead":
        # The destination independently enforces one rule for a remote sender:
        # the target session must hold the lead role. Another assertion could
        # only fail later, after acceptance, so refuse it here instead.
        return (
            "[ERROR] Cross-machine delivery can only assert --to-role lead; "
            f"a remote sender may not name {role}"
        )
    return ""


def _run_remote_peer(
    peer_target: str,
    peer_provider: str,
    message: str,
    *,
    intent: str,
    reply_to: str,
    live_id: str,
    to_role: str,
    sender_work_dir: str,
    caller: str,
    wait_explicit: bool = False,
    foreground_explicit: bool = False,
    resend_seen: bool = False,
) -> int:
    refusal = _remote_peer_refusal(
        provider=peer_provider,
        reply_to=reply_to,
        wait_explicit=wait_explicit,
        foreground_explicit=foreground_explicit,
        resend_seen=resend_seen,
        to_role=to_role,
    )
    if refusal:
        print(refusal, file=sys.stderr)
        return EXIT_ERROR
    from remote_client import RemoteConfigError, RemoteRefusal, caller_claims, submit

    try:
        host, project = _remote_selector(peer_target)
    except RemoteRefusal as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR
    try:
        claims = caller_claims(
            caller=caller, work_dir=sender_work_dir, role_assertion=to_role
        )
        result = submit(
            host,
            project,
            peer_provider,
            message,
            # Delivery-only contract: a remote message never waits for, or
            # expects, a reply, so the recorded and labelled intent is always
            # `notify`. Explicit --wait/--foreground/--reply-to were refused
            # above; --notify stays accepted and means the same thing here.
            intent="notify",
            dest_session=live_id,
            caller_claims=claims,
        )
    except RemoteConfigError as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR
    except RemoteRefusal as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR
    return EXIT_OK if result.ok else result.exit_code


def _remote_selector(target: str) -> tuple[str, str]:
    from remote_client import parse_selector

    return parse_selector(target)


def _run_peer_bridge(
    peer_target: str,
    peer_provider: str,
    timeout: float,
    message: str,
    foreground_mode: bool,
    intent: str,
    reply_to: str = "",
    *,
    live_id: str = "",
    preserve_task_id: str = "",
    to_role: str = "",
    wait_explicit: bool = False,
    foreground_explicit: bool = False,
    resend_seen: bool = False,
) -> int:
    if peer_provider not in PEER_PROVIDERS:
        print(
            f"[ERROR] Provider does not support cross-project peer routing: {peer_provider}",
            file=sys.stderr,
        )
        return EXIT_ERROR
    caller = _require_caller()
    # Pi is now a local caller, but it has no peer identity: refuse it here, on
    # the one path both peer syntaxes (`ask --peer T`, `ask P --peer T`) take,
    # before any project lookup, task receipt or bridge dispatch. Every other
    # caller keeps the behaviour it had before Pi could call at all.
    if caller == "pi":
        print(
            "[ERROR] Peer messaging is not available from a Pi session; "
            "start the request from a Claude or Codex pane.",
            file=sys.stderr,
        )
        return EXIT_ERROR
    if "::" in (peer_target or ""):
        # Cross-machine: a new, separate path. A target with "::" never falls
        # back to local peer lookup, so a typo cannot deliver to a local pane.
        return _run_remote_peer(
            peer_target,
            peer_provider,
            message,
            intent=intent,
            reply_to=reply_to,
            live_id=live_id,
            to_role=to_role,
            caller=caller,
            sender_work_dir=str(
                _normalized_work_dir(os.environ.get("CCB_WORK_DIR"))
                or _normalized_work_dir(Path.cwd())
                or Path.cwd()
            ),
            wait_explicit=wait_explicit,
            foreground_explicit=foreground_explicit,
            resend_seen=resend_seen,
        )
    if intent == "notify":
        sender_work_dir = (
            _normalized_work_dir(os.environ.get("CCB_WORK_DIR"))
            or _normalized_work_dir(Path.cwd())
            or Path.cwd()
        )
    else:
        resolution = _resolve_sender_work_dir(caller)
        if isinstance(resolution, _SenderWorkDirFailure):
            print(_sender_route_error_line(peer_provider, caller, resolution), file=sys.stderr)
            return EXIT_ERROR
        sender_work_dir = resolution
    if foreground_mode or inside_managed_codex_sandbox():
        return _run_peer_bridge_foreground(
            peer_target,
            peer_provider,
            timeout,
            message,
            caller,
            intent,
            reply_to,
            sender_work_dir,
            live_id=live_id,
            preserve_task_id=preserve_task_id,
            to_role=to_role,
        )
    return _run_peer_bridge_background(
        peer_target,
        peer_provider,
        timeout,
        message,
        caller,
        intent,
        reply_to,
        sender_work_dir,
        live_id=live_id,
        preserve_task_id=preserve_task_id,
        to_role=to_role,
    )


def _handle_peer_mode(argv: list[str], peer_provider: str = "claude") -> int:
    timeout: float = 3600.0
    peer_target = ""
    foreground_mode = _default_foreground()
    peer_intent = "wait"
    peer_reply_to = ""
    peer_live_id = ""
    peer_live_id_seen = False
    peer_to_role = ""
    peer_to_role_seen = False
    # Presence only: adding these to the parse loop would change what a LOCAL
    # peer target receives as message text. They are consulted only on the
    # cross-machine branch, which refuses them before writing anything.
    peer_wait_explicit = "--wait" in argv
    peer_foreground_explicit = "--foreground" in argv
    parts: list[str] = []

    it = iter(argv)
    for token in it:
        if token in ("-h", "--help"):
            _usage()
            return EXIT_OK
        if token == "--peer":
            try:
                peer_target = next(it)
            except StopIteration:
                print("[ERROR] --peer requires a target", file=sys.stderr)
                return EXIT_ERROR
            continue
        if token in ("-t", "--timeout"):
            try:
                timeout = float(next(it))
            except StopIteration:
                print("[ERROR] --timeout requires a number", file=sys.stderr)
                return EXIT_ERROR
            except ValueError:
                print("[ERROR] --timeout must be a number", file=sys.stderr)
                return EXIT_ERROR
            continue
        if token == "--reply-to":
            try:
                peer_reply_to = next(it)
            except StopIteration:
                print("[ERROR] --reply-to requires a task ID", file=sys.stderr)
                return EXIT_ERROR
            continue
        if token == "--live-id":
            if peer_live_id_seen:
                print("[ERROR] --live-id may only be given once", file=sys.stderr)
                return EXIT_ERROR
            try:
                peer_live_id = next(it)
            except StopIteration:
                print("[ERROR] --live-id requires a live session ID", file=sys.stderr)
                return EXIT_ERROR
            if peer_live_id.startswith("--") or peer_live_id in ("-h", "-t"):
                print("[ERROR] --live-id requires a live session ID", file=sys.stderr)
                return EXIT_ERROR
            peer_live_id = peer_live_id.strip()
            peer_live_id_seen = True
            continue
        if token == "--to-role":
            if peer_to_role_seen:
                print("[ERROR] --to-role may only be given once", file=sys.stderr)
                return EXIT_ERROR
            try:
                peer_to_role = next(it)
            except StopIteration:
                print("[ERROR] --to-role requires a role", file=sys.stderr)
                return EXIT_ERROR
            if not _normalized_role(peer_to_role):
                print(
                    f"[ERROR] --to-role must be one of: {', '.join(ROLE_NAMES)}",
                    file=sys.stderr,
                )
                return EXIT_ERROR
            peer_to_role = _normalized_role(peer_to_role)
            peer_to_role_seen = True
            continue
        if token == "--foreground":
            foreground_mode = True
            continue
        if token == "--wait":
            peer_intent = "wait"
            foreground_mode = False
            peer_wait_explicit = True
            continue
        if token == "--background":
            peer_intent = "background"
            foreground_mode = False
            continue
        if token == "--notify":
            peer_intent = "notify"
            foreground_mode = True
            continue
        parts.append(token)

    if not peer_target:
        print("[ERROR] --peer requires a target", file=sys.stderr)
        return EXIT_ERROR
    message = " ".join(parts).strip()
    if not message and not sys.stdin.isatty():
        message = read_stdin_text().strip()
    if not message:
        print("[ERROR] Message cannot be empty", file=sys.stderr)
        return EXIT_ERROR
    if not _valid_peer_correlation_id(peer_reply_to):
        print("[ERROR] Invalid --reply-to task ID", file=sys.stderr)
        return EXIT_ERROR
    live_id_error = _peer_live_id_error(peer_live_id, peer_live_id_seen, peer_target, peer_reply_to)
    if live_id_error:
        print(live_id_error, file=sys.stderr)
        return EXIT_ERROR
    if peer_intent == "notify" and _notify_requests_reply(message):
        print("[ERROR] --notify cannot end with a direct question; use --background or --wait", file=sys.stderr)
        return EXIT_ERROR
    return _run_peer_bridge(
        peer_target,
        peer_provider,
        timeout,
        message,
        foreground_mode,
        peer_intent,
        peer_reply_to,
        live_id=peer_live_id,
        to_role=peer_to_role,
        wait_explicit=peer_wait_explicit,
        foreground_explicit=peer_foreground_explicit,
    )


def main(argv: list[str]) -> int:
    if len(argv) <= 1:
        _usage()
        return EXIT_ERROR

    if argv[1] == "--peer":
        return _handle_peer_mode(argv[1:], "claude")

    # First argument must be the provider
    raw_provider = argv[1].lower()

    if raw_provider in ("-h", "--help"):
        _usage()
        return EXIT_OK

    if ":" in raw_provider:
        print(f"[ERROR] Provider instances are no longer supported: {raw_provider}", file=sys.stderr)
        return EXIT_ERROR

    if raw_provider not in PROVIDER_DAEMONS:
        print(f"[ERROR] Unknown provider: {raw_provider}", file=sys.stderr)
        print(f"[ERROR] Available: {', '.join(PROVIDER_DAEMONS.keys())}", file=sys.stderr)
        return EXIT_ERROR

    daemon_cmd = PROVIDER_DAEMONS[raw_provider]
    provider = raw_provider
    if provider in {"hermes", "pi"} and not _use_unified_daemon():
        print(f"[ERROR] {display_name(provider)} requires the unified askd daemon", file=sys.stderr)
        return EXIT_ERROR

    # Parse remaining arguments
    timeout: float = 3600.0
    timeout_explicit = False
    notify_mode = False
    no_wrap = False
    peer_target = ""
    foreground_mode = _default_foreground()
    peer_intent = "wait"
    peer_reply_to = ""
    peer_live_id = ""
    peer_live_id_seen = False
    peer_to_role = ""
    peer_to_role_seen = False
    resend_task_id = ""
    resend_seen = False
    peer_foreground_explicit = False
    peer_wait_explicit = False
    parts: list[str] = []

    it = iter(argv[2:])
    for token in it:
        if token in ("-h", "--help"):
            _usage()
            return EXIT_OK
        if token in ("-t", "--timeout"):
            try:
                timeout = float(next(it))
            except StopIteration:
                print("[ERROR] --timeout requires a number", file=sys.stderr)
                return EXIT_ERROR
            except ValueError:
                print("[ERROR] --timeout must be a number", file=sys.stderr)
                return EXIT_ERROR
            timeout_explicit = True
            continue
        if token == "--ccb-default-timeout":
            # Internal detached-launcher flag: the numeric timeout is still
            # carried for pre-anchor behavior, but came from the CLI default.
            timeout_explicit = False
            continue
        if token == "--reply-to":
            try:
                peer_reply_to = next(it)
            except StopIteration:
                print("[ERROR] --reply-to requires a task ID", file=sys.stderr)
                return EXIT_ERROR
            continue
        if token == "--live-id":
            if peer_live_id_seen:
                print("[ERROR] --live-id may only be given once", file=sys.stderr)
                return EXIT_ERROR
            try:
                peer_live_id = next(it)
            except StopIteration:
                print("[ERROR] --live-id requires a live session ID", file=sys.stderr)
                return EXIT_ERROR
            if peer_live_id.startswith("--") or peer_live_id in ("-h", "-t"):
                print("[ERROR] --live-id requires a live session ID", file=sys.stderr)
                return EXIT_ERROR
            peer_live_id = peer_live_id.strip()
            peer_live_id_seen = True
            continue
        if token == "--to-role":
            if peer_to_role_seen:
                print("[ERROR] --to-role may only be given once", file=sys.stderr)
                return EXIT_ERROR
            try:
                peer_to_role = next(it)
            except StopIteration:
                print("[ERROR] --to-role requires a role", file=sys.stderr)
                return EXIT_ERROR
            if not _normalized_role(peer_to_role):
                print(
                    f"[ERROR] --to-role must be one of: {', '.join(ROLE_NAMES)}",
                    file=sys.stderr,
                )
                return EXIT_ERROR
            peer_to_role = _normalized_role(peer_to_role)
            peer_to_role_seen = True
            continue
        if token == "--resend":
            if resend_seen:
                print("[ERROR] --resend may only be given once", file=sys.stderr)
                return EXIT_ERROR
            resend_seen = True
            try:
                resend_task_id = next(it)
            except StopIteration:
                print("[ERROR] --resend requires a task ID", file=sys.stderr)
                return EXIT_ERROR
            if resend_task_id.startswith("--"):
                print("[ERROR] --resend requires a task ID", file=sys.stderr)
                return EXIT_ERROR
            continue
        if token == "--notify":
            notify_mode = True
            peer_intent = "notify"
            continue
        if token == "--foreground":
            foreground_mode = True
            peer_foreground_explicit = True
            continue
        if token == "--wait":
            peer_intent = "wait"
            foreground_mode = False
            peer_wait_explicit = True
            continue
        if token == "--background":
            peer_intent = "background"
            foreground_mode = False
            continue
        if token == "--no-wrap":
            no_wrap = True
            continue
        if token == "--peer":
            try:
                peer_target = next(it)
            except StopIteration:
                print("[ERROR] --peer requires a target", file=sys.stderr)
                return EXIT_ERROR
            continue
        parts.append(token)

    if resend_seen:
        if not peer_live_id_seen:
            print("[ERROR] --resend requires --live-id", file=sys.stderr)
            return EXIT_ERROR
        if parts:
            print("[ERROR] --resend cannot be combined with a message", file=sys.stderr)
            return EXIT_ERROR
        message, resend_error = _read_resend_message(resend_task_id)
        if resend_error:
            print(resend_error, file=sys.stderr)
            return EXIT_ERROR
        assert message is not None
    else:
        message = " ".join(parts).strip()
        if not message and not sys.stdin.isatty():
            message = read_stdin_text().strip()
        if not message:
            print("[ERROR] Message cannot be empty", file=sys.stderr)
            return EXIT_ERROR
    if not _valid_peer_correlation_id(peer_reply_to):
        print("[ERROR] Invalid --reply-to task ID", file=sys.stderr)
        return EXIT_ERROR
    live_id_error = _peer_live_id_error(peer_live_id, peer_live_id_seen, peer_target, peer_reply_to)
    if live_id_error:
        print(live_id_error, file=sys.stderr)
        return EXIT_ERROR

    if resend_seen and (notify_mode or peer_foreground_explicit):
        print("[ERROR] --resend cannot be combined with --notify or --foreground", file=sys.stderr)
        return EXIT_ERROR
    if resend_seen:
        foreground_mode = False

    if peer_live_id and not peer_target and (
        not _use_unified_daemon() or (notify_mode and provider not in UNIFIED_NOTIFY_PROVIDERS)
    ):
        print("[ERROR] --live-id needs the unified askd daemon for this provider", file=sys.stderr)
        return EXIT_ERROR

    if _REMOVED_ROUTE_TAG_RE.match(message):
        print("[ERROR] [WORKER]/[ARCHITECT] routing tags are no longer supported", file=sys.stderr)
        return EXIT_ERROR

    # Phase 3 (A6.v/E4): a legacy (CCB_UNIFIED_ASKD=0) local delivery bypasses
    # the daemon gate entirely, so an enforcing launch refuses it here, and an
    # explicitly passed --to-role is still verified rather than ignored.
    if not peer_target and not _use_unified_daemon():
        legacy_refusal = _legacy_policy_refusal(
            provider,
            peer_target="",
            to_role=peer_to_role,
            kind="notify" if notify_mode else "request",
            delivery_only=bool(notify_mode),
        )
        if legacy_refusal:
            print(f"[ERROR] {legacy_refusal}", file=sys.stderr)
            return EXIT_ERROR

    if peer_target:
        if peer_intent == "notify":
            if not peer_foreground_explicit:
                foreground_mode = provider == "claude"
            if _notify_requests_reply(message):
                print("[ERROR] --notify cannot end with a direct question; use --background or --wait", file=sys.stderr)
                return EXIT_ERROR
        resend_options = {"preserve_task_id": resend_task_id} if resend_seen else {}
        return _run_peer_bridge(
            peer_target,
            provider,
            timeout,
            message,
            foreground_mode,
            peer_intent,
            peer_reply_to,
            live_id=peer_live_id,
            to_role=peer_to_role,
            wait_explicit=peer_wait_explicit,
            foreground_explicit=peer_foreground_explicit,
            resend_seen=bool(resend_options),
            **resend_options,
        )

    daemon_context: _UnifiedDaemonContext | None = None
    local_route: ResolvedRoute = ResolvedRoute()
    if not notify_mode:
        if _use_unified_daemon():
            daemon_context = _resolve_unified_daemon_context()
            if daemon_context is None:
                print("[ERROR] Unified askd daemon not running", file=sys.stderr)
                return EXIT_ERROR
        preflight_work_dir = daemon_context.work_dir if daemon_context is not None else Path.cwd()
        try:
            inherited_route = _inherited_route_from_env()
        except MalformedRouteError as exc:
            print(f"[ERROR] Malformed inherited route: {exc}", file=sys.stderr)
            return EXIT_ERROR
        if inherited_route is not None:
            # This is the detached `--foreground` re-invocation of an
            # earlier `ask` process's default async submission: that
            # process already resolved the route once. Carry it through
            # unchanged; never resolve again.
            local_route = inherited_route
        else:
            caller_pane_id, caller_terminal = _caller_pane_info()
            caller_live_id = (os.environ.get("CCB_LIVE_ID") or "").strip()
            caller_token = (os.environ.get("CCB_LIVE_TOKEN") or "").strip()
            caller_member_id, caller_member_token = _member_credential()
            caller_launch_id = (os.environ.get("CCB_SESSION_ID") or "").strip()
            if bool(caller_member_id) != bool(caller_member_token):
                print(
                    "[ERROR] CCB_MEMBER_ID and CCB_MEMBER_TOKEN must be supplied together; "
                    "refusing to route without a verified caller launch.",
                    file=sys.stderr,
                )
                return EXIT_ERROR
            if caller_live_id and caller_token:
                # Codex tool sandboxes may drop TMUX_PANE while retaining an
                # unrelated outer WEZTERM_PANE. The per-launch credential is
                # the authoritative pair identity; do not mix ambient pane
                # evidence from another terminal backend into it.
                caller_pane_id, caller_terminal = "", ""
            route_fields: dict = {}
            if not _preflight_target(
                provider,
                work_dir=preflight_work_dir,
                caller_pane_id=caller_pane_id,
                caller_terminal=caller_terminal,
                caller_live_id=caller_live_id,
                caller_token=caller_token,
                caller_member_id=caller_member_id,
                caller_member_token=caller_member_token,
                caller_launch_id=caller_launch_id,
                route_out=route_fields,
                **({"target_live_id": peer_live_id} if peer_live_id else {}),
            ):
                return EXIT_ERROR
            try:
                # Same parser as the ingestion boundaries: a resolution
                # that produced incomplete endpoint evidence must refuse
                # here too, never quietly carry a route nothing downstream
                # can actually use to detect a replacement.
                local_route = parse_route_mapping(route_fields)
            except MalformedRouteError as exc:
                print(f"[ERROR] Resolved route is incomplete: {exc}", file=sys.stderr)
                return EXIT_ERROR

    # Notify mode: sync send, no wait for reply (used for hook notifications)
    if notify_mode:
        caller = _require_caller()
        if _use_unified_daemon() and provider in UNIFIED_NOTIFY_PROVIDERS:
            daemon_context = _resolve_unified_daemon_context()
            if daemon_context is None:
                print("[ERROR] Unified askd daemon not running", file=sys.stderr)
                return EXIT_ERROR
            # An inventory-backed destination must not go out unrouted just
            # because this is a one-way notification: resolve (or inherit)
            # the route exactly as the reply-collecting path does.
            notify_route: ResolvedRoute = ResolvedRoute()
            try:
                inherited_notify_route = _inherited_route_from_env()
            except MalformedRouteError as exc:
                print(f"[ERROR] Malformed inherited route: {exc}", file=sys.stderr)
                return EXIT_ERROR
            if inherited_notify_route is not None:
                notify_route = inherited_notify_route
            else:
                notify_caller_pane_id, notify_caller_terminal = _caller_pane_info()
                notify_caller_live_id = (os.environ.get("CCB_LIVE_ID") or "").strip()
                notify_caller_token = (os.environ.get("CCB_LIVE_TOKEN") or "").strip()
                notify_member_id, notify_member_token = _member_credential()
                notify_launch_id = (os.environ.get("CCB_SESSION_ID") or "").strip()
                if bool(notify_member_id) != bool(notify_member_token):
                    print(
                        "[ERROR] CCB_MEMBER_ID and CCB_MEMBER_TOKEN must be supplied together; "
                        "refusing to route without a verified caller launch.",
                        file=sys.stderr,
                    )
                    return EXIT_ERROR
                if notify_caller_live_id and notify_caller_token:
                    notify_caller_pane_id, notify_caller_terminal = "", ""
                notify_route_fields: dict = {}
                if not _preflight_target(
                    provider,
                    work_dir=daemon_context.work_dir,
                    caller_pane_id=notify_caller_pane_id,
                    caller_terminal=notify_caller_terminal,
                    caller_live_id=notify_caller_live_id,
                    caller_token=notify_caller_token,
                    caller_member_id=notify_member_id,
                    caller_member_token=notify_member_token,
                    caller_launch_id=notify_launch_id,
                    route_out=notify_route_fields,
                    **({"target_live_id": peer_live_id} if peer_live_id else {}),
                ):
                    return EXIT_ERROR
                try:
                    notify_route = parse_route_mapping(notify_route_fields)
                except MalformedRouteError as exc:
                    print(f"[ERROR] Resolved route is incomplete: {exc}", file=sys.stderr)
                    return EXIT_ERROR
            return _send_via_unified_daemon(
                provider,
                message,
                timeout,
                no_wrap,
                caller,
                delivery_only=True,
                suppress_completion_hook=True,
                daemon_context=daemon_context,
                route=notify_route,
                timeout_explicit=timeout_explicit,
                kind="notify",
                to_role=peer_to_role,
            )
        if _use_unified_daemon():
            print("[WARN] Unified notify is unavailable for this provider; using legacy", file=sys.stderr)

        # G2: this branch reaches a pane without the host gate. An enforcing
        # destination refuses here rather than being delivered ungated.
        legacy_refusal = _legacy_policy_refusal(
            provider,
            peer_target="",
            to_role=peer_to_role,
            kind="notify",
            delivery_only=True,
            work_dir=str(daemon_context.work_dir) if daemon_context is not None else "",
        )
        if legacy_refusal:
            print(f"[ERROR] {legacy_refusal}", file=sys.stderr)
            return EXIT_ERROR

        # Legacy daemon path for notify mode
        cmd = [daemon_cmd, "--sync"]
        if no_wrap:
            cmd.append("--no-wrap")
        try:
            result = subprocess.run(
                cmd,
                input=message,
                capture_output=True,
                text=True,
                timeout=10
            )
            return result.returncode
        except subprocess.TimeoutExpired:
            return EXIT_OK
        except Exception as e:
            print(f"[ERROR] {e}", file=sys.stderr)
            return EXIT_ERROR

    # Foreground mode: run provider directly via unified daemon
    if foreground_mode:
        if _use_unified_daemon():
            caller = _require_caller()
            return _send_via_unified_daemon(
                provider,
                message,
                timeout,
                no_wrap,
                caller,
                daemon_context=daemon_context,
                route=local_route,
                timeout_explicit=timeout_explicit,
                kind="request",
                to_role=peer_to_role,
            )
        else:
            # G2: same gate for the per-provider legacy foreground path.
            legacy_refusal = _legacy_policy_refusal(
                provider,
                peer_target="",
                to_role=peer_to_role,
                kind="request",
                delivery_only=False,
            )
            if legacy_refusal:
                print(f"[ERROR] {legacy_refusal}", file=sys.stderr)
                return EXIT_ERROR
            cmd = [daemon_cmd, "--sync", "--timeout", str(timeout)]
            if no_wrap and provider == "claude":
                cmd.append("--no-wrap")
            env = os.environ.copy()
            env["CCB_CALLER"] = _require_caller()
            try:
                result = subprocess.run(cmd, input=message, text=True, env=env)
                return result.returncode
            except Exception as e:
                print(f"[ERROR] {e}", file=sys.stderr)
                return EXIT_ERROR

    # Default async mode: background task
    task_id = make_task_id()
    if resend_seen and task_id == resend_task_id:
        print("[ERROR] Could not create a fresh task ID for --resend", file=sys.stderr)
        return EXIT_ERROR
    log_dir = Path(tempfile.gettempdir()) / "ccb-tasks"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_file = log_dir / f"ask-{provider}-{task_id}.log"
    status_file = log_dir / f"ask-{provider}-{task_id}.status"
    try:
        log_file.touch(exist_ok=True)
    except Exception:
        pass
    try:
        status_file.touch(exist_ok=True)
    except Exception:
        pass
    if resend_seen:
        _cleanup_task_logs(log_dir, preserve_task_id=resend_task_id)
    else:
        _cleanup_task_logs(log_dir)

    # Detect caller from environment or default to "claude"
    caller = _require_caller()
    receipt_file = receipt_path(provider, task_id, root=log_dir)
    try:
        write_receipt(
            receipt_file,
            new_receipt(
                task_id=task_id,
                provider=provider,
                caller=caller,
                work_dir=Path.cwd(),
                status_file=status_file,
                log_file=log_file,
                timeout_seconds=timeout,
                route=local_route,
            ),
        )
    except Exception as exc:
        print(f"[ERROR] Failed to create task receipt: {exc}", file=sys.stderr)
        return EXIT_ERROR
    _append_task_status_line(
        status_file,
        f"submitted task={task_id} provider={provider} caller={caller} work_dir={os.getcwd()}",
    )

    queue_notice = _queued_notice(
        provider,
        local_route,
        daemon_context.work_dir if daemon_context is not None else Path.cwd(),
    )

    # A managed Codex tool shell may terminate detached child processes as
    # soon as the tool call returns. Hand explicit background work to the
    # already-running host daemon instead, which owns the worker lifetime.
    if inside_managed_codex_sandbox() and _use_unified_daemon():
        rc = _send_via_unified_daemon(
            provider,
            message,
            timeout,
            no_wrap,
            caller,
            daemon_context=daemon_context,
            route=local_route,
            async_submit=True,
            request_id=task_id,
            timeout_explicit=timeout_explicit,
            kind="request",
            to_role=peer_to_role,
            preflight_done=True,
        )
        if rc != EXIT_OK:
            _append_task_status_line(status_file, f"failed exit_code={rc}")
            return rc
        _append_task_status_line(status_file, "queued by host daemon (not yet delivered)")
        if queue_notice:
            print(queue_notice)
        if peer_intent == "background":
            print(f"[CCB_BACKGROUND_SUBMITTED provider={provider} intent=background]")
        else:
            print(f"[CCB_ASYNC_SUBMITTED provider={provider}]")
        print(f"{display_name(provider)} processing (task: {task_id})")
        print(f"[CCB_ASYNC_STATUS_FILE task={task_id}] {status_file}")
        print(f"[CCB_ASYNC_LOG_FILE task={task_id}] {log_file}")
        print(f"[CCB_ASYNC_RECEIPT_FILE task={task_id}] {receipt_file}")
        if peer_intent == "background":
            print(f"Retain task ID {task_id}; use 'pend {task_id}' when you need the result.")
        return EXIT_OK

    # Phase 3 (A6.iii/E4): the detached async path announces a submission, so
    # ask the host for the policy decision first and report a refusal instead.
    allowed, refusal = _preflight_delivery(
        provider,
        daemon_context=daemon_context,
        work_dir=daemon_context.work_dir if daemon_context is not None else Path.cwd(),
        route=local_route,
        to_role=peer_to_role,
        kind="request",
    )
    if not allowed:
        _append_task_status_line(status_file, f"refused {refusal}")
        print(f"[ERROR] {refusal}", file=sys.stderr)
        return EXIT_ERROR

    # Get the path to this script for recursive call with --foreground
    ask_cmd = str(Path(__file__).resolve())
    child_role_arg = f" --to-role {shlex.quote(peer_to_role)}" if peer_to_role else ""
    _child_role_arg_ps1 = f" --to-role {_ps1_literal(peer_to_role)}" if peer_to_role else ""
    bg_pid: int | None = None

    # Platform-specific background execution
    # Use a message file on every platform. Embedding arbitrary prompt text in a
    # generated shell heredoc lets a line matching the delimiter alter the script.
    msg_file = log_dir / f"ask-{provider}-{task_id}.msg"
    if resend_seen:
        with msg_file.open("w", encoding="utf-8", newline="") as msg_handle:
            msg_handle.write(message)
    else:
        msg_file.write_text(message, encoding="utf-8")

    if os.name == "nt":
        # Windows: use PowerShell script
        DETACHED_PROCESS = 0x00000008
        CREATE_NO_WINDOW = 0x08000000
        CREATE_NEW_PROCESS_GROUP = 0x00000200

        # Write PowerShell script - call ask --foreground to use unified daemon
        script_file = log_dir / f"ask-{provider}-{task_id}.ps1"
        status_file_win = str(status_file).replace('"', '`"')
        log_file_win = str(log_file).replace('"', '`"')

        # Pass CCB_RUN_DIR so background script can find askd state file
        ccb_run_dir = os.environ.get("CCB_RUN_DIR", "")
        run_dir_line = f'$env:CCB_RUN_DIR = "{ccb_run_dir}"\n' if ccb_run_dir else ""

        # Collect CCB_EMAIL_* env vars for email caller
        email_env_lines = ""
        if caller == "email":
            for key in ("CCB_EMAIL_REQ_ID", "CCB_EMAIL_MSG_ID", "CCB_EMAIL_FROM"):
                val = os.environ.get(key, "")
                if val:
                    email_env_lines += f'$env:{key} = "{val}"\n'

        win_caller_pane_id, win_caller_terminal = _caller_pane_info()
        win_pane_env_lines = ""
        if win_caller_pane_id:
            win_pane_env_lines += f'$env:CCB_CALLER_PANE_ID = "{win_caller_pane_id}"\n'
        if win_caller_terminal:
            win_pane_env_lines += f'$env:CCB_CALLER_TERMINAL = "{win_caller_terminal}"\n'
        # Carry the route this process already resolved into the detached
        # `--foreground` re-invocation, so it never resolves a second time.
        win_pane_env_lines += _route_env_export_lines(local_route, style="ps1", task_id=task_id)

        script_content = f'''$ErrorActionPreference = "SilentlyContinue"
$OutputEncoding = [System.Text.Encoding]::UTF8
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
[Console]::InputEncoding = [System.Text.Encoding]::UTF8
$env:PYTHONIOENCODING = "utf-8"
$env:CCB_REQ_ID = "{task_id}"
$env:CCB_CALLER = "{caller}"
$env:CCB_WORK_DIR = "{os.getcwd()}"
{run_dir_line}{email_env_lines}{win_pane_env_lines}$statusFile = "{status_file_win}"
$logFile = "{log_file_win}"
function Write-CcbStatus([string]$line) {{
  Add-Content -Path $statusFile -Value ("{{0}} {{1}}" -f (Get-Date -Format "yyyy-MM-ddTHH:mm:sszzz"), $line) -Encoding UTF8
}}
Write-CcbStatus "running pid=$PID"
Get-Content -Path "{msg_file}" -Encoding UTF8 | python "{ask_cmd}" {provider} --foreground --timeout {timeout}{' --ccb-default-timeout' if not timeout_explicit else ''}{_child_role_arg_ps1}
$rc = $LASTEXITCODE
Write-CcbStatus "finished exit_code=$rc"
if ($rc -ne 0) {{
  Write-CcbStatus "failed exit_code=$rc"
}}
exit $rc
'''
        script_file.write_text(script_content, encoding="utf-8")

        with log_file.open("a", encoding="utf-8") as log_handle:
            proc = subprocess.Popen(
                ["powershell", "-ExecutionPolicy", "Bypass", "-NoProfile", "-File", str(script_file)],
                stdin=subprocess.DEVNULL,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                creationflags=DETACHED_PROCESS | CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP,
            )
        bg_pid = proc.pid
    else:
        # Unix: run detached shell script, call ask --foreground to use unified daemon
        # Collect CCB_EMAIL_* env vars for email caller
        email_env_lines = ""
        if caller == "email":
            for key in ("CCB_EMAIL_REQ_ID", "CCB_EMAIL_MSG_ID", "CCB_EMAIL_FROM"):
                val = os.environ.get(key, "")
                if val:
                    email_env_lines += f'export {key}="{val}"\n'

        # Pass CCB_RUN_DIR so background script can find askd state file
        ccb_run_dir = os.environ.get("CCB_RUN_DIR", "")
        run_dir_line = f'export CCB_RUN_DIR="{ccb_run_dir}"\n' if ccb_run_dir else ""

        bg_pane_id, bg_terminal = _caller_pane_info()
        pane_env_lines = ""
        if bg_pane_id:
            pane_env_lines += f'export CCB_CALLER_PANE_ID="{bg_pane_id}"\n'
        if bg_terminal:
            pane_env_lines += f'export CCB_CALLER_TERMINAL="{bg_terminal}"\n'
        # Carry the route this process already resolved into the detached
        # `--foreground` re-invocation, so it never resolves a second time.
        pane_env_lines += _route_env_export_lines(local_route, style="sh", task_id=task_id)

        quoted_status = shlex.quote(str(status_file))
        quoted_ask_cmd = shlex.quote(ask_cmd)
        quoted_provider = shlex.quote(provider)
        quoted_message = shlex.quote(str(msg_file))
        bg_script = f'''#!/bin/sh
set +e
_now() {{
  date '+%Y-%m-%dT%H:%M:%S%z'
}}
echo "$(_now) running pid=$$" >> {quoted_status}
echo "[CCB_TASK_START] task={task_id} provider={provider} caller={caller} pid=$$"
export CCB_REQ_ID="{task_id}"
export CCB_CALLER="{caller}"
export CCB_WORK_DIR="{os.getcwd()}"
{run_dir_line}{email_env_lines}{pane_env_lines}python3 {quoted_ask_cmd} {quoted_provider} --foreground --timeout {timeout}{' --ccb-default-timeout' if not timeout_explicit else ''}{child_role_arg} < {quoted_message}
rc=$?
echo "[CCB_TASK_END] task={task_id} provider={provider} exit_code=$rc"
echo "$(_now) finished exit_code=$rc" >> {quoted_status}
if [ "$rc" -ne 0 ]; then
  echo "$(_now) failed exit_code=$rc" >> {quoted_status}
fi
exit "$rc"
'''
        # Write script to temp file for detached execution
        script_file = log_dir / f"ask-{provider}-{task_id}.sh"
        script_file.write_text(bg_script, encoding="utf-8")
        script_file.chmod(0o755)

        # Run detached in its own session and stream stdout/stderr to task log.
        with log_file.open("a", encoding="utf-8") as log_handle:
            proc = subprocess.Popen(
                ["sh", str(script_file)],
                stdin=subprocess.DEVNULL,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
        bg_pid = proc.pid

    if bg_pid is not None:
        _append_task_status_line(status_file, f"spawned pid={bg_pid}")
    else:
        _append_task_status_line(status_file, "spawned pid=unknown")

    if peer_intent == "background":
        if queue_notice:
            print(queue_notice)
        print(f"[CCB_BACKGROUND_SUBMITTED provider={provider} intent=background]")
    else:
        if queue_notice:
            print(queue_notice)
        print(f"[CCB_ASYNC_SUBMITTED provider={provider}]")
    print(f"{display_name(provider)} processing (task: {task_id})")
    if bg_pid is not None:
        print(f"[CCB_ASYNC_PID task={task_id} pid={bg_pid}]")
    print(f"[CCB_ASYNC_STATUS_FILE task={task_id}] {status_file}")
    print(f"[CCB_ASYNC_LOG_FILE task={task_id}] {log_file}")
    print(f"[CCB_ASYNC_RECEIPT_FILE task={task_id}] {receipt_file}")
    if peer_intent == "background":
        print(f"Retain task ID {task_id}; use 'pend {task_id}' when you need the result.")
    elif _should_emit_async_guardrail(caller):
        print(
            f"MANDATORY: END YOUR TURN NOW. Reply ONLY '{display_name(provider)} processing...', then stop. See 'Async Guardrail' in CLAUDE.md."
        )
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv))

PEER_CORRELATION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
# Pi joins the LOCAL peer transport only (see docs/plans/pi-peer-remote-plan.md, phase 1).
PEER_PROVIDERS = ("claude", "codex", "pi")


def _write_background_status(line: str) -> None:
    raw = (os.environ.get("CCB_PEER_STATUS_FILE") or "").strip()
    if not raw:
        return
    try:
        timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
        with Path(raw).open("a", encoding="utf-8") as handle:
            handle.write(f"{timestamp} {line}\n")
    except Exception:
        pass


def _notify_background_failure(exit_code: int) -> None:
    if not (os.environ.get("CCB_PEER_STATUS_FILE") or "").strip():
        return
    task_id = (os.environ.get("CCB_REQ_ID") or "").strip() or "unknown"
    provider = (os.environ.get("CCB_PEER_PROVIDER") or "claude").strip().lower()
    log_file = (os.environ.get("CCB_PEER_LOG_FILE") or "").strip()
    reply_to = (os.environ.get("CCB_PEER_REPLY_TO") or "").strip()
    if reply_to:
        recovery = f" The reply remains saved; run `pend {reply_to}` to recover it."
    else:
        recovery = f" Inspect the task log or run `pend {task_id}` for details."
    notify_completion(
        provider=f"peer-{provider}",
        output_file=log_file or None,
        reply=(
            f"Peer {provider.capitalize()} delivery failed "
            f"(exit code {exit_code}).{recovery}"
        ),
        req_id=task_id,
        done_seen=False,
        caller=(os.environ.get("CCB_CALLER") or "claude").strip().lower(),
        work_dir=(os.environ.get("CCB_WORK_DIR") or "").strip(),
        status=COMPLETION_STATUS_FAILED,
        caller_pane_id=(os.environ.get("CCB_CALLER_PANE_ID") or "").strip(),
        caller_terminal=(os.environ.get("CCB_CALLER_TERMINAL") or "").strip(),
    )


def _task_id() -> str:
    now = datetime.now()
    ms = now.microsecond // 1000
    return f"bridge-{now.strftime('%Y%m%d-%H%M%S')}-{ms:03d}-{os.getpid()}"


def _load_targets() -> list[dict[str, Any]]:
    list_cmd = script_dir / "ccb-list"
    result = subprocess.run(
        [sys.executable, str(list_cmd), "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "ccb-list failed")
    try:
        data = json.loads(result.stdout)
    except Exception as exc:
        raise RuntimeError(f"failed to parse ccb-list output: {exc}") from exc
    if not isinstance(data, list):
        raise RuntimeError("ccb-list returned invalid JSON")
    return [entry for entry in data if isinstance(entry, dict)]


def _same_path(left: str, right: str) -> bool:
    if left == right:
        return True
    try:
        return Path(left).expanduser().resolve() == Path(right).expanduser().resolve()
    except Exception:
        return False


def _resolve_target(entries: list[dict[str, Any]], target: str) -> dict[str, Any]:
    raw = (target or "").strip()
    if not raw:
        raise ValueError("target cannot be empty")

    matches: list[dict[str, Any]] = []

    index_raw = raw[1:-1] if raw.startswith("[") and raw.endswith("]") else raw
    if index_raw.isdigit():
        wanted = int(index_raw)
        matches = [entry for entry in entries if int(entry.get("index") or 0) == wanted]
        if matches:
            return matches[0]

    path_matches = [entry for entry in entries if _same_path(str(entry.get("work_dir") or ""), raw)]
    if path_matches:
        if len(path_matches) > 1:
            raise ValueError(f"target path is ambiguous: {raw}")
        return path_matches[0]

    if len(raw) >= 4 and all(ch in "0123456789abcdefABCDEF" for ch in raw):
        lowered = raw.lower()
        matches = [
            entry
            for entry in entries
            if str(entry.get("ccb_project_id") or "").lower().startswith(lowered)
        ]
        if len(matches) == 1:
            return matches[0]
        if len(matches) > 1:
            raise ValueError(f"target hash prefix is ambiguous: {raw}")

    raise ValueError(f"no active CCB project matches target: {raw}")


def _select_live_session_target(
    target: dict[str, Any], provider: str, live_id: str
) -> dict[str, Any]:
    """Narrow a resolved peer project to the ONE live session the sender
    named by `--live-id`, or refuse.

    The aggregate `target["providers"][provider]` view deliberately reports
    nothing usable when a project has several live sessions of a provider.
    An explicit selector resolves that from the project's own authoritative
    `sessions` list instead -- it NEVER falls back to the aggregate, and it
    never picks among candidates: anything other than exactly one live,
    mounted, fully-identified session of the requested provider fails
    closed here, before the transport lock and before any send.
    """
    sessions = target.get("sessions")
    if not isinstance(sessions, list) or not sessions:
        raise RuntimeError(
            f"target project publishes no live session inventory; cannot honor --live-id {live_id}"
        )

    wanted = live_id.strip()
    requested_matches: list[tuple[dict[str, Any], dict[str, Any]]] = []
    wrong_provider = False
    rejected: list[str] = []
    invalid_inventory = False

    def _text(mapping: dict[str, Any], field: str, label: str) -> str:
        if field not in mapping:
            return ""
        value = mapping[field]
        if not isinstance(value, str):
            raise RuntimeError(
                f"target project session inventory has a non-string {label}; refusing --live-id"
            )
        return value.strip()

    # Validate the JSON boundary before eligibility filtering. In particular,
    # a stale or unmounted duplicate still counts as an identity occurrence;
    # truthiness and str() coercion must never make malformed inventory usable.
    for field in ("pane_id", "terminal", "work_dir", "ccb_project_id", "pane_title_marker"):
        _text(target, field, f"target {field}")

    for session in sessions:
        if not isinstance(session, dict):
            raise RuntimeError("target project session inventory is malformed; refusing --live-id")
        if not isinstance(session.get("alive"), bool):
            raise RuntimeError("target project session inventory has non-boolean session.alive; refusing --live-id")
        for field in ("pane_id", "terminal", "work_dir", "ccb_project_id", "pane_title_marker"):
            _text(session, field, f"session {field}")
        providers = session.get("providers")
        if not isinstance(providers, dict):
            raise RuntimeError("target project session inventory is malformed; refusing --live-id")
        for candidate_provider, status in providers.items():
            if not isinstance(candidate_provider, str) or not isinstance(status, dict):
                raise RuntimeError("target project session inventory is malformed; refusing --live-id")
            if not isinstance(status.get("alive"), bool) or not isinstance(status.get("mounted"), bool):
                raise RuntimeError(
                    "target project session inventory has non-boolean provider state; refusing --live-id"
                )
            status_live_id = _text(status, "live_id", "provider live_id")
            for field in ("pane_id", "terminal", "work_dir", "ccb_project_id", "pane_title_marker"):
                _text(status, field, f"provider {field}")
            if candidate_provider == provider and status.get("reason") == "invalid_inventory":
                invalid_inventory = True
            if status_live_id != wanted:
                continue
            if candidate_provider != provider:
                wrong_provider = True
            else:
                # Cardinality is deliberately collected before this
                # candidate's alive/mounted state is examined.
                requested_matches.append((session, status))

    if invalid_inventory:
        raise RuntimeError(
            f"target project has an invalid live-session inventory for {provider}; refusing --live-id {wanted}"
        )
    if len(requested_matches) > 1:
        raise RuntimeError(
            f"--live-id {wanted} matches more than one live {provider} session; refusing to guess"
        )
    if wrong_provider:
        raise RuntimeError(
            f"--live-id {wanted} belongs to a different provider in the target project"
        )
    if not requested_matches:
        raise RuntimeError(
            f"--live-id {wanted} matches no live {provider} session in the target project"
        )

    session, status = requested_matches[0]
    if not session["alive"]:
        rejected.append("its CCB session is no longer live")
    elif not status["alive"]:
        rejected.append("that pane is no longer alive")
    elif not status["mounted"]:
        reason = status.get("reason")
        rejected.append(reason if isinstance(reason, str) and reason else "it is not mounted")
    if rejected:
        raise RuntimeError(
            f"--live-id {wanted} is not a usable {provider} session: {rejected[0]}"
        )

    sources = (("target", target), ("session", session), ("provider", status))
    endpoint: dict[str, str] = {}
    for field in ("pane_id", "terminal", "work_dir", "ccb_project_id", "pane_title_marker"):
        values = [(name, _text(mapping, field, f"{name} {field}")) for name, mapping in sources]
        present = [(name, value) for name, value in values if value]
        if not present:
            endpoint[field] = ""
            continue
        first = present[0][1]
        for name, value in present[1:]:
            agrees = _same_path(first, value) if field == "work_dir" else (
                first.lower() == value.lower() if field == "terminal" else first == value
            )
            if not agrees:
                raise RuntimeError(
                    f"--live-id {wanted} has conflicting {field} identity between {present[0][0]} and {name}; refusing to deliver"
                )
        endpoint[field] = first.lower() if field == "terminal" else first

    pane_id = endpoint["pane_id"]
    terminal = endpoint["terminal"]
    work_dir = endpoint["work_dir"]
    project_id = endpoint["ccb_project_id"]
    marker = endpoint["pane_title_marker"]
    # The same identity `peer_routing.revalidate_peer_destination` demands
    # at askd's enqueue and send checkpoints. Missing it there would surface
    # as a late delivery failure; refuse here instead, before the lock.
    if not pane_id or not terminal or not work_dir or not project_id:
        raise RuntimeError(
            f"--live-id {wanted} has incomplete endpoint identity; refusing to deliver"
        )
    if terminal not in {"tmux", "wezterm"}:
        raise RuntimeError(
            f"--live-id {wanted} has unsupported terminal endpoint; refusing to deliver"
        )
    if terminal != "wezterm" and not marker:
        raise RuntimeError(
            f"--live-id {wanted} has no CCB pane marker; refusing to deliver"
        )

    selected = dict(target)
    selected["work_dir"] = work_dir
    selected["ccb_project_id"] = project_id
    # Narrow a COPY: the aggregate providers map is shared with the rest of
    # the ccb-list entry and must not be mutated by this selection.
    selected["providers"] = {provider: dict(status)}
    selected["peer_destination"] = {
        "pane_id": pane_id,
        "terminal": terminal,
        "work_dir": work_dir,
        "ccb_project_id": project_id,
        "pane_title_marker": marker,
    }
    # The launch this exact session was selected as, when the inventory names one. Only a Pi
    # destination uses it (and its incarnation witness); every other provider's endpoint fields
    # stay exactly as they always were.
    if provider == "pi":
        selected_launch = str(status.get("launch_id") or session.get("session_id") or "").strip()
        if selected_launch:
            selected["peer_destination"]["launch_id"] = selected_launch
        witness, reason = _pi_witness_for(
            work_dir,
            pane_id=pane_id,
            terminal=terminal,
            launch_id=selected_launch,
        )
        if reason:
            raise RuntimeError(
                f"the selected Pi session cannot be bound ({reason}); refusing to deliver"
            )
        selected["peer_destination"].update(witness)
    return selected


def _pi_probe_allowed() -> bool:
    """May this process read the destination pane itself? (G2)

    A managed Codex sandbox cannot: tmux and the terminal socket are outside it, so a liveness,
    marker or pid probe raises PermissionError instead of answering. Such a caller must NOT fail
    before dispatch -- it hands the host-discovered identity to askd, which validates the binding
    and captures the witness at admission, BEFORE queueing.
    """
    try:
        from ccb_runtime_status import inside_managed_codex_sandbox

        return not inside_managed_codex_sandbox()
    except Exception:
        # A caller that cannot even answer this is treated as unsandboxed: the probe below is
        # wrapped, and a failure is still deferred to admission.
        return True


def _pi_witness_for(
    work_dir: str, *, pane_id: str, terminal: str, launch_id: str = ""
) -> tuple[dict[str, str], str]:
    """The incarnation witness to record for a Pi destination, or why it cannot be bound.

    Returns `(witness, identity_error)`. The identity must be the destination project's own bound
    Pi; the process witness is what proves the incarnation later, under the lock.

    A caller that cannot read the pane (a managed Codex sandbox) defers BOTH to daemon admission:
    it returns no witness and no error, and askd validates the binding and captures the witness
    before queueing (G2). Nothing is pasted into a destination without a witness either way: the
    daemon refuses when it cannot capture one, and every send re-checks it under the lock.
    """
    from pi_comm import peer_pi_destination_binding, pi_destination_witness

    if not _pi_probe_allowed():
        return {}, ""
    try:
        binding, error = peer_pi_destination_binding(
            work_dir, pane_id=pane_id, terminal=terminal, launch_id=launch_id
        )
    except PermissionError:
        # The sandbox refused a terminal probe inside the binding check: defer to admission.
        return {}, ""
    if error or binding is None:
        return {}, f"the selected Pi session cannot be bound ({error or 'no Pi binding'})"
    try:
        witness, _capture_error = pi_destination_witness(
            binding, pane_id=pane_id, terminal=terminal
        )
    except PermissionError:
        return {}, ""
    return witness, ""


def _correlated_reply_receipt(reply_to: str, target: str, provider: str) -> dict[str, Any] | None:
    if not reply_to:
        return None
    found = find_receipt(reply_to)
    if not found:
        return None
    receipt = found[1]
    if not str(receipt.get("provider") or "").startswith("peer-"):
        return None
    if not bool(receipt.get("reply_expected")):
        raise ValueError(f"peer task does not expect a reply: {reply_to}")

    expected_provider = str(receipt.get("caller") or "").strip().lower()
    if expected_provider != provider:
        raise ValueError(
            f"reply provider mismatch for task {reply_to}: expected {expected_provider or 'unknown'}"
        )

    work_dir = str(receipt.get("work_dir") or "").strip()
    project_id = str(receipt.get("ccb_project_id") or "").strip().lower()
    raw_target = (target or "").strip()
    project_match = (
        len(raw_target) >= 4
        and all(ch in "0123456789abcdefABCDEF" for ch in raw_target)
        and project_id.startswith(raw_target.lower())
    )
    if not work_dir or not (_same_path(work_dir, raw_target) or project_match):
        raise ValueError(f"reply target mismatch for task {reply_to}")
    return receipt


def _validated_direct_reply_target(
    receipt: dict[str, Any], provider: str
) -> tuple[dict[str, Any], Any]:
    pane_id = str(receipt.get("caller_pane_id") or "").strip()
    terminal = str(receipt.get("caller_terminal") or "").strip().lower()
    work_dir = str(receipt.get("work_dir") or "").strip()
    project_id = str(receipt.get("ccb_project_id") or "").strip()
    if not pane_id or terminal not in {"tmux", "wezterm"} or not work_dir or not project_id:
        raise RuntimeError("peer reply receipt has no complete direct return address")
    if provider == "pi":
        # A Pi reply is addressed to a PROCESS, not just a pane id: a pane can be respawned in
        # place, so the witness captured at submission (tmux pane pid, or the Pi process on
        # WezTerm) is the only proof that this is still the Pi that asked. A receipt without it
        # cannot be delivered safely, and re-reading it here would adopt a replacement.
        if not str(receipt.get("caller_pane_pid") or "").strip():
            raise RuntimeError(
                "peer reply receipt has no Pi process witness; refusing to deliver to a pane "
                "that may have been replaced"
            )

    backend = get_backend_for_session({"terminal": terminal})
    if backend is None:
        raise RuntimeError(f"terminal backend is unavailable: {terminal}")
    try:
        pane_alive = bool(backend.is_alive(pane_id))
    except Exception:
        pane_alive = False
    if not pane_alive:
        raise RuntimeError(f"original {provider.capitalize()} pane is no longer alive")

    cwd_check = getattr(backend, "pane_matches_cwd_strict", None)
    if not callable(cwd_check) or not bool(cwd_check(pane_id, work_dir)):
        raise RuntimeError("original peer pane no longer matches the receipt project")

    if terminal != "wezterm":
        marker = str(receipt.get("caller_pane_title_marker") or "").strip()
        if not marker:
            raise RuntimeError("peer reply receipt has no CCB pane marker")
        resolver = getattr(backend, "find_pane_by_title_marker", None)
        if not callable(resolver) or str(resolver(marker, work_dir) or "").strip() != pane_id:
            raise RuntimeError("original peer pane no longer matches its CCB marker")

    target = {
        "work_dir": work_dir,
        "ccb_project_id": project_id,
        "providers": {provider: {"alive": True, "mounted": True, "pane_id": pane_id}},
    }
    return target, backend


ROLE_NAMES = ("lead", "implementer", "ratifier")


def _sender_credential() -> tuple[str, str]:
    member_id = (os.environ.get("CCB_MEMBER_ID") or "").strip()
    member_token = (os.environ.get("CCB_MEMBER_TOKEN") or "").strip()
    if not member_id or not member_token:
        member_id = member_id or (os.environ.get("CCB_LIVE_ID") or "").strip()
        member_token = member_token or (os.environ.get("CCB_LIVE_TOKEN") or "").strip()
    return member_id, member_token


def _direct_reply_policy_refusal(
    *,
    provider: str,
    pane_id: str,
    work_dir: str,
    ccb_project_id: str,
    reply_receipt: dict[str, Any] | None,
    to_role: str,
) -> str:
    """Phase 3 (A6.iv/E2): the direct reply path bypasses the daemon.

    It may only deliver when the destination launch's policy allows it, and
    under enforce only a verified correlated reply to the original requester
    is allowed. Correlation is re-verified here from the receipt, never from
    a client flag.
    """
    from delivery_policy import (
        MODE_UNMANAGED,
        destination_from_pane,
        evaluate,
        identify_sender,
        verify_reply_correlation,
    )

    destination = destination_from_pane(
        provider, pane_id, ccb_project_id=ccb_project_id, work_dir=work_dir
    )
    if destination.mode == MODE_UNMANAGED:
        return ""
    member_id, member_token = _sender_credential()
    sender = identify_sender(destination, member_id, member_token)
    kind = "reply" if reply_receipt is not None else "request"
    reply_to = str((reply_receipt or {}).get("task_id") or "").strip()
    if kind == "reply":
        problem = verify_reply_correlation(destination, reply_to=reply_to, provider=provider)
        if problem:
            return f"role policy refused: {problem}"
    decision = evaluate(
        destination=destination,
        sender=sender,
        kind=kind,
        to_role=to_role,
        delivery_only=True,
        has_peer=True,
        reply_to=reply_to,
        expected_pane=pane_id,
    )
    return "" if decision.allowed else decision.reason


def _send_to_direct_reply_target(
    target: dict[str, Any],
    backend: Any,
    message: str,
    sender_work_dir: str,
    intent: str,
    peer_task_id: str,
    reply_to: str,
    provider: str,
    caller: str,
) -> tuple[int, str, dict[str, Any]]:
    req_id = peer_task_id or _task_id()
    message_for_target = _append_peer_context(
        message,
        sender_work_dir,
        intent,
        peer_task_id,
        reply_to,
        provider=provider,
        caller=caller,
    )
    if provider == "codex":
        prompt = wrap_codex_delivery_prompt(message_for_target, req_id)
    else:
        prompt = wrap_claude_delivery_prompt(message_for_target, req_id)
    pane_id = str(((target.get("providers") or {}).get(provider) or {}).get("pane_id") or "")
    backend.send_text(pane_id, prompt)
    return (
        0,
        "Peer reply delivered directly.",
        {
            "status": "completed",
            "req_id": req_id,
            "direct_reply_fallback": True,
            "confirmation": "sent",
        },
    )


def _deliver_pi_direct_reply(
    target: dict[str, Any],
    backend: Any,
    receipt: dict[str, Any] | None,
    *,
    message: str,
    sender_work_dir: str,
    intent: str,
    peer_task_id: str,
    reply_to: str,
    timeout: float,
    caller: str,
    to_role: str = "",
    deadline: float | None = None,
) -> tuple[int, str, dict[str, Any]]:
    """Paste a correlated peer reply into a Pi caller's pane: gate, lock, confirm, send.

    This path reaches a pane without the daemon, so it owns everything the daemon would otherwise
    do, in the same order: wait until Pi is injectable OUTSIDE the pane lock, take the lock, confirm
    readiness AGAIN, revalidate the destination, apply the role policy, then paste. A pane that is
    busy, holds a draft, shows a prompt, mismatches its binding, or is a different process than the
    one that sent the request refuses with nothing sent.
    """
    from ccb_protocol import wrap_pi_delivery_prompt
    from pane_lock import PaneLockError, default_timeout_s, pane_injection_lock
    from pi_comm import (
        BUSY_LOG_INTERVAL_S,
        PI_PEER_DELIVERY_MAX_S,
        PRE_SEND_RETRY_LIMIT,
        PRE_SEND_RETRY_WAIT_S,
        PiGatePolicy,
        confirm_pi_ready,
        peer_pi_destination_binding,
        pi_incarnation_problem,
        wait_until_pi_injectable,
    )

    receipt_data = receipt if isinstance(receipt, dict) else {}
    pane_id = str(receipt_data.get("caller_pane_id") or "").strip()
    terminal = str(receipt_data.get("caller_terminal") or "").strip().lower()
    work_dir = str(receipt_data.get("work_dir") or "").strip()
    recorded_pid = str(receipt_data.get("caller_pane_pid") or "").strip()
    recorded_token = str(receipt_data.get("caller_pi_launch_token") or "").strip()
    launch_id = str(receipt_data.get("caller_registry_session_id") or "").strip()
    if not pane_id or not terminal or not work_dir:
        raise RuntimeError("peer reply receipt has no complete Pi return address")

    def incarnation(binding_data: dict[str, Any], *, require_ready: bool = False) -> str:
        return pi_incarnation_problem(
            backend,
            binding_data,
            pane_id=pane_id,
            terminal=terminal,
            recorded_pane_pid=recorded_pid,
            recorded_launch_token=recorded_token,
            require_ready=require_ready,
        )

    binding, error = peer_pi_destination_binding(
        work_dir, pane_id=pane_id, terminal=terminal, launch_id=launch_id
    )
    if error or binding is None:
        raise RuntimeError(f"Pi peer reply destination is unusable ({error or 'no Pi binding'})")
    problem = incarnation(binding)
    if problem:
        raise RuntimeError(f"Pi peer reply destination is not the pane that asked ({problem})")

    req_id = peer_task_id or _task_id()
    # H2: the envelope's CCB_REPLY_PROVIDER is the PARSED caller (--caller, defaulting to this
    # process's own), never a re-read of the environment -- the daemon path and the Claude/Codex
    # direct path both take it from the caller they were given.
    message_for_target = _append_peer_context(
        message, sender_work_dir, intent, peer_task_id, reply_to, provider="pi", caller=caller,
    )
    prompt = wrap_pi_delivery_prompt(message_for_target, req_id)
    budget_s = float(timeout)
    if not math.isfinite(budget_s):
        # F3: a NaN/inf budget can never expire, and an explicit 0 expires at once -- both are
        # refused BEFORE the lock, with zero sends.
        raise RuntimeError("Pi peer reply delivery has a non-finite timeout; nothing was sent")
    if budget_s < 0:
        budget_s = PI_PEER_DELIVERY_MAX_S
    own_deadline = time.monotonic() + budget_s
    # A1: the bridge's absolute paste-start deadline, fixed at bridge start, is the LAST instant a
    # paste may start. `timeout` is only what remains of it, so neither can be extended here.
    deadline = own_deadline if deadline is None else min(deadline, own_deadline)
    if deadline <= time.monotonic():
        raise RuntimeError("Pi peer reply delivery has no time budget; nothing was sent")

    while True:
        verdict = wait_until_pi_injectable(
            lambda: binding,
            deadline,
            policy=PiGatePolicy(
                retry_wait_s=PRE_SEND_RETRY_WAIT_S,
                retry_limit=PRE_SEND_RETRY_LIMIT,
                busy_log_interval_s=BUSY_LOG_INTERVAL_S,
            ),
            label="provider=pi peer",
            req_id=req_id,
        )
        if verdict.outcome == "cancelled":
            raise RuntimeError("Pi peer reply delivery was cancelled; nothing was sent")
        if verdict.outcome == "expired":
            raise RuntimeError("Pi peer reply delivery timed out before Pi was ready; nothing was sent")
        if not verdict.ready:
            state = verdict.state
            raise RuntimeError(
                f"Pi pane is {state.status}: {state.reason}; refusing to deliver the reply"
            )
        remaining_s = deadline - time.monotonic()
        if remaining_s <= 0:
            # F3: an exhausted budget refuses before the lock is even attempted.
            raise RuntimeError("Pi peer reply delivery timed out before Pi was ready; nothing was sent")
        lock_budget_s = min(default_timeout_s(), remaining_s)
        try:
            with pane_injection_lock(backend, pane_id, lock_budget_s):
                # G1: the ORDER inside the lock is the safety property, not any single check.
                # 1. Revalidate the endpoint (pane alive, cwd, marker) and apply this path's own
                #    role policy. Both can take real time, so everything they could invalidate is
                #    re-read AFTER them.
                _target, _backend = _validated_direct_reply_target(receipt_data, "pi")
                direct_refusal = _direct_reply_policy_refusal(
                    provider="pi",
                    pane_id=pane_id,
                    work_dir=work_dir,
                    ccb_project_id=str(receipt_data.get("ccb_project_id") or ""),
                    reply_receipt=receipt_data,
                    to_role=to_role,
                )
                if direct_refusal:
                    raise RuntimeError(direct_refusal)
                # 2. Reload the binding after those checks: it, or the readiness file behind it,
                #    can have been switched while they ran.
                lock_binding, lock_error = peer_pi_destination_binding(
                    work_dir, pane_id=pane_id, terminal=terminal, launch_id=launch_id
                )
                if lock_error or lock_binding is None:
                    raise RuntimeError(
                        f"Pi peer reply destination changed while waiting ({lock_error or 'no Pi binding'})"
                    )
                # 3. Confirm readiness against THE BINDING WE WOULD SEND WITH. Not ready: release
                #    the lock and resume the outer wait against the refreshed binding, inside the
                #    original deadline; never paste.
                fresh = confirm_pi_ready(lock_binding, deadline)
                if fresh.status != "ready":
                    binding = lock_binding
                    continue
                # 4. The saved witness, against that binding and a fresh ready snapshot.
                problem = incarnation(lock_binding, require_ready=True)
                if problem:
                    raise RuntimeError(f"Pi peer reply destination changed while waiting ({problem})")
                binding = lock_binding
                # 5. The deadline, last; the checks above take time.
                if time.monotonic() >= deadline:
                    raise RuntimeError(
                        "Pi peer reply delivery timed out before Pi was ready; nothing was sent"
                    )
                # 6. Paste.
                backend.send_text(pane_id, prompt)
        except PaneLockError as exc:
            raise RuntimeError(f"pane injection lock unavailable: {exc}") from exc
        return (
            0,
            "Peer reply delivered directly.",
            {
                "status": "completed",
                "req_id": req_id,
                "direct_reply_fallback": True,
                "confirmation": "sent",
            },
        )


def _write_correlated_status(receipt: dict[str, Any], line: str) -> None:
    raw = str(receipt.get("status_file") or "").strip()
    if not raw:
        return
    try:
        timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
        with Path(raw).open("a", encoding="utf-8") as handle:
            handle.write(f"{timestamp} {line}\n")
    except Exception:
        pass


#: How often a waiting Pi delivery re-tries the bridge lock.
BRIDGE_LOCK_POLL_S = 0.5


def _acquire_lock(target_hash: str, provider: str, *, wait_until: float | None = None):
    """Take the per-target bridge lock, or refuse with nothing sent.

    A Claude/Codex delivery holds this lock only briefly, so a contended caller refuses at once
    (F2). A Pi delivery can hold it for a whole readiness wait (the 2026-11-27 incident), so a
    contended Pi caller WAITS for it instead: it polls `LOCK_NB` and never runs past its OWN
    deadline (`wait_until`, monotonic). Whatever that wait costs is then spent from the same
    budget by the delivery the lock guards (A1).
    """
    try:
        import fcntl
    except Exception as exc:
        raise RuntimeError("bridge locking requires fcntl on this platform") from exc

    lock_dir = Path(tempfile.gettempdir()) / "ccb-tasks"
    lock_path = lock_dir / f"bridge-{target_hash[:8]}-{provider}.lock"
    try:
        lock_dir.mkdir(parents=True, exist_ok=True)
        lock_handle = lock_path.open("w", encoding="utf-8")
    except OSError as exc:
        if exc.errno != errno.EROFS:
            raise
        print(
            f"[WARN] Bridge lock unavailable on read-only filesystem: {lock_path}; continuing unlocked",
            file=sys.stderr,
        )
        return None, fcntl
    while True:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            if wait_until is None:
                lock_handle.close()
                raise RuntimeError(
                    f"another delivery to {target_hash[:8]} {provider} is in progress; "
                    "nothing was sent"
                ) from exc
            remaining_s = wait_until - time.monotonic()
            if remaining_s <= 0:
                lock_handle.close()
                raise RuntimeError(
                    f"another delivery to {target_hash[:8]} {provider} is still waiting for "
                    "that Pi; nothing was sent"
                ) from exc
            time.sleep(min(BRIDGE_LOCK_POLL_S, remaining_s))
            continue
        return lock_handle, fcntl


def _pi_paste_deadline(timeout: float, started_mono: float, started_epoch: float) -> tuple[float, float]:
    """The ONE paste-start deadline for this Pi delivery: (monotonic, wall clock).

    Fixed at bridge start (`started_mono` / `started_epoch`, recorded in `main()` right after the
    arguments are parsed) from the request's own parsed timeout, after the same normalisation the
    delivery paths use (F3, A1): a non-finite or zero budget is refused BEFORE any lock, and a
    negative one keeps its historical meaning (`PI_PEER_DELIVERY_MAX_S`). Both numbers name the
    same instant, so the local waits compare against the monotonic one and the daemon receives
    the wall-clock one.
    """
    from pi_comm import PI_PEER_DELIVERY_MAX_S

    budget_s = float(timeout)
    if not math.isfinite(budget_s):
        raise RuntimeError("Pi peer reply delivery has a non-finite timeout; nothing was sent")
    if budget_s < 0:
        budget_s = PI_PEER_DELIVERY_MAX_S
    if budget_s <= 0:
        raise RuntimeError("Pi peer reply delivery has no time budget; nothing was sent")
    return started_mono + budget_s, started_epoch + budget_s


PI_PASTE_DEADLINE_REFUSAL = (
    "Pi peer reply delivery reached its paste deadline before submission; nothing was sent"
)


def _refuse_expired_paste_deadline(deadline: float | None) -> None:
    """A1: after the deadline no paste may START -- refuse before anything is submitted."""
    if deadline is not None and time.monotonic() >= deadline:
        raise RuntimeError(PI_PASTE_DEADLINE_REFUSAL)


DAEMON_CAPABILITY_REFUSAL = (
    "cannot confirm the CCB daemon supports role policy; restart this CCB launch"
)


def _policy_destination(*, provider: str, pane_id: str, work_dir: str, ccb_project_id: str):
    from delivery_policy import destination_from_pane

    return destination_from_pane(
        provider, pane_id, ccb_project_id=ccb_project_id, work_dir=work_dir
    )


def _bridge_gate_required(
    *,
    provider: str,
    to_role: str,
    pane_id: str,
    work_dir: str,
    ccb_project_id: str,
) -> bool:
    """Does this peer delivery need the host's gate? (H3b)

    An explicit --to-role always does, and so does a destination launch whose
    own policy is enforcing or unreadable.
    """
    from delivery_policy import MODE_ENFORCE, MODE_ERROR, destination_is_known

    if (to_role or "").strip():
        return True
    destination = _policy_destination(
        provider=provider,
        pane_id=pane_id,
        work_dir=work_dir,
        ccb_project_id=ccb_project_id,
    )
    return destination_is_known(destination) and destination.mode in (MODE_ENFORCE, MODE_ERROR)


def _capability_preflight(state: dict, request: dict[str, Any]) -> str:
    """Ask the daemon to judge the REAL request. "" when it may proceed.

    The probe carries this delivery's actual fields -- kind (including
    `reply`), reply correlation, endpoint identity and sender credential --
    because the answer must be the policy verdict for THIS message, not for a
    synthetic request that a correlated reply would fail.

    "Supported" is exactly "the answer carries an `allowed` key". A policy
    refusal is returned verbatim, as a policy refusal; only a missing op, a
    reply without `allowed`, a malformed answer or an exception is a
    capability failure.
    """
    probe = dict(request)
    probe["operation"] = "check_delivery"
    probe["provider"] = ""
    probe["target_provider"] = str(request.get("provider") or "")
    probe.pop("message", None)
    probe.pop("async_submit", None)
    probe.pop("timeout_explicit", None)
    try:
        response = askd_rpc.request_daemon(
            state, probe, connect_timeout_s=5.0, response_timeout_s=10.0
        )
    except Exception:
        return DAEMON_CAPABILITY_REFUSAL
    if not isinstance(response, dict) or "allowed" not in response:
        return DAEMON_CAPABILITY_REFUSAL
    if response.get("allowed") is False:
        return str(response.get("reason") or "role policy refused this delivery")
    return ""


def _send_to_daemon(
    target: dict[str, Any],
    message: str,
    timeout: float,
    caller_pane_id: str,
    caller_terminal: str,
    sender_work_dir: str,
    intent: str,
    peer_task_id: str,
    reply_to: str,
    provider: str = "claude",
    caller: str = "claude",
    foreground: bool = False,
    to_role: str = "",
    peer_pane_id: str = "",
    peer_project_id: str = "",
    paste_deadline: float | None = None,
) -> tuple[int, str, dict[str, Any]]:
    state_file = find_running_state_file(
        "askd.json",
        protocol_prefix="ask",
        work_dir=sender_work_dir or Path.cwd(),
        timeout_s=0.5,
    )
    state = askd_rpc.read_state(state_file) if state_file is not None else None
    if not state:
        raise RuntimeError("Unified askd daemon not running")
    try:
        token = state["token"]
    except Exception as exc:
        raise RuntimeError("Invalid askd state") from exc

    message_for_target = _append_peer_context(
        message,
        sender_work_dir,
        intent,
        peer_task_id,
        reply_to,
        provider=provider,
        caller=caller,
    )

    delivery_only = provider in PEER_PROVIDERS
    suppress_completion_hook = True

    req = {
        "type": "ask.request",
        "v": 1,
        "id": _task_id(),
        "token": token,
        "provider": provider,
        "work_dir": str(target.get("work_dir") or ""),
        "timeout_s": timeout,
        "message": message_for_target,
        "no_wrap": False,
        "delivery_only": delivery_only,
        "suppress_completion_hook": suppress_completion_hook,
        "caller": caller,
        "caller_pane_id": caller_pane_id,
        "caller_terminal": caller_terminal,
        "caller_work_dir": sender_work_dir,
        # Phase 3 (E3): logical kind, independent of the peer transport's
        # delivery_only, plus the caller's explicit target-role assertion.
        "kind": "reply" if reply_to else ("notify" if intent == "notify" else "request"),
        "to_role": to_role,
        "reply_to": reply_to,
    }
    if provider == "pi":
        # G4: only a Pi destination carries this flag. It lets the daemon fail closed on a Pi peer
        # delivery with no verified endpoint (A5) without guessing from `delivery_only`, which a
        # local one-way notify also sets; a Claude/Codex envelope stays exactly as it was.
        req["peer_delivery"] = True
        if paste_deadline is not None:
            # A1: the ABSOLUTE wall-clock deadline at which a paste may no longer start. The
            # relative `timeout_s` above is what remains of the same budget; this field is what
            # survives daemon discovery, the preflight and askd's own wait, so neither side can
            # stretch the caller's deadline. An older askd ignores it (residual overrun bounded
            # by the preflight time) instead of failing the delivery.
            req["paste_deadline"] = paste_deadline
    sender_member_id, sender_member_token = _sender_credential()
    if sender_member_id and sender_member_token:
        req["sender_member_id"] = sender_member_id
        req["sender_member_token"] = sender_member_token
    if peer_task_id:
        req["req_id"] = peer_task_id
    peer_destination = target.get("peer_destination") if isinstance(target, dict) else None
    if peer_destination:
        # Item 1: carry the saved return-pane identity THROUGH the daemon
        # dispatch, so it can be re-confirmed fresh at both of askd's own
        # checkpoints (enqueue, and immediately before the actual send --
        # see `askd.daemon._UnifiedWorkerPool.submit` /
        # `_SessionWorker._handle_task`) instead of being checked once here
        # and then trusted for however long the request sits queued.
        # Carried on `target` itself (never a new positional parameter)
        # so this function's own call signature -- and every existing
        # caller of it -- stays exactly as it is.
        req["peer_destination"] = dict(peer_destination)

    # H3b/J2: the probe sends THESE fields, so its answer is this request's
    # policy verdict. Run before submission; a required gate never proceeds
    # on a daemon that cannot answer it.
    if _bridge_gate_required(
        provider=provider,
        to_role=to_role,
        # The endpoint identity the send will really use, whether the caller
        # passed it explicitly or it came from the resolved target.
        pane_id=peer_pane_id
        or str(((target.get("providers") or {}).get(provider) or {}).get("pane_id") or ""),
        work_dir=str(target.get("work_dir") or ""),
        ccb_project_id=peer_project_id or str(target.get("ccb_project_id") or ""),
    ):
        refusal = _capability_preflight(state, req)
        if refusal:
            raise RuntimeError(refusal)

    if provider == "pi" and paste_deadline is not None and time.time() >= paste_deadline:
        # A1: the preflight above is real work and may have spent the whole budget. Re-check the
        # absolute deadline IMMEDIATELY before submission: an expired one submits nothing.
        raise RuntimeError(PI_PASTE_DEADLINE_REFUSAL)

    try:
        resp = askd_rpc.request_daemon(
            state,
            req,
            connect_timeout_s=5.0,
            response_timeout_s=timeout + 10 if timeout > 0 else None,
        )
    except Exception as exc:
        raise RuntimeError(f"askd request failed: {exc}") from exc
    meta = resp.get("meta") if isinstance(resp.get("meta"), dict) else {}
    if not meta:
        meta = {}
    if resp.get("req_id"):
        meta.setdefault("req_id", resp.get("req_id"))
    return int(resp.get("exit_code") or 0), str(resp.get("reply") or ""), meta


def _append_peer_context(
    message: str,
    sender_work_dir: str,
    intent: str,
    peer_task_id: str = "",
    reply_to: str = "",
    *,
    provider: str = "claude",
    caller: str = "claude",
) -> str:
    sender = str(sender_work_dir or "").strip()
    body = (message or "").rstrip()
    mode = intent if intent in {"wait", "background", "notify"} else "wait"
    metadata = [f"CCB_PEER_INTENT: {mode}"]
    if peer_task_id:
        metadata.append(f"CCB_PEER_TASK_ID: {peer_task_id}")
    if reply_to:
        metadata.append(f"CCB_PEER_REPLY_TO: {reply_to}")
    if mode == "notify":
        metadata.append("CCB_REPLY_EXPECTED: no")
    else:
        if sender:
            metadata.append(f"CCB_REPLY_TARGET: {sender}")
        if caller in PEER_PROVIDERS:
            metadata.append(f"CCB_REPLY_PROVIDER: {caller}")
        metadata.append("CCB_REPLY_EXPECTED: yes")
    return f"{body}\n\n" + "\n".join(metadata)


def _print_bridge_diagnostics(meta: dict[str, Any]) -> None:
    print(
        "[BRIDGE] "
        f"done_seen={bool(meta.get('done_seen'))} "
        f"anchor_seen={bool(meta.get('anchor_seen'))} "
        f"fallback_scan={bool(meta.get('fallback_scan'))} "
        f"status={meta.get('status') or ''} "
        f"req_id={meta.get('req_id') or ''}",
        file=sys.stderr,
    )


def _persist_peer_delivery(
    task_id: str,
    target: dict[str, Any] | None,
    exit_code: int,
    meta: dict[str, Any] | None,
) -> None:
    if not task_id:
        return
    details = meta if isinstance(meta, dict) else {}
    confirmation = str(details.get("confirmation") or "").strip().lower()
    if exit_code != 0:
        confirmation = "failed"
    elif confirmation not in {"observed", "sent"}:
        confirmation = "sent"
    target_data = target if isinstance(target, dict) else {}
    _write_background_status(f"delivery confirmation={confirmation}")
    try:
        update_peer_delivery(
            task_id,
            confirmation=confirmation,
            target_work_dir=str(target_data.get("work_dir") or ""),
            target_project_id=str(target_data.get("ccb_project_id") or ""),
            target_log_path=str(details.get("log_path") or ""),
        )
    except Exception as exc:
        _write_background_status(f"delivery receipt_update_failed error={exc}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Send a message to a provider in another CCB project.")
    parser.add_argument("--target", required=True, help="Target project path, hash prefix, or list index.")
    parser.add_argument("--provider", choices=PEER_PROVIDERS, default="claude", help="Target provider.")
    parser.add_argument("--timeout", type=float, default=3600.0, help="Request timeout in seconds.")
    parser.add_argument("--caller-pane-id", default=os.environ.get("CCB_CALLER_PANE_ID", ""), help=argparse.SUPPRESS)
    parser.add_argument("--caller-terminal", default=os.environ.get("CCB_CALLER_TERMINAL", ""), help=argparse.SUPPRESS)
    parser.add_argument("--sender-work-dir", default=os.environ.get("CCB_WORK_DIR", os.getcwd()), help=argparse.SUPPRESS)
    parser.add_argument("--caller", default=os.environ.get("CCB_CALLER", "claude"), help=argparse.SUPPRESS)
    parser.add_argument("--intent", choices=("wait", "background", "notify"), default="wait", help=argparse.SUPPRESS)
    parser.add_argument("--peer-task-id", default="", help=argparse.SUPPRESS)
    parser.add_argument("--reply-to", default="", help=argparse.SUPPRESS)
    parser.add_argument(
        "--live-id",
        default=None,
        help="Deliver to this exact live session of the target provider.",
    )
    parser.add_argument("--to-role", default="", help=argparse.SUPPRESS)
    parser.add_argument("--foreground", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("message", nargs="*", help="Message to send. Reads stdin when omitted.")
    args = parser.parse_args(argv)
    # A1: the request's deadline starts HERE, when the bridge start is decided -- not after receipt
    # handling, target discovery and destination validation, which are real work and must spend
    # the caller's budget like everything else. Both clocks name the same instant.
    started_mono = time.monotonic()
    started_epoch = time.time()

    message = " ".join(args.message).strip()
    if not message and not sys.stdin.isatty():
        message = read_stdin_text().strip()
    if not message:
        print("[ERROR] Message cannot be empty", file=sys.stderr)
        return 1
    if args.intent == "notify" and message.rstrip().endswith("?"):
        print("[ERROR] --notify cannot end with a direct question; use --background or --wait", file=sys.stderr)
        return 1
    to_role = str(args.to_role or "").strip().lower()
    if to_role and to_role not in ROLE_NAMES:
        print(f"[ERROR] --to-role must be one of: {', '.join(ROLE_NAMES)}", file=sys.stderr)
        return 1
    if args.reply_to and not PEER_CORRELATION_ID_RE.fullmatch(str(args.reply_to)):
        print("[ERROR] Invalid --reply-to task ID", file=sys.stderr)
        return 1
    live_id = args.live_id.strip() if isinstance(args.live_id, str) else ""
    if args.live_id is not None and not live_id:
        print("[ERROR] --live-id requires a live session ID", file=sys.stderr)
        return 1
    if live_id and args.reply_to:
        # A correlated reply is pinned to the saved return session; a
        # sender-supplied selector must never override that address.
        print(
            "[ERROR] --live-id cannot be combined with --reply-to; a correlated "
            "reply is delivered to the saved return session",
            file=sys.stderr,
        )
        return 1

    reply_receipt: dict[str, Any] | None = None
    target: dict[str, Any] | None = None
    try:
        reply_receipt = _correlated_reply_receipt(
            str(args.reply_to or ""), str(args.target or ""), str(args.provider or "")
        )
        if reply_receipt is not None:
            write_peer_reply(reply_receipt, message)
            _write_correlated_status(reply_receipt, "peer_reply_saved delivery=pending")

        direct_backend = None
        try:
            target = _resolve_target(_load_targets(), args.target)
        except Exception:
            if reply_receipt is None:
                raise
            target, direct_backend = _validated_direct_reply_target(reply_receipt, args.provider)

        if direct_backend is None and live_id:
            # Item 4: an explicit selector resolves from the project's own
            # session inventory and NEVER falls back to the aggregate
            # provider view -- including its ambiguity refusal, which this
            # selector exists to answer.
            target = _select_live_session_target(target, args.provider, live_id)
        elif direct_backend is None:
            provider_status = (target.get("providers") or {}).get(args.provider)
            provider_alive = isinstance(provider_status, dict) and bool(provider_status.get("alive"))
            provider_mounted = isinstance(provider_status, dict) and provider_status.get("mounted") is not False
            provider_ambiguous = isinstance(provider_status, dict) and bool(provider_status.get("ambiguous"))
            legacy_claude_block = args.provider == "claude" and target.get("peer_capable") is False
            # Pi is only a peer provider when the project actually publishes it: a Pi-only
            # project has peer_capable False (that flag keeps its Claude meaning), so its own
            # reachability is judged from the advertised peer providers instead.
            legacy_pi_block = (
                args.provider == "pi"
                and isinstance(target.get("peer_providers"), list)
                and args.provider not in target["peer_providers"]
            )

            # Task 4 / Item 2: a correlated reply whose receipt names a
            # saved return pane is PINNED to that exact session -- daemon
            # delivery (the preferred, existing transport) is trusted only
            # when the generic project+provider lookup demonstrably
            # resolved to that SAME pane; disagreement, ambiguity, or no
            # generic pane at all all fall through to the validated direct
            # fallback using the saved identity, never to a generic guess.
            # This is re-checked here, fresh, immediately before any send
            # is attempted -- never cached from an earlier resolution.
            receipt_pane_id = str(reply_receipt.get("caller_pane_id") or "").strip() if reply_receipt is not None else ""
            if receipt_pane_id:
                receipt_terminal = str(reply_receipt.get("caller_terminal") or "").strip().lower()
                receipt_work_dir = str(reply_receipt.get("work_dir") or "").strip()
                receipt_project_id = str(reply_receipt.get("ccb_project_id") or "").strip()
                receipt_marker = str(reply_receipt.get("caller_pane_title_marker") or "").strip()
                if (
                    receipt_terminal not in {"tmux", "wezterm"}
                    or not receipt_work_dir
                    or not receipt_project_id
                    or (receipt_terminal != "wezterm" and not receipt_marker)
                ):
                    target, direct_backend = _validated_direct_reply_target(reply_receipt, args.provider)
                else:
                    # A sandboxed responder cannot reliably inspect or
                    # send to the original terminal pane directly. Carry
                    # the receipt's exact return identity through askd so
                    # the host daemon revalidates it at enqueue and again
                    # immediately before delivery.
                    target = dict(target)
                    target["peer_destination"] = {
                        "pane_id": receipt_pane_id,
                        "terminal": receipt_terminal,
                        "work_dir": receipt_work_dir,
                        "ccb_project_id": receipt_project_id,
                        "pane_title_marker": receipt_marker,
                    }
                    if args.provider == "pi":
                        # F1: the witness the receipt recorded at submission -- never a fresh
                        # read here, which would adopt whatever pane exists now. A receipt
                        # without one cannot be delivered safely.
                        recorded_witness = {
                            "pane_pid": str(reply_receipt.get("caller_pane_pid") or "").strip(),
                            "launch_token": str(reply_receipt.get("caller_pi_launch_token") or "").strip(),
                        }
                        if not recorded_witness["pane_pid"]:
                            raise RuntimeError(
                                "peer reply receipt has no Pi process witness; refusing to "
                                "deliver to a pane that may have been replaced"
                            )
                        target["peer_destination"]["launch_id"] = str(
                            reply_receipt.get("caller_registry_session_id") or ""
                        ).strip()
                        target["peer_destination"].update(recorded_witness)
            elif provider_ambiguous:
                # Task 3: more than one live session of this provider in
                # the target project -- refuse outright, before anything
                # is delivered, rather than picking one implicitly. No
                # role inference, no first-or-newest default.
                raise RuntimeError(
                    f"target project has more than one live {args.provider} session; "
                    "refusing to guess which one to deliver to"
                )
            elif not provider_alive or not provider_mounted or legacy_claude_block or legacy_pi_block:
                if reply_receipt is None:
                    print(
                        f"[ERROR] Target project has no mounted {args.provider.capitalize()} pane",
                        file=sys.stderr,
                    )
                    return 1
                target, direct_backend = _validated_direct_reply_target(reply_receipt, args.provider)

        if direct_backend is None and not target.get("peer_destination"):
            status = (target.get("providers") or {}).get(args.provider) or {}
            # Current registry-derived targets carry pane evidence. Keep
            # identity-less legacy discovery compatible, but never discard
            # evidence when it is available.
            if status.get("pane_title_marker") or status.get("live_id"):
                target = dict(target)
                target["peer_destination"] = {
                    "pane_id": str(status.get("pane_id") or ""),
                    "terminal": str(status.get("terminal") or target.get("terminal") or ""),
                    "work_dir": str(target.get("work_dir") or ""),
                    "ccb_project_id": str(target.get("ccb_project_id") or ""),
                    "pane_title_marker": str(status.get("pane_title_marker") or ""),
                }
                if args.provider == "pi":
                    # F1: capture the incarnation witness at selection, BEFORE the request is
                    # queued, so a pane replaced later is refused under the lock. Only a Pi
                    # destination carries these fields.
                    pi_launch = str(status.get("launch_id") or "").strip()
                    if pi_launch:
                        target["peer_destination"]["launch_id"] = pi_launch
                    witness, reason = _pi_witness_for(
                        str(target.get("work_dir") or ""),
                        pane_id=str(status.get("pane_id") or ""),
                        terminal=str(
                            status.get("terminal") or target.get("terminal") or ""
                        ),
                        launch_id=pi_launch,
                    )
                    if reason:
                        raise RuntimeError(
                            f"the selected Pi session cannot be bound ({reason}); "
                            "refusing to deliver"
                        )
                    target["peer_destination"].update(witness)

        if args.provider == "pi" and direct_backend is None and not target.get("peer_destination"):
            # A5: fail closed. A Pi peer delivery without a verified endpoint must never reach the
            # ordinary Pi adapter (which would paste into whatever pane the destination project
            # happens to bind, and arm CCB_DONE capture for a message nobody is waiting on).
            raise RuntimeError(
                "Pi peer delivery needs a verified live Pi pane; this target carries no endpoint "
                "identity, so nothing was sent"
            )

        target_hash = str(target.get("ccb_project_id") or "")
        # A1: ONE absolute paste-start deadline, counted from the bridge's own start (recorded
        # above), so discovery and preflight cannot extend it. Zero and a non-finite value are
        # refused here, inside the try, so a reply still reports itself recoverable.
        paste_deadline: float | None = None
        paste_deadline_epoch: float | None = None
        if args.provider == "pi":
            paste_deadline, paste_deadline_epoch = _pi_paste_deadline(
                float(args.timeout or 0), started_mono, started_epoch
            )
            # Nothing is queued for a caller that already stopped waiting: with the deadline
            # counted from bridge start, discovery alone can have spent the whole budget.
            _refuse_expired_paste_deadline(paste_deadline)
            lock_handle, fcntl_mod = _acquire_lock(
                target_hash, args.provider, wait_until=paste_deadline
            )
        else:
            # Claude/Codex keep the instant refusal: their holds are short (F2 wording only).
            lock_handle, fcntl_mod = _acquire_lock(target_hash, args.provider)
        try:
            # A1: acquiring the lock may have spent the whole budget. Re-check the absolute
            # deadline before anything is submitted, and give the delivery only what is left.
            _refuse_expired_paste_deadline(paste_deadline)
            delivery_timeout = (
                args.timeout
                if paste_deadline is None
                else paste_deadline - time.monotonic()
            )
            if direct_backend is not None and args.provider == "pi":
                # A Pi pane cannot queue typed input, so its reply is delivered through the
                # shared Pi gate, which owns the lock ordering itself (wait outside, confirm
                # inside). The Claude/Codex block below is byte-for-byte unchanged.
                exit_code, reply, meta = _deliver_pi_direct_reply(
                    target,
                    direct_backend,
                    reply_receipt,
                    message=message,
                    sender_work_dir=str(args.sender_work_dir or ""),
                    intent=str(args.intent or "wait"),
                    peer_task_id=str(args.peer_task_id or ""),
                    reply_to=str(args.reply_to or ""),
                    timeout=delivery_timeout,
                    caller=str(args.caller or "claude"),
                    to_role=to_role,
                    deadline=paste_deadline,
                )
            elif direct_backend is not None:
                # Item 1/A6: this path bypasses the daemon, so it takes the
                # same cross-process PANE injection lock the daemon send path
                # takes, and revalidates only AFTER it holds it -- a pane
                # replaced while this bridge waited is then refused, not
                # written to.
                from pane_lock import PaneLockError, pane_injection_lock

                lock_pane = str(reply_receipt.get("caller_pane_id") or "")
                try:
                    with pane_injection_lock(direct_backend, lock_pane, None):
                        # Revalidate after acquiring the transport lock, just as
                        # queued daemon delivery revalidates at its send boundary.
                        target, direct_backend = _validated_direct_reply_target(reply_receipt, args.provider)
                        direct_pane = str(
                            ((target.get("providers") or {}).get(args.provider) or {}).get("pane_id") or ""
                        )
                        # Phase 3 (A6.iv/E2): this path reaches a pane without the
                        # daemon, so it applies the same policy module itself.
                        direct_refusal = _direct_reply_policy_refusal(
                            provider=str(args.provider or "claude"),
                            pane_id=direct_pane,
                            work_dir=str(target.get("work_dir") or ""),
                            ccb_project_id=str(target.get("ccb_project_id") or ""),
                            reply_receipt=reply_receipt,
                            to_role=to_role,
                        )
                        if direct_refusal:
                            print(f"[ERROR] {direct_refusal}", file=sys.stderr)
                            return 1
                        exit_code, reply, meta = _send_to_direct_reply_target(
                            target,
                            direct_backend,
                            message,
                            str(args.sender_work_dir or ""),
                            str(args.intent or "wait"),
                            str(args.peer_task_id or ""),
                            str(args.reply_to or ""),
                            str(args.provider or "claude"),
                            str(args.caller or "claude"),
                        )
                except PaneLockError as exc:
                    print(f"[ERROR] {exc}", file=sys.stderr)
                    return 1
            else:
                exit_code, reply, meta = _send_to_daemon(
                    target,
                    message,
                    delivery_timeout,
                    str(args.caller_pane_id or ""),
                    str(args.caller_terminal or ""),
                    str(args.sender_work_dir or ""),
                    str(args.intent or "wait"),
                    str(args.peer_task_id or ""),
                    str(args.reply_to or ""),
                    str(args.provider or "claude"),
                    str(args.caller or "claude"),
                    bool(args.foreground),
                    to_role=to_role,
                    peer_pane_id=str(
                        ((target.get("providers") or {}).get(args.provider) or {}).get("pane_id") or ""
                    ),
                    peer_project_id=str(target.get("ccb_project_id") or ""),
                    paste_deadline=paste_deadline_epoch,
                )
        finally:
            if lock_handle is not None:
                try:
                    fcntl_mod.flock(lock_handle.fileno(), fcntl_mod.LOCK_UN)
                finally:
                    lock_handle.close()
        _persist_peer_delivery(str(args.peer_task_id or ""), target, exit_code, meta)
        if reply_receipt is not None:
            delivery = "direct" if direct_backend is not None else "live"
            _write_correlated_status(
                reply_receipt,
                f"peer_reply_saved delivery={delivery} exit_code={exit_code}",
            )
        if exit_code != 0 or not reply:
            _print_bridge_diagnostics(meta)
        if exit_code != 0 and reply_receipt is not None:
            print(
                f"[RECOVERABLE] Reply saved for task {args.reply_to}; the sender can run pend {args.reply_to}",
                file=sys.stderr,
            )
        if reply:
            print(reply)
        return exit_code
    except Exception as exc:
        _persist_peer_delivery(
            str(args.peer_task_id or ""), target, 1, {"confirmation": "failed"}
        )
        if reply_receipt is not None:
            _write_correlated_status(reply_receipt, "peer_reply_saved delivery=failed exit_code=1")
        print(f"[ERROR] {exc}", file=sys.stderr)
        if reply_receipt is not None:
            print(
                f"[RECOVERABLE] Reply saved for task {args.reply_to}; the sender can run pend {args.reply_to}",
                file=sys.stderr,
            )
        return 1


if __name__ == "__main__":
    _write_background_status(f"running pid={os.getpid()}")
    exit_code = main()
    _write_background_status(f"finished exit_code={exit_code}")
    if exit_code != 0:
        _write_background_status(f"failed exit_code={exit_code}")
        _notify_background_failure(exit_code)
    sys.exit(exit_code)

#!/usr/bin/env python3
from __future__ import annotations

import argparse
import errno
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from typing import Any

script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

import askd_rpc
from askd_runtime import find_running_state_file
from ccb_protocol import wrap_codex_delivery_prompt
from compat import read_stdin_text, setup_windows_encoding
from completion_hook import COMPLETION_STATUS_FAILED, notify_completion
from laskd_protocol import wrap_claude_delivery_prompt
from task_receipts import find_receipt, write_peer_reply
from terminal import get_backend_for_session

setup_windows_encoding()

PEER_CORRELATION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
PEER_PROVIDERS = ("claude", "codex")


def _write_background_status(line: str) -> None:
    raw = (os.environ.get("CCB_PEER_STATUS_FILE") or "").strip()
    if not raw:
        return
    try:
        timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
        with Path(raw).open("a", encoding="utf-8") as handle:
            handle.write(f"{timestamp} {line}\n")
    except Exception:
        pass


def _notify_background_failure(exit_code: int) -> None:
    if not (os.environ.get("CCB_PEER_STATUS_FILE") or "").strip():
        return
    task_id = (os.environ.get("CCB_REQ_ID") or "").strip() or "unknown"
    provider = (os.environ.get("CCB_PEER_PROVIDER") or "claude").strip().lower()
    log_file = (os.environ.get("CCB_PEER_LOG_FILE") or "").strip()
    reply_to = (os.environ.get("CCB_PEER_REPLY_TO") or "").strip()
    if reply_to:
        recovery = f" The reply remains saved; run `pend {reply_to}` to recover it."
    else:
        recovery = f" Inspect the task log or run `pend {task_id}` for details."
    notify_completion(
        provider=f"peer-{provider}",
        output_file=log_file or None,
        reply=(
            f"Peer {provider.capitalize()} delivery failed "
            f"(exit code {exit_code}).{recovery}"
        ),
        req_id=task_id,
        done_seen=False,
        caller=(os.environ.get("CCB_CALLER") or "claude").strip().lower(),
        work_dir=(os.environ.get("CCB_WORK_DIR") or "").strip(),
        status=COMPLETION_STATUS_FAILED,
        caller_pane_id=(os.environ.get("CCB_CALLER_PANE_ID") or "").strip(),
        caller_terminal=(os.environ.get("CCB_CALLER_TERMINAL") or "").strip(),
    )


def _task_id() -> str:
    now = datetime.now()
    ms = now.microsecond // 1000
    return f"bridge-{now.strftime('%Y%m%d-%H%M%S')}-{ms:03d}-{os.getpid()}"


def _load_targets() -> list[dict[str, Any]]:
    list_cmd = script_dir / "ccb-list"
    result = subprocess.run(
        [sys.executable, str(list_cmd), "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "ccb-list failed")
    try:
        data = json.loads(result.stdout)
    except Exception as exc:
        raise RuntimeError(f"failed to parse ccb-list output: {exc}") from exc
    if not isinstance(data, list):
        raise RuntimeError("ccb-list returned invalid JSON")
    return [entry for entry in data if isinstance(entry, dict)]


def _same_path(left: str, right: str) -> bool:
    if left == right:
        return True
    try:
        return Path(left).expanduser().resolve() == Path(right).expanduser().resolve()
    except Exception:
        return False


def _resolve_target(entries: list[dict[str, Any]], target: str) -> dict[str, Any]:
    raw = (target or "").strip()
    if not raw:
        raise ValueError("target cannot be empty")

    matches: list[dict[str, Any]] = []

    index_raw = raw[1:-1] if raw.startswith("[") and raw.endswith("]") else raw
    if index_raw.isdigit():
        wanted = int(index_raw)
        matches = [entry for entry in entries if int(entry.get("index") or 0) == wanted]
        if matches:
            return matches[0]

    path_matches = [entry for entry in entries if _same_path(str(entry.get("work_dir") or ""), raw)]
    if path_matches:
        if len(path_matches) > 1:
            raise ValueError(f"target path is ambiguous: {raw}")
        return path_matches[0]

    if len(raw) >= 4 and all(ch in "0123456789abcdefABCDEF" for ch in raw):
        lowered = raw.lower()
        matches = [
            entry
            for entry in entries
            if str(entry.get("ccb_project_id") or "").lower().startswith(lowered)
        ]
        if len(matches) == 1:
            return matches[0]
        if len(matches) > 1:
            raise ValueError(f"target hash prefix is ambiguous: {raw}")

    raise ValueError(f"no active CCB project matches target: {raw}")


def _correlated_reply_receipt(reply_to: str, target: str, provider: str) -> dict[str, Any] | None:
    if not reply_to:
        return None
    found = find_receipt(reply_to)
    if not found:
        return None
    receipt = found[1]
    if not str(receipt.get("provider") or "").startswith("peer-"):
        return None
    if not bool(receipt.get("reply_expected")):
        raise ValueError(f"peer task does not expect a reply: {reply_to}")

    expected_provider = str(receipt.get("caller") or "").strip().lower()
    if expected_provider != provider:
        raise ValueError(
            f"reply provider mismatch for task {reply_to}: expected {expected_provider or 'unknown'}"
        )

    work_dir = str(receipt.get("work_dir") or "").strip()
    project_id = str(receipt.get("ccb_project_id") or "").strip().lower()
    raw_target = (target or "").strip()
    project_match = (
        len(raw_target) >= 4
        and all(ch in "0123456789abcdefABCDEF" for ch in raw_target)
        and project_id.startswith(raw_target.lower())
    )
    if not work_dir or not (_same_path(work_dir, raw_target) or project_match):
        raise ValueError(f"reply target mismatch for task {reply_to}")
    return receipt


def _validated_direct_reply_target(
    receipt: dict[str, Any], provider: str
) -> tuple[dict[str, Any], Any]:
    pane_id = str(receipt.get("caller_pane_id") or "").strip()
    terminal = str(receipt.get("caller_terminal") or "").strip().lower()
    work_dir = str(receipt.get("work_dir") or "").strip()
    project_id = str(receipt.get("ccb_project_id") or "").strip()
    if not pane_id or terminal not in {"tmux", "wezterm"} or not work_dir or not project_id:
        raise RuntimeError("peer reply receipt has no complete direct return address")

    backend = get_backend_for_session({"terminal": terminal})
    if backend is None:
        raise RuntimeError(f"terminal backend is unavailable: {terminal}")
    try:
        pane_alive = bool(backend.is_alive(pane_id))
    except Exception:
        pane_alive = False
    if not pane_alive:
        raise RuntimeError(f"original {provider.capitalize()} pane is no longer alive")

    cwd_check = getattr(backend, "pane_matches_cwd_strict", None)
    if not callable(cwd_check) or not bool(cwd_check(pane_id, work_dir)):
        raise RuntimeError("original peer pane no longer matches the receipt project")

    marker = str(receipt.get("caller_pane_title_marker") or "").strip()
    if not marker:
        raise RuntimeError("peer reply receipt has no CCB pane marker")
    resolver = getattr(backend, "find_pane_by_title_marker", None)
    if not callable(resolver) or str(resolver(marker, work_dir) or "").strip() != pane_id:
        raise RuntimeError("original peer pane no longer matches its CCB marker")

    target = {
        "work_dir": work_dir,
        "ccb_project_id": project_id,
        "providers": {provider: {"alive": True, "mounted": True, "pane_id": pane_id}},
    }
    return target, backend


def _send_to_direct_reply_target(
    target: dict[str, Any],
    backend: Any,
    message: str,
    sender_work_dir: str,
    intent: str,
    peer_task_id: str,
    reply_to: str,
    provider: str,
    caller: str,
) -> tuple[int, str, dict[str, Any]]:
    req_id = peer_task_id or _task_id()
    message_for_target = _append_peer_context(
        message,
        sender_work_dir,
        intent,
        peer_task_id,
        reply_to,
        provider=provider,
        caller=caller,
    )
    if provider == "codex":
        prompt = wrap_codex_delivery_prompt(message_for_target, req_id)
    else:
        prompt = wrap_claude_delivery_prompt(message_for_target, req_id)
    pane_id = str(((target.get("providers") or {}).get(provider) or {}).get("pane_id") or "")
    backend.send_text(pane_id, prompt)
    return (
        0,
        "Peer reply delivered directly.",
        {"status": "completed", "req_id": req_id, "direct_reply_fallback": True},
    )


def _write_correlated_status(receipt: dict[str, Any], line: str) -> None:
    raw = str(receipt.get("status_file") or "").strip()
    if not raw:
        return
    try:
        timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
        with Path(raw).open("a", encoding="utf-8") as handle:
            handle.write(f"{timestamp} {line}\n")
    except Exception:
        pass


def _acquire_lock(target_hash: str, provider: str):
    try:
        import fcntl
    except Exception as exc:
        raise RuntimeError("bridge locking requires fcntl on this platform") from exc

    lock_dir = Path(tempfile.gettempdir()) / "ccb-tasks"
    lock_path = lock_dir / f"bridge-{target_hash[:8]}-{provider}.lock"
    try:
        lock_dir.mkdir(parents=True, exist_ok=True)
        lock_handle = lock_path.open("w", encoding="utf-8")
    except OSError as exc:
        if exc.errno != errno.EROFS:
            raise
        print(
            f"[WARN] Bridge lock unavailable on read-only filesystem: {lock_path}; continuing unlocked",
            file=sys.stderr,
        )
        return None, fcntl
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        lock_handle.close()
        raise RuntimeError(f"target provider is busy: {target_hash[:8]} {provider}") from exc
    return lock_handle, fcntl


def _send_to_daemon(
    target: dict[str, Any],
    message: str,
    timeout: float,
    caller_pane_id: str,
    caller_terminal: str,
    sender_work_dir: str,
    intent: str,
    peer_task_id: str,
    reply_to: str,
    provider: str = "claude",
    caller: str = "claude",
    foreground: bool = False,
) -> tuple[int, str, dict[str, Any]]:
    state_file = find_running_state_file(
        "askd.json",
        protocol_prefix="ask",
        work_dir=sender_work_dir or Path.cwd(),
        timeout_s=0.5,
    )
    state = askd_rpc.read_state(state_file) if state_file is not None else None
    if not state:
        raise RuntimeError("Unified askd daemon not running")
    try:
        token = state["token"]
    except Exception as exc:
        raise RuntimeError("Invalid askd state") from exc

    message_for_target = _append_peer_context(
        message,
        sender_work_dir,
        intent,
        peer_task_id,
        reply_to,
        provider=provider,
        caller=caller,
    )

    delivery_only = provider in PEER_PROVIDERS
    suppress_completion_hook = True

    req = {
        "type": "ask.request",
        "v": 1,
        "id": _task_id(),
        "token": token,
        "provider": provider,
        "work_dir": str(target.get("work_dir") or ""),
        "timeout_s": timeout,
        "message": message_for_target,
        "no_wrap": False,
        "delivery_only": delivery_only,
        "suppress_completion_hook": suppress_completion_hook,
        "caller": caller,
        "caller_pane_id": caller_pane_id,
        "caller_terminal": caller_terminal,
        "caller_work_dir": sender_work_dir,
    }
    if peer_task_id:
        req["req_id"] = peer_task_id

    try:
        resp = askd_rpc.request_daemon(
            state,
            req,
            connect_timeout_s=5.0,
            response_timeout_s=timeout + 10 if timeout > 0 else None,
        )
    except Exception as exc:
        raise RuntimeError(f"askd request failed: {exc}") from exc
    meta = resp.get("meta") if isinstance(resp.get("meta"), dict) else {}
    if not meta:
        meta = {}
    if resp.get("req_id"):
        meta.setdefault("req_id", resp.get("req_id"))
    return int(resp.get("exit_code") or 0), str(resp.get("reply") or ""), meta


def _append_peer_context(
    message: str,
    sender_work_dir: str,
    intent: str,
    peer_task_id: str = "",
    reply_to: str = "",
    *,
    provider: str = "claude",
    caller: str = "claude",
) -> str:
    sender = str(sender_work_dir or "").strip()
    body = (message or "").rstrip()
    mode = intent if intent in {"wait", "background", "notify"} else "wait"
    metadata = [f"CCB_PEER_INTENT: {mode}"]
    if peer_task_id:
        metadata.append(f"CCB_PEER_TASK_ID: {peer_task_id}")
    if reply_to:
        metadata.append(f"CCB_PEER_REPLY_TO: {reply_to}")
    if mode == "notify":
        metadata.append("CCB_REPLY_EXPECTED: no")
    else:
        if sender:
            metadata.append(f"CCB_REPLY_TARGET: {sender}")
        if caller in PEER_PROVIDERS:
            metadata.append(f"CCB_REPLY_PROVIDER: {caller}")
        metadata.append("CCB_REPLY_EXPECTED: yes")
    return f"{body}\n\n" + "\n".join(metadata)


def _print_bridge_diagnostics(meta: dict[str, Any]) -> None:
    print(
        "[BRIDGE] "
        f"done_seen={bool(meta.get('done_seen'))} "
        f"anchor_seen={bool(meta.get('anchor_seen'))} "
        f"fallback_scan={bool(meta.get('fallback_scan'))} "
        f"status={meta.get('status') or ''} "
        f"req_id={meta.get('req_id') or ''}",
        file=sys.stderr,
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Send a message to a provider in another CCB project.")
    parser.add_argument("--target", required=True, help="Target project path, hash prefix, or list index.")
    parser.add_argument("--provider", choices=PEER_PROVIDERS, default="claude", help="Target provider.")
    parser.add_argument("--timeout", type=float, default=3600.0, help="Request timeout in seconds.")
    parser.add_argument("--caller-pane-id", default=os.environ.get("CCB_CALLER_PANE_ID", ""), help=argparse.SUPPRESS)
    parser.add_argument("--caller-terminal", default=os.environ.get("CCB_CALLER_TERMINAL", ""), help=argparse.SUPPRESS)
    parser.add_argument("--sender-work-dir", default=os.environ.get("CCB_WORK_DIR", os.getcwd()), help=argparse.SUPPRESS)
    parser.add_argument("--caller", default=os.environ.get("CCB_CALLER", "claude"), help=argparse.SUPPRESS)
    parser.add_argument("--intent", choices=("wait", "background", "notify"), default="wait", help=argparse.SUPPRESS)
    parser.add_argument("--peer-task-id", default="", help=argparse.SUPPRESS)
    parser.add_argument("--reply-to", default="", help=argparse.SUPPRESS)
    parser.add_argument("--foreground", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("message", nargs="*", help="Message to send. Reads stdin when omitted.")
    args = parser.parse_args(argv)

    message = " ".join(args.message).strip()
    if not message and not sys.stdin.isatty():
        message = read_stdin_text().strip()
    if not message:
        print("[ERROR] Message cannot be empty", file=sys.stderr)
        return 1
    if args.intent == "notify" and message.rstrip().endswith("?"):
        print("[ERROR] --notify cannot end with a direct question; use --background or --wait", file=sys.stderr)
        return 1
    if args.reply_to and not PEER_CORRELATION_ID_RE.fullmatch(str(args.reply_to)):
        print("[ERROR] Invalid --reply-to task ID", file=sys.stderr)
        return 1

    reply_receipt: dict[str, Any] | None = None
    try:
        reply_receipt = _correlated_reply_receipt(
            str(args.reply_to or ""), str(args.target or ""), str(args.provider or "")
        )
        if reply_receipt is not None:
            write_peer_reply(reply_receipt, message)
            _write_correlated_status(reply_receipt, "peer_reply_saved delivery=pending")

        direct_backend = None
        try:
            target = _resolve_target(_load_targets(), args.target)
        except Exception:
            if reply_receipt is None:
                raise
            target, direct_backend = _validated_direct_reply_target(reply_receipt, args.provider)

        if direct_backend is None:
            provider_status = (target.get("providers") or {}).get(args.provider)
            provider_alive = isinstance(provider_status, dict) and bool(provider_status.get("alive"))
            provider_mounted = isinstance(provider_status, dict) and provider_status.get("mounted") is not False
            legacy_claude_block = args.provider == "claude" and target.get("peer_capable") is False
            if not provider_alive or not provider_mounted or legacy_claude_block:
                if reply_receipt is None:
                    print(
                        f"[ERROR] Target project has no mounted {args.provider.capitalize()} pane",
                        file=sys.stderr,
                    )
                    return 1
                target, direct_backend = _validated_direct_reply_target(reply_receipt, args.provider)

        target_hash = str(target.get("ccb_project_id") or "")
        lock_handle, fcntl_mod = _acquire_lock(target_hash, args.provider)
        try:
            if direct_backend is not None:
                exit_code, reply, meta = _send_to_direct_reply_target(
                    target,
                    direct_backend,
                    message,
                    str(args.sender_work_dir or ""),
                    str(args.intent or "wait"),
                    str(args.peer_task_id or ""),
                    str(args.reply_to or ""),
                    str(args.provider or "claude"),
                    str(args.caller or "claude"),
                )
            else:
                exit_code, reply, meta = _send_to_daemon(
                    target,
                    message,
                    args.timeout,
                    str(args.caller_pane_id or ""),
                    str(args.caller_terminal or ""),
                    str(args.sender_work_dir or ""),
                    str(args.intent or "wait"),
                    str(args.peer_task_id or ""),
                    str(args.reply_to or ""),
                    str(args.provider or "claude"),
                    str(args.caller or "claude"),
                    bool(args.foreground),
                )
        finally:
            if lock_handle is not None:
                try:
                    fcntl_mod.flock(lock_handle.fileno(), fcntl_mod.LOCK_UN)
                finally:
                    lock_handle.close()
        if reply_receipt is not None:
            delivery = "direct" if direct_backend is not None else "live"
            _write_correlated_status(
                reply_receipt,
                f"peer_reply_saved delivery={delivery} exit_code={exit_code}",
            )
        if exit_code != 0 or not reply:
            _print_bridge_diagnostics(meta)
        if exit_code != 0 and reply_receipt is not None:
            print(
                f"[RECOVERABLE] Reply saved for task {args.reply_to}; the sender can run pend {args.reply_to}",
                file=sys.stderr,
            )
        if reply:
            print(reply)
        return exit_code
    except Exception as exc:
        if reply_receipt is not None:
            _write_correlated_status(reply_receipt, "peer_reply_saved delivery=failed exit_code=1")
        print(f"[ERROR] {exc}", file=sys.stderr)
        if reply_receipt is not None:
            print(
                f"[RECOVERABLE] Reply saved for task {args.reply_to}; the sender can run pend {args.reply_to}",
                file=sys.stderr,
            )
        return 1


if __name__ == "__main__":
    _write_background_status(f"running pid={os.getpid()}")
    exit_code = main()
    _write_background_status(f"finished exit_code={exit_code}")
    if exit_code != 0:
        _write_background_status(f"failed exit_code={exit_code}")
        _notify_background_failure(exit_code)
    sys.exit(exit_code)

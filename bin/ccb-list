#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from compat import setup_windows_encoding
from ccb_runtime_status import list_project_runtime_statuses
from pane_registry import _is_stale, _iter_registry_files
from project_id import compute_ccb_project_id

setup_windows_encoding()


def _load_json_dict(path: Path) -> dict[str, Any] | None:
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _updated_at(data: dict[str, Any], fallback_path: Path) -> float:
    raw = data.get("updated_at") or data.get("created_at") or 0
    try:
        return float(raw)
    except Exception:
        pass
    if isinstance(raw, str):
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S"):
            try:
                return datetime.strptime(raw, fmt).timestamp()
            except Exception:
                pass
    try:
        return fallback_path.stat().st_mtime
    except Exception:
        return 0.0


def _tmux_panes() -> dict[str, dict[str, str]]:
    try:
        result = subprocess.run(
            ["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{pane_title}\t#{pane_current_path}\t#{pane_dead}"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except Exception:
        return {}
    if result.returncode != 0:
        return {}

    panes: dict[str, dict[str, str]] = {}
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 3)
        if len(parts) < 4:
            continue
        pane_id, title, cwd, dead = parts
        pane_id = pane_id.strip()
        if not pane_id:
            continue
        panes[pane_id] = {
            "pane_id": pane_id,
            "title": title.strip(),
            "cwd": cwd.strip(),
            "dead": dead.strip(),
        }
    return panes


def _collect_wezterm_panes(value: Any, found: dict[str, dict[str, Any]]) -> None:
    if isinstance(value, dict):
        pane_id = value.get("pane_id") or value.get("paneId") or value.get("pane")
        if pane_id is not None:
            found[str(pane_id)] = value
        for child in value.values():
            _collect_wezterm_panes(child, found)
    elif isinstance(value, list):
        for child in value:
            _collect_wezterm_panes(child, found)


def _wezterm_panes() -> dict[str, dict[str, Any]]:
    try:
        result = subprocess.run(
            ["wezterm", "cli", "list", "--format", "json"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except Exception:
        return {}
    if result.returncode != 0:
        return {}
    try:
        data = json.loads(result.stdout)
    except Exception:
        return {}
    found: dict[str, dict[str, Any]] = {}
    _collect_wezterm_panes(data, found)
    return found


def _extract_cwd_path(file_url: str) -> str:
    if not file_url:
        return ""
    value = str(file_url).strip()
    if not value.startswith("file://"):
        return value
    rest = value[7:]
    if rest.startswith("/"):
        path = rest
    else:
        slash = rest.find("/")
        path = rest[slash:] if slash >= 0 else ""
    try:
        from urllib.parse import unquote

        path = unquote(path)
    except Exception:
        pass
    if len(path) >= 3 and path[0] == "/" and path[2] == ":":
        path = path[1:]
    return path.rstrip("/") or "/"


def _cwd_matches(pane_cwd: str, work_dir: str) -> bool:
    if not pane_cwd or not work_dir:
        return False
    extracted = _extract_cwd_path(pane_cwd)
    if not extracted:
        return False
    try:
        return os.path.normpath(extracted) == os.path.normpath(work_dir)
    except Exception:
        return False


def _title_matches_marker(pane: dict[str, Any], marker: str) -> bool:
    if not marker:
        return False
    for key in ("title", "pane_title", "window_title", "tab_title"):
        value = pane.get(key)
        if isinstance(value, str) and value.startswith(marker):
            return True
    return False


def _provider_alive(terminal: str, provider_data: dict[str, Any], work_dir: str, panes: dict[str, dict[str, Any]]) -> bool:
    pane_id = str(provider_data.get("pane_id") or provider_data.get("tmux_session") or "").strip()
    if not pane_id:
        return False

    pane = panes.get(pane_id)
    if not pane:
        return False

    marker = str(provider_data.get("pane_title_marker") or "").strip()
    if terminal == "tmux":
        if str(pane.get("dead") or "").strip() not in {"", "0"}:
            return False
        if marker:
            return _title_matches_marker(pane, marker)
        return False

    if terminal == "wezterm":
        cwd = str(pane.get("cwd") or "").strip()
        if cwd:
            return _cwd_matches(cwd, work_dir)
        if marker:
            return _title_matches_marker(pane, marker)
        return False

    return False


def _session_entries(include_stale: bool) -> list[dict[str, Any]]:
    entries: list[dict[str, Any]] = []
    for project in list_project_runtime_statuses(include_stale=include_stale):
        project_dict = project.to_dict()
        providers: dict[str, dict[str, Any]] = {}
        for provider_key, status in project_dict.get("providers", {}).items():
            if not isinstance(status, dict):
                continue
            providers[provider_key] = {
                "pane_id": status.get("pane_id") or "",
                "pane_title_marker": status.get("pane_title_marker") or "",
                "alive": bool(status.get("pane_alive")),
                "mounted": bool(status.get("mounted")),
                "capable": bool(status.get("capable")),
                "configured": bool(status.get("configured")),
                "registered": bool(status.get("registered")),
                "pane_alive": bool(status.get("pane_alive")),
                "session_bound": bool(status.get("session_bound")),
                "daemon_online": bool(status.get("daemon_online")),
                "reason": status.get("reason") or "",
                "timestamp_stale": bool(status.get("timestamp_stale")),
                "session_file": status.get("session_file") or "",
                "updated_at": int(status.get("updated_at") or 0),
            }

        claude_entry = providers.get("claude") or {}
        claude_alive = bool(claude_entry.get("alive")) if isinstance(claude_entry, dict) else False
        if not include_stale and not claude_alive:
            continue

        entries.append(
            {
                "index": 0,
                "work_dir": project_dict.get("work_dir") or "",
                "ccb_project_id": project_dict.get("ccb_project_id") or "",
                "terminal": project_dict.get("terminal") or "",
                "updated_at": int(project_dict.get("updated_at") or 0),
                "providers": providers,
            }
        )

    for index, entry in enumerate(entries, start=1):
        entry["index"] = index
    return entries


def _print_human(entries: list[dict[str, Any]]) -> None:
    print("Active CCB Projects:")
    if not entries:
        print("  (none)")
        return

    for entry in entries:
        project_hash = str(entry.get("ccb_project_id") or "")[:8]
        print(f"  [{entry['index']}] {entry['work_dir']}  ({project_hash})")
        providers = entry.get("providers") or {}
        for provider in sorted(providers):
            provider_data = providers[provider]
            pane_id = provider_data.get("pane_id") or ""
            state = "mounted" if provider_data.get("mounted") else ("alive" if provider_data.get("alive") else "stale")
            dot = "●" if provider_data.get("mounted") else ("◐" if provider_data.get("alive") else "○")
            reason = provider_data.get("reason") or ""
            suffix = f" reason:{reason}" if reason and not provider_data.get("mounted") else ""
            print(f"      {provider:<14} pane:{pane_id}  {dot} {state}{suffix}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="List active CCB projects and provider panes.")
    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    parser.add_argument("--stale", action="store_true", help="Include projects with only stale panes.")
    args = parser.parse_args(argv)

    entries = _session_entries(include_stale=args.stale)
    if args.json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    else:
        _print_human(entries)
    return 0


if __name__ == "__main__":
    sys.exit(main())

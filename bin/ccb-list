#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from compat import setup_windows_encoding
from pane_registry import _is_stale, _iter_registry_files
from project_id import compute_ccb_project_id

setup_windows_encoding()


def _load_json_dict(path: Path) -> dict[str, Any] | None:
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _updated_at(data: dict[str, Any], fallback_path: Path) -> float:
    raw = data.get("updated_at") or data.get("created_at") or 0
    try:
        return float(raw)
    except Exception:
        pass
    if isinstance(raw, str):
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S"):
            try:
                return datetime.strptime(raw, fmt).timestamp()
            except Exception:
                pass
    try:
        return fallback_path.stat().st_mtime
    except Exception:
        return 0.0


def _tmux_panes() -> dict[str, dict[str, str]]:
    try:
        result = subprocess.run(
            ["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{pane_title}\t#{pane_current_path}\t#{pane_dead}"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except Exception:
        return {}
    if result.returncode != 0:
        return {}

    panes: dict[str, dict[str, str]] = {}
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 3)
        if len(parts) < 4:
            continue
        pane_id, title, cwd, dead = parts
        pane_id = pane_id.strip()
        if not pane_id:
            continue
        panes[pane_id] = {
            "pane_id": pane_id,
            "title": title.strip(),
            "cwd": cwd.strip(),
            "dead": dead.strip(),
        }
    return panes


def _collect_wezterm_panes(value: Any, found: dict[str, dict[str, Any]]) -> None:
    if isinstance(value, dict):
        pane_id = value.get("pane_id") or value.get("paneId") or value.get("pane")
        if pane_id is not None:
            found[str(pane_id)] = value
        for child in value.values():
            _collect_wezterm_panes(child, found)
    elif isinstance(value, list):
        for child in value:
            _collect_wezterm_panes(child, found)


def _wezterm_panes() -> dict[str, dict[str, Any]]:
    try:
        result = subprocess.run(
            ["wezterm", "cli", "list", "--format", "json"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except Exception:
        return {}
    if result.returncode != 0:
        return {}
    try:
        data = json.loads(result.stdout)
    except Exception:
        return {}
    found: dict[str, dict[str, Any]] = {}
    _collect_wezterm_panes(data, found)
    return found


def _extract_cwd_path(file_url: str) -> str:
    if not file_url:
        return ""
    value = str(file_url).strip()
    if not value.startswith("file://"):
        return value
    rest = value[7:]
    if rest.startswith("/"):
        path = rest
    else:
        slash = rest.find("/")
        path = rest[slash:] if slash >= 0 else ""
    try:
        from urllib.parse import unquote

        path = unquote(path)
    except Exception:
        pass
    if len(path) >= 3 and path[0] == "/" and path[2] == ":":
        path = path[1:]
    return path.rstrip("/") or "/"


def _cwd_matches(pane_cwd: str, work_dir: str) -> bool:
    if not pane_cwd or not work_dir:
        return False
    extracted = _extract_cwd_path(pane_cwd)
    if not extracted:
        return False
    try:
        return os.path.normpath(extracted) == os.path.normpath(work_dir)
    except Exception:
        return False


def _title_matches_marker(pane: dict[str, Any], marker: str) -> bool:
    if not marker:
        return False
    for key in ("title", "pane_title", "window_title", "tab_title"):
        value = pane.get(key)
        if isinstance(value, str) and value.startswith(marker):
            return True
    return False


def _provider_alive(terminal: str, provider_data: dict[str, Any], work_dir: str, panes: dict[str, dict[str, Any]]) -> bool:
    pane_id = str(provider_data.get("pane_id") or provider_data.get("tmux_session") or "").strip()
    if not pane_id:
        return False

    pane = panes.get(pane_id)
    if not pane:
        return False

    marker = str(provider_data.get("pane_title_marker") or "").strip()
    if terminal == "tmux":
        if str(pane.get("dead") or "").strip() not in {"", "0"}:
            return False
        if marker:
            return _title_matches_marker(pane, marker)
        return False

    if terminal == "wezterm":
        cwd = str(pane.get("cwd") or "").strip()
        if cwd:
            return _cwd_matches(cwd, work_dir)
        if marker:
            return _title_matches_marker(pane, marker)
        return False

    return False


def _session_entries(include_stale: bool) -> list[dict[str, Any]]:
    try:
        session_files = list(_iter_registry_files())
    except Exception:
        session_files = []

    pane_cache: dict[str, dict[str, dict[str, Any]]] = {}
    entries: list[dict[str, Any]] = []

    for session_file in session_files:
        data = _load_json_dict(session_file)
        if not data:
            continue

        work_dir_raw = str(data.get("work_dir") or "").strip()
        if not work_dir_raw:
            continue
        work_dir = Path(work_dir_raw).expanduser()
        if not work_dir.exists():
            continue

        providers_raw = data.get("providers")
        if not isinstance(providers_raw, dict):
            providers_raw = {}

        terminal = str(data.get("terminal") or "tmux").strip().lower() or "tmux"
        if terminal not in {"tmux", "wezterm"}:
            terminal = "tmux"
        if terminal not in pane_cache:
            pane_cache[terminal] = _wezterm_panes() if terminal == "wezterm" else _tmux_panes()
        terminal_panes = pane_cache[terminal]
        updated_at = _updated_at(data, session_file)
        if _is_stale(int(updated_at)):
            continue

        providers: dict[str, dict[str, Any]] = {}
        any_alive = False
        for provider, provider_data in providers_raw.items():
            if not isinstance(provider_data, dict):
                continue
            pane_id = str(provider_data.get("pane_id") or provider_data.get("tmux_session") or "").strip()
            pane_title_marker = str(provider_data.get("pane_title_marker") or "").strip()
            alive = _provider_alive(terminal, provider_data, str(work_dir), terminal_panes)
            any_alive = any_alive or alive
            providers[str(provider)] = {
                "pane_id": pane_id,
                "pane_title_marker": pane_title_marker,
                "alive": alive,
            }

        if not include_stale and not any_alive:
            continue

        try:
            ccb_project_id = compute_ccb_project_id(work_dir)
        except Exception:
            ccb_project_id = session_file.stem.replace("ccb-session-ai-", "")

        entries.append(
            {
                "index": 0,
                "work_dir": str(work_dir),
                "ccb_project_id": ccb_project_id,
                "terminal": terminal,
                "updated_at": updated_at,
                "providers": providers,
            }
        )

    # Deduplicate: one entry per project hash, keeping the most recent alive session.
    seen: dict[str, dict[str, Any]] = {}
    for entry in sorted(entries, key=lambda e: float(e.get("updated_at") or 0), reverse=True):
        key = entry["ccb_project_id"]
        if key not in seen:
            seen[key] = entry

    deduped = sorted(seen.values(), key=lambda e: float(e.get("updated_at") or 0), reverse=True)
    for index, entry in enumerate(deduped, start=1):
        entry["index"] = index
    return deduped


def _print_human(entries: list[dict[str, Any]]) -> None:
    print("Active CCB Projects:")
    if not entries:
        print("  (none)")
        return

    for entry in entries:
        project_hash = str(entry.get("ccb_project_id") or "")[:8]
        print(f"  [{entry['index']}] {entry['work_dir']}  ({project_hash})")
        providers = entry.get("providers") or {}
        for provider in sorted(providers):
            provider_data = providers[provider]
            pane_id = provider_data.get("pane_id") or ""
            status = "alive" if provider_data.get("alive") else "stale"
            dot = "●" if provider_data.get("alive") else "○"
            print(f"      {provider:<7} pane:{pane_id}  {dot} {status}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="List active CCB projects and provider panes.")
    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    parser.add_argument("--stale", action="store_true", help="Include projects with only stale panes.")
    args = parser.parse_args(argv)

    entries = _session_entries(include_stale=args.stale)
    if args.json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    else:
        _print_human(entries)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""
ccb-ping - Test connectivity with AI providers.

Usage:
    ccb-ping <provider> [--session-file FILE] [--autostart]

Providers:
    gemini, codex, opencode, claude, hermes
"""

import sys
import os
import argparse
from pathlib import Path

script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from compat import setup_windows_encoding
from ccb_runtime_status import (
    daemon_queue_status,
    describe_queue_status,
    inside_managed_codex_sandbox,
    provider_status_for_target,
    resolve_daemon_work_dir,
)
setup_windows_encoding()


# Provider to communicator module and class mapping
PROVIDER_COMMS = {
    "gemini": ("gemini_comm", "GeminiCommunicator"),
    "codex": ("codex_comm", "CodexCommunicator"),
    "opencode": ("opencode_comm", "OpenCodeCommunicator"),
    "claude": ("claude_comm", "ClaudeCommunicator"),
    "hermes": ("hermes_comm", "HermesCommunicator"),
}

def _usage():
    print("Usage: ccb-ping <provider> [--session-file FILE] [--autostart]", file=sys.stderr)
    print("", file=sys.stderr)
    print("Providers:", file=sys.stderr)
    print("  gemini, codex, opencode, claude, hermes", file=sys.stderr)


def _resolve_work_dir(session_file: str | None) -> Path:
    if not session_file:
        return Path.cwd()
    raw = str(session_file).strip()
    if not raw:
        return Path.cwd()
    try:
        p = Path(os.path.expanduser(raw)).resolve()
    except Exception:
        p = Path(os.path.expanduser(raw)).absolute()
    # Session files normally live in <project>/.ccb/.<provider>-session
    parent_name = p.parent.name
    if parent_name in (".ccb", ".ccb_config"):
        return p.parent.parent
    return p.parent


def _queue_report(provider: str, work_dir: Path) -> tuple[bool, str]:
    """(stuck, line) for the provider's request queue in the project daemon.

    Connectivity alone cannot show a queue blocked behind a task that was
    delivered but never finished, so ping reports the queue separately.
    """
    try:
        queues = daemon_queue_status(work_dir, provider)
    except Exception as exc:
        return False, f"queue: unknown ({exc})"
    try:
        stuck_after = float(os.environ.get("CCB_PING_STUCK_AFTER_S", "600") or 600)
    except ValueError:
        stuck_after = 600.0
    return describe_queue_status(queues, stuck_after_s=stuck_after)


def _finish(provider: str, work_dir: Path, healthy: bool) -> int:
    stuck, line = _queue_report(provider, work_dir)
    print(line)
    if stuck:
        print(
            f"❌ {provider.capitalize()} is connected but its request queue is stuck; "
            "new requests will wait behind the task above."
        )
        return 1
    return 0 if healthy else 1


def main():
    if len(sys.argv) < 2:
        _usage()
        return 1

    provider = sys.argv[1].lower()

    if provider in ("-h", "--help"):
        _usage()
        return 0

    if provider not in PROVIDER_COMMS:
        print(f"[ERROR] Unknown provider: {provider}", file=sys.stderr)
        print(f"[ERROR] Available: {', '.join(PROVIDER_COMMS.keys())}", file=sys.stderr)
        return 1

    # Parse remaining arguments
    parser = argparse.ArgumentParser(prog=f"ccb-ping {provider}", add_help=False)
    parser.add_argument("--session-file", dest="session_file", default=None)
    parser.add_argument("--live-id", dest="live_id", default=None)
    parser.add_argument("--autostart", action="store_true", help="Start daemon if needed")
    args, _ = parser.parse_known_args(sys.argv[2:])

    if args.live_id and args.session_file:
        print("[ERROR] --live-id cannot be combined with --session-file", file=sys.stderr)
        return 1

    if args.session_file:
        os.environ["CCB_SESSION_FILE"] = str(args.session_file)
    work_dir = _resolve_work_dir(args.session_file)

    if inside_managed_codex_sandbox():
        if provider == "codex" and args.live_id:
            from live_sessions import read_inventory
            from pane_registry import load_registry_by_session_id

            launch_id = (os.environ.get("CODEX_SESSION_ID") or "").strip()
            record = load_registry_by_session_id(launch_id) if launch_id else None
            inventory = read_inventory(record or {})
            known = inventory.valid and any(
                session.provider == "codex" and session.live_id == args.live_id
                for session in inventory.sessions
            )
            if not known:
                print(f"[ERROR] Unknown Codex live id: {args.live_id}", file=sys.stderr)
            else:
                print("[ERROR] Cannot verify a per-live-id Codex session inside the managed sandbox", file=sys.stderr)
            return 1
        try:
            status_work_dir = work_dir if args.session_file else resolve_daemon_work_dir(work_dir)
            status = provider_status_for_target(provider, work_dir=status_work_dir)
        except Exception as exc:
            print(f"[ERROR] {provider.capitalize()} connectivity test failed: {exc}", file=sys.stderr)
            return 1
        if status.mounted:
            print(f"✅ {provider.capitalize()} connection OK (host runtime verified)")
            return _finish(provider, status_work_dir, True)
        print(f"❌ {provider.capitalize()} connection error: {status.reason or 'not_mounted'}")
        return 1

    # Import and instantiate the communicator
    module_name, class_name = PROVIDER_COMMS[provider]
    try:
        module = __import__(module_name)
        comm_class = getattr(module, class_name)

        # Pre-emptive autostart check if requested
        if args.autostart:
            try:
                from askd_client import maybe_start_daemon, wait_for_daemon_ready
                from providers import (
                    CASK_CLIENT_SPEC,
                    GASK_CLIENT_SPEC,
                    LASK_CLIENT_SPEC,
                    OASK_CLIENT_SPEC,
                    HASK_CLIENT_SPEC,
                )

                specs = {
                    "codex": CASK_CLIENT_SPEC,
                    "gemini": GASK_CLIENT_SPEC,
                    "opencode": OASK_CLIENT_SPEC,
                    "claude": LASK_CLIENT_SPEC,
                    "hermes": HASK_CLIENT_SPEC,
                }

                spec = specs.get(provider)
                if spec:
                    maybe_start_daemon(spec, work_dir)
                    # Small wait for it to bind
                    wait_for_daemon_ready(spec, 0.5)
            except Exception as e:
                print(f"[WARN] Autostart pre-check failed: {e}", file=sys.stderr)

        if provider == "codex" and (args.live_id or (not args.session_file and _paired_codex_sessions())):
            return _ping_paired_codex(args.live_id, work_dir, args.session_file)

        comm = comm_class()
        healthy, message = comm.ping(display=False)
        print(message)
        if not healthy:
            return 1
        try:
            queue_work_dir = work_dir if args.session_file else resolve_daemon_work_dir(work_dir)
        except Exception:
            queue_work_dir = work_dir
        return _finish(provider, queue_work_dir, healthy)
    except ImportError as e:
        print(f"[ERROR] Module import failed: {e}", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"[ERROR] {provider.capitalize()} connectivity test failed: {e}", file=sys.stderr)
        return 1


def _paired_codex_sessions():
    """Return the current launch's Codex panes when it is a paired launch."""
    from live_sessions import read_inventory
    from pane_registry import load_registry_by_session_id

    launch_id = (os.environ.get("CODEX_SESSION_ID") or "").strip()
    if not launch_id:
        return []
    record = load_registry_by_session_id(launch_id)
    inventory = read_inventory(record or {})
    if not inventory.valid:
        return []
    sessions = [s for s in inventory.sessions if s.provider == "codex" and s.active]
    return sessions if len(sessions) > 1 else []


def _ping_paired_codex(live_id, work_dir, explicit_session_file=None):
    from live_sessions import read_inventory
    from pane_registry import load_registry_by_session_id

    launch_id = (os.environ.get("CODEX_SESSION_ID") or "").strip()
    record = load_registry_by_session_id(launch_id) if launch_id else None
    inventory = read_inventory(record or {})
    sessions = [s for s in inventory.sessions if s.provider == "codex"] if inventory.valid else []
    if live_id:
        sessions = [s for s in sessions if s.live_id == live_id]
        if not sessions:
            print(f"[ERROR] Unknown Codex live id: {live_id}", file=sys.stderr)
            return 1
    elif len([s for s in sessions if s.active]) < 2:
        print("[ERROR] Paired Codex session registry unavailable", file=sys.stderr)
        return 1
    from live_roles import roles_for_record
    roles = roles_for_record(record or {})
    healthy_all = True
    for session in sessions:
        if not session.active:
            healthy, message = False, "session inactive"
        else:
            try:
                session_file = Path(explicit_session_file or session.session_file).expanduser()
                old_session_file = os.environ.get("CCB_SESSION_FILE")
                try:
                    os.environ["CCB_SESSION_FILE"] = str(session_file)
                    from codex_comm import CodexCommunicator
                    healthy, message = CodexCommunicator().ping(display=False)
                finally:
                    if old_session_file is None:
                        os.environ.pop("CCB_SESSION_FILE", None)
                    else:
                        os.environ["CCB_SESSION_FILE"] = old_session_file
            except Exception as exc:
                healthy, message = False, f"❌ Codex connectivity test failed: {exc}"
        role = roles.get(session.live_id, "")
        role_label = f", {role}" if role else ""
        print(f"{session.live_id} ({session.pane_id or 'no pane'}{role_label}): {message}")
        healthy_all = healthy_all and healthy
    try:
        queue_work_dir = work_dir if explicit_session_file else resolve_daemon_work_dir(work_dir)
    except Exception:
        queue_work_dir = work_dir
    return _finish("codex", queue_work_dir, healthy_all)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""ccb-remote - inspect and recover cross-machine CCB deliveries.

    ccb-remote status <host-qualified-id>   destination state for a submission
    ccb-remote list <host>                  allowlisted projects on a host
    ccb-remote reply <host-qualified-id>    answer a delivered reply-expected request

`status` is the recovery path for a submission whose acknowledgement was lost:
it reads the outbound receipt (the host comes from the receipt only, never from
the command line), asks the destination, and records the destination state.

`reply` runs on the DESTINATION machine, inside the pane that received the
request: it reads the answer from stdin (UTF-8, at most the message cap), reads
the destination journal only to find the daemon that owns the record, and sends
that daemon one local `remote_reply` operation. It never writes the journal,
never contacts another machine, and sends exactly one answer.

The M1 command surface is unchanged; delivery-only submissions still have no
reply path.
"""

from __future__ import annotations

import io
import json
import os
import sys
from pathlib import Path

script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
if str(lib_dir) not in sys.path:
    sys.path.insert(0, str(lib_dir))

from compat import setup_windows_encoding  # noqa: E402

setup_windows_encoding()

import askd_rpc  # noqa: E402
import remote_client  # noqa: E402
import remote_journal  # noqa: E402
import remote_protocol  # noqa: E402
from cli_output import EXIT_ERROR, EXIT_OK  # noqa: E402

#: The answer was written to a daemon channel but never confirmed (a lost
#: response, or a commit whose durability is unconfirmed): retrying the SAME
#: answer is the safe recovery, so this is distinct from a refusal.
EXIT_UNCONFIRMED = 2

USAGE = """Usage:
  ccb-remote status <host-qualified-id>   Ask the destination for this request's state
  ccb-remote list <host> [--json]         List the projects this key may address on <host>
  ccb-remote reply <host-qualified-id>    Answer a delivered request (answer on stdin)
  ccb-remote pair [<alias>]               Guided setup: let this machine reach another one
  ccb-remote unpair <alias>               Remove that pairing and revoke its grant
  ccb-remote pairing <verb>               Destination side, JSON on stdin (used by `pair`)
  ccb-remote -h                           Show this help

`reply` runs on the machine that received the request, from the pane that
received it, and sends exactly one answer:

    ccb-remote reply <host-qualified-id> <<'CCB_REPLY'
    the answer
    CCB_REPLY

Cross-machine delivery is pull-based: the source fetches the answer; the
destination never connects back. `status` is the recovery path for a delivery
whose acknowledgement was lost.
"""


class _ReplyError(RuntimeError):
    """The answer cannot be sent at all (nothing was written anywhere)."""


def _usage(stream=None) -> None:
    print(USAGE, file=stream or sys.stderr)


def _cmd_status(argv: list[str]) -> int:
    if len(argv) != 1:
        print("[ERROR] status requires exactly one host-qualified request id", file=sys.stderr)
        return EXIT_ERROR
    try:
        remote_protocol.parse_remote_id(argv[0])
    except remote_protocol.ProtocolError:
        print("[ERROR] not a host-qualified request id (expected <local-id>-h<token>)", file=sys.stderr)
        return EXIT_ERROR
    result = remote_client.status(argv[0])
    return EXIT_OK if result.exit_code == remote_client.EXIT_ACCEPTED else result.exit_code


def _cmd_list(argv: list[str]) -> int:
    as_json = False
    rest = list(argv)
    if "--json" in rest:
        as_json = True
        rest.remove("--json")
    if len(rest) != 1:
        print("[ERROR] list requires exactly one configured host alias", file=sys.stderr)
        return EXIT_ERROR
    captured = io.StringIO()
    result = remote_client.list_projects(rest[0], out=captured, err=sys.stderr)
    if as_json:
        print(
            json.dumps(
                {
                    "host": result.host,
                    "state": "ok"
                    if result.exit_code == remote_client.EXIT_ACCEPTED
                    else "failed",
                    "reason": result.reason,
                    "projects": result.projects,
                },
                ensure_ascii=False,
                indent=2,
            )
        )
    else:
        sys.stdout.write(captured.getvalue())
    return EXIT_OK if result.exit_code == remote_client.EXIT_ACCEPTED else result.exit_code


def _read_reply_stdin() -> str:
    """The answer from stdin: raw bytes, strict UTF-8, capped, never stripped."""
    cap = remote_protocol.MAX_TEXT_BYTES
    try:
        data = sys.stdin.buffer.read(cap + 1)
    except (OSError, ValueError) as exc:
        raise _ReplyError(f"the answer could not be read from stdin: {exc}") from None
    if len(data) > cap:
        raise _ReplyError(f"the answer is larger than the {cap}-byte reply cap")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise _ReplyError("the answer is not valid UTF-8") from None
    try:
        return remote_protocol.validate_reply_text(text)
    except remote_protocol.ProtocolError as exc:
        raise _ReplyError(exc.message) from None


def _sender_credential() -> tuple[str, str]:
    """This pane's launch credential, exactly as `ccb-role` reads it."""
    member_id = (os.environ.get("CCB_MEMBER_ID") or "").strip()
    member_token = (os.environ.get("CCB_MEMBER_TOKEN") or "").strip()
    if not member_id or not member_token:
        # Older launches exported only the pair credential; it names the same
        # member, so it stays accepted.
        member_id = member_id or (os.environ.get("CCB_LIVE_ID") or "").strip()
        member_token = member_token or (os.environ.get("CCB_LIVE_TOKEN") or "").strip()
    return member_id, member_token


def _cmd_reply(argv: list[str]) -> int:
    """Destination-local: send this pane's one answer to the record's owner."""
    if len(argv) != 1:
        print("[ERROR] reply requires exactly one host-qualified request id", file=sys.stderr)
        return EXIT_ERROR
    request_id = argv[0]
    try:
        remote_protocol.parse_remote_id(request_id)
    except remote_protocol.ProtocolError:
        print(
            "[ERROR] not a host-qualified request id (expected <local-id>-h<token>)",
            file=sys.stderr,
        )
        return EXIT_ERROR

    try:
        text = _read_reply_stdin()
    except _ReplyError as exc:
        print(f"[ERROR] {exc}; nothing was written", file=sys.stderr)
        return EXIT_ERROR

    member_id, member_token = _sender_credential()
    if not member_id or not member_token:
        print(
            "[ERROR] This session has no CCB launch credential, so it cannot answer; "
            "nothing was written",
            file=sys.stderr,
        )
        return EXIT_ERROR

    # Read-only: the journal is consulted ONLY to find the owning daemon.
    try:
        record = remote_journal.RemoteJournal().read(request_id)
    except remote_journal.JournalError as exc:
        print(f"[ERROR] The request journal is unreadable ({exc}); nothing was written", file=sys.stderr)
        return EXIT_ERROR
    if record is None:
        print("[ERROR] No such request on this machine; nothing was written", file=sys.stderr)
        return EXIT_ERROR

    owner_state_file = str(record.get("owner_daemon") or "").strip()
    if not owner_state_file:
        print("[ERROR] This request names no owner daemon; nothing was written", file=sys.stderr)
        return EXIT_ERROR
    state = askd_rpc.read_state(Path(owner_state_file))
    if not isinstance(state, dict) or not state.get("token"):
        print(
            "[ERROR] The daemon that owns this request is not running; nothing was written",
            file=sys.stderr,
        )
        return EXIT_ERROR

    request = {
        "type": "ask.request",
        "v": 1,
        "id": f"reply-{request_id}",
        "token": state["token"],
        "operation": "remote_reply",
        "request_id": request_id,
        "member_id": member_id,
        "member_token": member_token,
        "reply_text": text,
    }
    try:
        response = askd_rpc.request_daemon(
            state, request, connect_timeout_s=5.0, response_timeout_s=30.0
        )
    except askd_rpc.DaemonConnectionError:
        print(
            "[ERROR] The daemon that owns this request is unreachable; nothing was written",
            file=sys.stderr,
        )
        return EXIT_ERROR
    except Exception as exc:
        # The request may have reached the daemon; retrying the SAME answer is
        # the safe recovery (the digest rule makes it idempotent).
        print(
            f"[ERROR] The answer could not be confirmed ({type(exc).__name__}); "
            "run the same command again with the same answer",
            file=sys.stderr,
        )
        return EXIT_UNCONFIRMED

    if not isinstance(response, dict):
        print(
            "[ERROR] The destination daemon returned no usable reply; run the same "
            "command again with the same answer",
            file=sys.stderr,
        )
        return EXIT_UNCONFIRMED

    if response.get("ok") is True:
        remote = response.get("remote")
        remote = remote if isinstance(remote, dict) else {}
        if str(remote.get("request_id") or "") != request_id or str(
            remote.get("state") or ""
        ) != remote_journal.STATE_ANSWERED:
            print(
                "[ERROR] The confirmation does not match this request; run the same "
                "command again with the same answer",
                file=sys.stderr,
            )
            return EXIT_UNCONFIRMED
        print(f"id={request_id} state={remote_journal.STATE_ANSWERED}")
        return EXIT_OK

    error = response.get("error")
    error = error if isinstance(error, dict) else {}
    code = str(error.get("code") or "")
    message = " ".join(str(error.get("message") or "").split())
    if code == remote_protocol.ERR_REPLY_UNKNOWN:
        print(
            f"[WARN] The answer may already be recorded ({message or code}); run the same "
            "command again with the same answer",
            file=sys.stderr,
        )
        return EXIT_UNCONFIRMED
    print(
        f"[ERROR] The answer was refused: {message or code or 'no reason given'} "
        "(nothing was written)",
        file=sys.stderr,
    )
    return EXIT_ERROR


def _cmd_pairing(argv: list[str]) -> int:
    """Destination side of `pair`: one JSON request in, one JSON result out.

    Runs over the user's NORMAL ssh login (the restricted key cannot run this),
    so it must never prompt and never print anything but its JSON result. Any
    failure -- including a bug -- becomes `{"ok": false, ...}` rather than a
    traceback on the protocol stream.
    """
    import remote_pairing

    verb = argv[0] if len(argv) == 1 else ""
    if verb not in ("inspect", "apply", "revoke"):
        print(json.dumps({"ok": False, "error": "pairing needs exactly one of: inspect, apply, revoke"}))
        return EXIT_ERROR
    try:
        raw = sys.stdin.read()
        request = json.loads(raw) if raw.strip() else {}
        if not isinstance(request, dict):
            request = {}
    except ValueError:
        print(json.dumps({"ok": False, "error": "the pairing request is not valid JSON"}))
        return EXIT_ERROR

    gate = Path(__file__).resolve().parent / "ccb-remote-gate"
    try:
        if verb == "inspect":
            result = remote_pairing.inspect_destination(
                gate_path=gate,
                lookup_principal=str(request.get("lookup_principal") or ""),
                lookup_pubkey=str(request.get("lookup_pubkey") or ""),
            )
        elif verb == "apply":
            result = remote_pairing.apply_destination(request, gate_path=gate)
        else:
            result = remote_pairing.revoke_destination(request, gate_path=gate)
    except remote_pairing.PairingError as exc:
        payload = {"ok": False, "error": str(exc)}
        if getattr(exc, "refused", False):
            # B4: a refusal that provably happened before any write may be
            # promised as "nothing was written". A failure after a write
            # started (or a bug) carries no such promise, because it does not
            # know what is on disk.
            payload["refused"] = True
        if getattr(exc, "stale", False):
            # The machine moved under this approval: the approved scope is
            # still good, so the source keeps its half and the retry resumes.
            payload["stale"] = True
        print(json.dumps(payload))
        return EXIT_ERROR
    except Exception as exc:  # a bug must not leak a traceback to the caller
        print(json.dumps({"ok": False, "error": f"pairing failed ({type(exc).__name__})"}))
        return EXIT_ERROR
    print(json.dumps(result))
    return EXIT_OK


def _cmd_pair(argv: list[str]) -> int:
    import argparse

    import remote_pair_cli
    import remote_pairing

    parser = argparse.ArgumentParser(
        prog="ccb-remote pair",
        description="Guided setup: let this machine send to another machine's CCB projects.",
    )
    parser.add_argument("alias", nargs="?", default="", help="host alias to type (for example: server)")
    parser.add_argument("--destination", default="", help="ssh destination [user@]host")
    parser.add_argument("--port", type=int, default=22, help="ssh port (default 22)")
    parser.add_argument("--principal", default="", help="principal name this machine gets on the other side")
    parser.add_argument("--token", default="", help="issuer token (a label, shared with the other side)")
    parser.add_argument("--key", default="", help="identity file (default ~/.ccb/remote/keys/<alias>)")
    parser.add_argument(
        "--fingerprint",
        default="",
        help="verified host-key fingerprint (SHA256:...) when this machine has not connected before",
    )
    parser.add_argument(
        "--remote-ccb",
        default="",
        help="ccb-remote path on the other machine (default ~/.local/bin/ccb-remote)",
    )
    parser.add_argument(
        "--known-hosts",
        default="",
        help="the known_hosts file that verifies that machine (default: your ssh's own)",
    )
    parser.add_argument(
        "--pairing-identity",
        default="",
        help="login identity for the pairing connection (default: what your ssh picks)",
    )
    parser.add_argument(
        "--share",
        action="append",
        default=[],
        metavar="ALIAS[=WORK_DIR]",
        help="project to share, repeatable (default: choose from the list)",
    )
    parser.add_argument(
        "--shares-json",
        default="",
        help='exact shares as JSON: {"demo": {"work_dir": "/srv/demo", "providers": ["claude"]}}',
    )
    parser.add_argument(
        "--providers", default="claude,codex", help="default providers for shared projects"
    )
    parser.add_argument("--yes", action="store_true", help="no prompts (for scripts and tests)")
    parser.add_argument(
        "--print-remote-steps",
        action="store_true",
        help=(
            "print the exact command to run on the other machine instead of applying it "
            "there (the read-only inspect still uses your ssh login; with no login there, "
            "follow the guide's 'Manual setup' section)"
        ),
    )
    parser.add_argument(
        "--rotate-pin",
        action="store_true",
        help="replace a DIFFERENT existing host key pin for that machine (after verifying it)",
    )
    parsed = parser.parse_args(argv)

    shares: dict[str, dict] = {}
    share_specs: list[str] = []
    for spec in parsed.share:
        # ALIAS=WORK_DIR pins an explicit directory now; a bare ALIAS is
        # resolved against the projects found on the other machine later.
        alias_part, _, work_dir = spec.partition("=")
        alias = alias_part.strip()
        if not alias:
            print("[ERROR] --share needs an alias", file=sys.stderr)
            return EXIT_ERROR
        try:
            entry_alias = remote_pairing.validate_alias(alias, "project alias")
            if work_dir.strip():
                shares[entry_alias] = {
                    "alias": entry_alias,
                    "work_dir": remote_pairing.validate_work_dir(work_dir),
                    "providers": list(remote_pairing.validate_providers(parsed.providers)),
                }
            else:
                share_specs.append(f"{entry_alias}=")
        except remote_pairing.PairingError as exc:
            print(f"[ERROR] {exc}", file=sys.stderr)
            return EXIT_ERROR
    options = remote_pair_cli.PairOptions(
        alias=parsed.alias,
        destination=parsed.destination,
        port=parsed.port,
        principal=parsed.principal,
        token=parsed.token,
        key_path=parsed.key,
        fingerprint=parsed.fingerprint,
        remote_ccb=parsed.remote_ccb,
        known_hosts=parsed.known_hosts,
        identity=parsed.pairing_identity,
        providers=tuple(remote_pairing.validate_providers(parsed.providers)),
        shares=shares,
        shares_json=parsed.shares_json,
        yes=parsed.yes,
        print_remote_steps=parsed.print_remote_steps,
        rotate_pin=parsed.rotate_pin,
        share_specs=share_specs,
    )
    return remote_pair_cli.pair(options)


def _cmd_unpair(argv: list[str]) -> int:
    import argparse

    import remote_pair_cli

    parser = argparse.ArgumentParser(
        prog="ccb-remote unpair",
        description="Remove a pairing on this machine and revoke its grant on the other one.",
    )
    parser.add_argument("alias", nargs="?", default="", help="host alias to remove")
    parser.add_argument("--principal", default="", help="principal used by that pairing")
    parser.add_argument("--destination", default="", help="ssh destination [user@]host")
    parser.add_argument("--port", type=int, default=22, help="ssh port")
    parser.add_argument("--remote-ccb", default="", help="ccb-remote path on the other machine")
    parser.add_argument(
        "--known-hosts", default="", help="the known_hosts file that verifies that machine"
    )
    parser.add_argument(
        "--pairing-identity", default="", help="login identity for the pairing connection"
    )
    parser.add_argument(
        "--local-only",
        action="store_true",
        help="forget it here even if the remote revocation could not be confirmed",
    )
    parser.add_argument("--yes", action="store_true", help="no prompts (for scripts and tests)")
    parsed = parser.parse_args(argv)
    options = remote_pair_cli.UnpairOptions(
        alias=parsed.alias,
        local_only=parsed.local_only,
        principal=parsed.principal,
        destination=parsed.destination,
        port=parsed.port,
        remote_ccb=parsed.remote_ccb,
        known_hosts=parsed.known_hosts,
        identity=parsed.pairing_identity,
        yes=parsed.yes,
    )
    return remote_pair_cli.unpair(options)


def main(argv: list[str]) -> int:
    args = list(argv[1:])
    if not args or args[0] in ("-h", "--help"):
        _usage(sys.stdout if args else sys.stderr)
        return EXIT_OK if args else EXIT_ERROR

    command, rest = args[0], args[1:]
    try:
        if command == "status":
            return _cmd_status(rest)
        if command == "list":
            return _cmd_list(rest)
        if command == "reply":
            return _cmd_reply(rest)
        if command == "pairing":
            return _cmd_pairing(rest)
        if command == "pair":
            return _cmd_pair(rest)
        if command == "unpair":
            return _cmd_unpair(rest)
    except remote_client.RemoteConfigError as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR
    except remote_client.RemoteRefusal as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR

    print(f"[ERROR] Unknown ccb-remote command: {command}", file=sys.stderr)
    _usage()
    return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main(sys.argv))

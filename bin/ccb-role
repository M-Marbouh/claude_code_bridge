#!/usr/bin/env python3
"""
ccb-role - Record the role this session's conversation was assigned.

Usage:
    ccb-role set <role>     Record this session's role (e.g. implementer, ratifier)
    ccb-role show           Print this session's own currently recorded role
    ccb-role brief          Print the recorded role's instructions, if any are installed
    ccb-role clear          Remove this session's role

The role is shown by `ccb-list` so a lead can find who is who. A role never
selects a destination: `ask` chooses its destination by provider or route,
and `--to-role <role>` only asserts that destination's role (verified on
every launch). A launch started with `role_policy = "enforce"` refuses
delivery that the role matrix does not allow. A role grants nothing else: it
restricts no edits, push, deploy or any other action.
Only the session itself can set its role with this command, using the
credential CCB exported into its pane (CCB_MEMBER_ID/CCB_MEMBER_TOKEN, or
CCB_LIVE_ID/CCB_LIVE_TOKEN in a launch with live session IDs). A launcher may
also record the roles configured in `ccb.config` at launch, with each
session's own credential. The role lasts only for the current launch and
disappears if the session's pane dies or is replaced. A session with no CCB
launch credential is outside a CCB launch and cannot record or read a role.
`ccb-role show` prints the role alone on stdout and exits 0; every refusal
(no role, not this session's credential, stale pane or launch) prints nothing
on stdout, a reason on stderr, and exits 1.
`ccb-role brief` takes the same validation path and then prints the role's
instructions, so a session inside a launch can take the role its launch
recorded for it without the user invoking a skill: the read-only body of
`role_skills/ccb-<role>.md` beside this executable. A recorded role with no
installed instructions prints one line naming the role and exits 0; it never
changes the role. Every refusal there behaves exactly like `show`: empty
stdout, a reason on stderr, exit 1.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from compat import setup_windows_encoding
from ccb_runtime_status import (
    daemon_set_role,
    daemon_show_role,
    inside_managed_codex_sandbox,
    resolve_daemon_work_dir,
)
from live_roles import set_own_role, show_own_role

setup_windows_encoding()


def _usage() -> None:
    print(
        "Usage: ccb-role set <role> | ccb-role show | ccb-role brief | ccb-role clear",
        file=sys.stderr,
    )


# The roles CCB ships instructions for. Any other recorded role is a custom
# role that `set` accepts and that simply has no shipped instructions.
BUILTIN_ROLES = ("lead", "ratifier", "implementer")


def _role_skills_dir() -> Path:
    """The instructions that ship beside this executable.

    Derived from the resolved script path exactly like the `lib/` import above,
    so an installed symlink in a bin directory on PATH still finds the prefix's
    `role_skills/` next to its own `lib/`. Nothing is read from the environment.
    """
    return Path(__file__).resolve().parent.parent / "role_skills"


def _print_brief(role: str) -> int:
    """Print the instructions for a recorded role; never change the role."""
    if role not in BUILTIN_ROLES:
        # Custom roles never read a file: CCB ships no instructions for them,
        # and a stray file in the install prefix must not become a briefing.
        print(f"Role: {role} (no role instructions are installed for this role)")
        return 0
    body_path = _role_skills_dir() / f"ccb-{role}.md"
    try:
        body = body_path.read_text(encoding="utf-8")
    except OSError:
        body = ""
    if not body.strip():
        # A shipped role with no body means a broken install, not a custom
        # role: say so instead of silently briefing nothing.
        print(
            f"[ERROR] No role instructions are installed for '{role}' ({body_path}).",
            file=sys.stderr,
        )
        return 1
    sys.stdout.write(body if body.endswith("\n") else body + "\n")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        _usage()
        return 0 if argv else 1
    action = argv[0]
    if action == "set" and len(argv) == 2:
        role = argv[1]
    elif action == "clear" and len(argv) == 1:
        role = ""
    elif action in ("show", "brief") and len(argv) == 1:
        role = None
    else:
        _usage()
        return 1

    member_id = (os.environ.get("CCB_MEMBER_ID") or "").strip()
    member_token = (os.environ.get("CCB_MEMBER_TOKEN") or "").strip()
    if not member_id or not member_token:
        # Older launches exported only the pair credential; it names the same
        # member, so it stays accepted.
        member_id = member_id or (os.environ.get("CCB_LIVE_ID") or "").strip()
        member_token = member_token or (os.environ.get("CCB_LIVE_TOKEN") or "").strip()
    if not member_id or not member_token:
        print(
            "[ERROR] This session has no CCB launch credential. Roles are only recorded "
            "from inside a CCB launch.",
            file=sys.stderr,
        )
        return 1

    if role is None:
        # Read-only: stdout carries the role (or its instructions) and nothing
        # else. Every refusal keeps stdout empty, so a caller can trust a
        # nonempty stdout.
        try:
            if inside_managed_codex_sandbox():
                ok, detail = daemon_show_role(
                    resolve_daemon_work_dir(Path.cwd()), member_id, member_token
                )
            else:
                ok, detail = show_own_role(member_id, member_token)
        except Exception as exc:
            print(f"[ERROR] Role lookup failed: {exc}", file=sys.stderr)
            return 1
        if not ok:
            print(f"[ERROR] {detail}", file=sys.stderr)
            return 1
        if action == "brief":
            return _print_brief(detail)
        print(detail)
        return 0

    try:
        if inside_managed_codex_sandbox():
            ok, detail = daemon_set_role(
                resolve_daemon_work_dir(Path.cwd()), member_id, member_token, role
            )
        else:
            ok, detail = set_own_role(member_id, member_token, role)
    except Exception as exc:
        print(f"[ERROR] Role update failed: {exc}", file=sys.stderr)
        return 1
    if not ok:
        print(f"[ERROR] {detail}", file=sys.stderr)
        return 1
    print(detail)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

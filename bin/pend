#!/usr/bin/env python3
"""View the reply for an exact CCB task or the current caller's latest task."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path


script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from cli_output import EXIT_ERROR, EXIT_NO_REPLY, EXIT_OK
from project_id import compute_ccb_project_id
from task_receipts import caller_pane, caller_session_id, find_receipt, iter_receipts


PROVIDER_PENDS = {
    "gemini": "gpend",
    "codex": "cpend",
    "opencode": "opend",
    "claude": "lpend",
}
TASK_ID_RE = re.compile(r"^\d{8}-\d{6}-\d{3}-\d+(?:-\d+)?$")


def _legacy_pend(provider: str, extra: list[str]) -> int:
    pend_path = script_dir / PROVIDER_PENDS[provider]
    if not pend_path.exists():
        print(f"[ERROR] Command not found: {pend_path}", file=sys.stderr)
        return EXIT_ERROR
    cmd = [sys.executable, str(pend_path), *extra] if sys.platform == "win32" else [str(pend_path), *extra]
    try:
        return subprocess.run(cmd).returncode
    except Exception as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR


def _receipt_identity(receipt: dict) -> tuple[str, str, str]:
    return (
        str(receipt.get("caller_session_id") or "").strip(),
        str(receipt.get("caller_terminal") or "").strip(),
        str(receipt.get("caller_pane_id") or "").strip(),
    )


def _latest_for_current_caller(provider: str) -> tuple[Path, dict] | None:
    records = [(path, data) for path, data in iter_receipts() if data.get("provider") == provider]
    if not records:
        return None

    session_id = caller_session_id()
    pane_id, terminal = caller_pane()
    if session_id and pane_id:
        matches = [
            item
            for item in records
            if str(item[1].get("caller_session_id") or "") == session_id
            and str(item[1].get("caller_pane_id") or "") == pane_id
            and str(item[1].get("caller_terminal") or "") == terminal
        ]
        return matches[0] if matches else None
    if session_id:
        matches = [item for item in records if str(item[1].get("caller_session_id") or "") == session_id]
        return matches[0] if matches else None

    if pane_id:
        matches = [
            item
            for item in records
            if str(item[1].get("caller_pane_id") or "") == pane_id
            and str(item[1].get("caller_terminal") or "") == terminal
        ]
        return matches[0] if matches else None

    try:
        project_id = compute_ccb_project_id(Path.cwd())
    except Exception:
        project_id = ""
    matches = [item for item in records if project_id and item[1].get("ccb_project_id") == project_id]
    if not matches:
        return None

    identities = {_receipt_identity(data) for _path, data in matches}
    identities.discard(("", "", ""))
    if len(identities) > 1:
        print(
            f"[ERROR] Ambiguous {provider} tasks for this project; use pend <task-id>:",
            file=sys.stderr,
        )
        for _path, data in matches[:8]:
            print(f"  {data.get('task_id')}  {data.get('submitted_at', '')}", file=sys.stderr)
        raise RuntimeError("ambiguous task receipts")
    return matches[0]


def _status_finished(status_path: Path) -> tuple[bool, int | None]:
    try:
        lines = status_path.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except Exception:
        return False, None
    exit_code: int | None = None
    for line in lines:
        match = re.search(r"finished exit_code=(-?\d+)", line)
        if match:
            exit_code = int(match.group(1))
    return exit_code is not None, exit_code


def _status_pid(status_path: Path) -> int | None:
    try:
        lines = status_path.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except Exception:
        return None
    pid: int | None = None
    for line in lines:
        match = re.search(r"(?:running|spawned) pid=(\d+)", line)
        if match:
            pid = int(match.group(1))
    return pid


def _pid_is_alive(pid: int) -> bool:
    if pid <= 0:
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except (PermissionError, OSError):
        return True
    return True


def _clean_task_log(text: str) -> str:
    lines = []
    for line in text.splitlines():
        if line.startswith("[CCB_TASK_START]") or line.startswith("[CCB_TASK_END]"):
            continue
        lines.append(line)
    return "\n".join(lines).strip()


def _show_receipt(receipt: dict) -> int:
    task_id = str(receipt.get("task_id") or "")
    status_path = Path(str(receipt.get("status_file") or ""))
    log_path = Path(str(receipt.get("log_file") or ""))
    finished, exit_code = _status_finished(status_path)
    if not finished:
        pid = _status_pid(status_path)
        if pid is not None and not _pid_is_alive(pid):
            print(
                f"[INCOMPLETE] task={task_id} provider={receipt.get('provider', '')} "
                f"waiter_pid={pid} is no longer running",
                file=sys.stderr,
            )
            return EXIT_ERROR
        print(f"[PENDING] task={task_id} provider={receipt.get('provider', '')}", file=sys.stderr)
        return EXIT_NO_REPLY
    try:
        output = _clean_task_log(log_path.read_text(encoding="utf-8-sig", errors="replace"))
    except Exception as exc:
        print(f"[ERROR] Failed to read task log for {task_id}: {exc}", file=sys.stderr)
        return EXIT_ERROR
    if output:
        print(output)
    elif exit_code == 0:
        print(f"[ERROR] Task {task_id} completed without a reply", file=sys.stderr)
        return EXIT_NO_REPLY
    return EXIT_OK if exit_code == 0 else EXIT_ERROR


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="pend")
    parser.add_argument("target", help="Provider name or exact task ID")
    parser.add_argument("legacy_args", nargs="*", help=argparse.SUPPRESS)
    parser.add_argument("--legacy", action="store_true", help="Use the provider's legacy conversation reader")
    args = parser.parse_args(argv[1:])

    target = args.target.strip().lower()
    if TASK_ID_RE.match(target):
        found = find_receipt(target)
        if not found:
            print(f"[ERROR] Unknown or ambiguous task ID: {target}", file=sys.stderr)
            return EXIT_ERROR
        return _show_receipt(found[1])

    if target not in PROVIDER_PENDS:
        print(f"[ERROR] Unknown provider or task ID: {target}", file=sys.stderr)
        print(f"[ERROR] Available providers: {', '.join(PROVIDER_PENDS)}", file=sys.stderr)
        return EXIT_ERROR
    if args.legacy or args.legacy_args:
        return _legacy_pend(target, args.legacy_args)

    try:
        found = _latest_for_current_caller(target)
    except RuntimeError:
        return EXIT_ERROR
    if found:
        return _show_receipt(found[1])
    print(f"[NO TASK] No {target} task receipt for the current caller", file=sys.stderr)
    return EXIT_NO_REPLY


if __name__ == "__main__":
    sys.exit(main(sys.argv))

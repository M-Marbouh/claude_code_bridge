#!/usr/bin/env python3
"""View exact or current-session CCB task replies."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from cli_output import EXIT_ERROR, EXIT_NO_REPLY, EXIT_OK
from ccb_protocol import REQ_ID_PREFIX, is_done_text, strip_done_text
from codex_comm import CodexLogReader
from pane_registry import load_registry_by_pane, load_registry_by_session_id
from project_id import compute_ccb_project_id
from provider_log_reader import provider_log_reader
from task_receipts import caller_session_id, find_receipt, iter_receipts, read_peer_reply


PROVIDER_PENDS = {
    "gemini": "gpend",
    "codex": "cpend",
    "opencode": "opend",
    "claude": "lpend",
}
TASK_ID_RE = re.compile(r"^\d{8}-\d{6}-\d{3}-\d+(?:-\d+)?$")
PEER_PROVIDERS = {
    "claude": "codex",
    "codex": "claude",
}
DEFAULT_WAITER_TIMEOUT_SECONDS = 3600.0
WAITER_STALE_GRACE_SECONDS = 30.0
RECEIPT_COMPLETED = "completed"
RECEIPT_PENDING = "pending"
RECEIPT_PEER_AWAITING = "peer-awaiting"
RECEIPT_INCOMPLETE = "incomplete"


class OverlayItem:
    __slots__ = ("timestamp", "sequence", "source", "state", "reply", "receipt")

    def __init__(
        self,
        *,
        timestamp: float,
        sequence: int,
        source: str,
        state: str,
        reply: str = "",
        receipt: dict | None = None,
    ) -> None:
        self.timestamp = timestamp
        self.sequence = sequence
        self.source = source
        self.state = state
        self.reply = reply
        self.receipt = receipt


def _legacy_pend(provider: str, extra: list[str]) -> int:
    pend_path = script_dir / PROVIDER_PENDS[provider]
    if not pend_path.exists():
        print(f"[ERROR] Command not found: {pend_path}", file=sys.stderr)
        return EXIT_ERROR
    cmd = [sys.executable, str(pend_path), *extra] if sys.platform == "win32" else [str(pend_path), *extra]
    try:
        return subprocess.run(cmd).returncode
    except Exception as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR


def _current_project_id() -> str:
    try:
        return compute_ccb_project_id(Path.cwd())
    except Exception:
        return ""


def _executing_pane() -> tuple[str, str]:
    wezterm = (os.environ.get("WEZTERM_PANE") or "").strip()
    if wezterm:
        return wezterm, "wezterm"
    tmux = (os.environ.get("TMUX_PANE") or "").strip()
    if tmux:
        return tmux, "tmux"
    return "", ""


def _provider_for_pane(record: dict | None, pane_id: str) -> str:
    if not isinstance(record, dict) or not pane_id:
        return ""
    providers = record.get("providers")
    if isinstance(providers, dict):
        for provider, entry in providers.items():
            if (
                provider in PROVIDER_PENDS
                and isinstance(entry, dict)
                and str(entry.get("pane_id") or "").strip() == pane_id
            ):
                return provider
    for provider in PROVIDER_PENDS:
        if str(record.get(f"{provider}_pane_id") or "").strip() == pane_id:
            return provider
    return ""


def _current_session_context() -> tuple[str, str, str]:
    """Return project, strict CCB session, and the bound model provider."""
    project_id = _current_project_id()
    pane_id, terminal = _executing_pane()
    session_id = caller_session_id()
    direct_provider = (os.environ.get("CCB_CALLER") or "").strip().lower()
    current_provider = direct_provider if direct_provider in PROVIDER_PENDS else ""

    record = None
    if project_id and pane_id:
        record = load_registry_by_pane(
            pane_id,
            ccb_project_id=project_id,
            terminal=terminal,
            require_owner_alive=True,
        )
    if not session_id and isinstance(record, dict):
        session_id = str(record.get("ccb_session_id") or record.get("session_id") or "").strip()
    if not current_provider:
        current_provider = _provider_for_pane(record, pane_id)
    return project_id, session_id, current_provider


def _current_tab_registry(project_id: str, session_id: str) -> dict | None:
    if not project_id or not session_id:
        return None
    record = load_registry_by_session_id(session_id)
    if not isinstance(record, dict):
        return None
    record_project = str(record.get("ccb_project_id") or "").strip()
    if not record_project:
        work_dir = str(record.get("work_dir") or "").strip()
        if work_dir:
            try:
                record_project = compute_ccb_project_id(Path(work_dir))
            except Exception:
                record_project = ""
    record_session = str(record.get("ccb_session_id") or record.get("session_id") or "").strip()
    if record_project != project_id or record_session != session_id:
        return None
    return record


def _receipt_session_id(receipt: dict) -> str:
    return str(
        receipt.get("caller_session_id")
        or receipt.get("caller_registry_session_id")
        or ""
    ).strip()


def _receipt_responder(receipt: dict) -> str:
    provider = str(receipt.get("provider") or "").strip().lower()
    if provider.startswith("peer-"):
        return str(receipt.get("peer_provider") or provider[5:]).strip().lower()
    return provider


def _current_session_receipts(
    project_id: str,
    session_id: str,
    responder: str = "",
) -> list[tuple[Path, dict]]:
    records = [
        (path, data)
        for path, data in iter_receipts()
        if project_id
        and session_id
        and str(data.get("ccb_project_id") or "").strip() == project_id
        and _receipt_session_id(data) == session_id
        and (not responder or _receipt_responder(data) == responder)
    ]
    records.sort(
        key=lambda item: str(item[1].get("submitted_at") or item[0].name),
        reverse=True,
    )
    return records


def _resolve_responder(target: str, current_provider: str) -> tuple[str, str]:
    if target == "local":
        if not current_provider:
            return "", "'local' requires a bound model pane; use a provider name or exact task ID"
        return current_provider, ""
    if target == "peer":
        if not current_provider:
            return "", "'peer' requires a bound model pane; use a provider name or exact task ID"
        peer = PEER_PROVIDERS.get(current_provider, "")
        if not peer:
            return "", f"'peer' is not defined for {current_provider}; use a provider name or exact task ID"
        return peer, ""
    if target in PROVIDER_PENDS:
        return target, ""
    return "", f"Unknown provider, relation, or task ID: {target}"


def _parse_timestamp(value: object) -> float | None:
    raw = str(value or "").strip()
    if not raw:
        return None
    try:
        return float(raw)
    except ValueError:
        pass
    normalized = raw[:-1] + "+00:00" if raw.endswith("Z") else raw
    try:
        parsed = datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc).timestamp()


def _line_timestamp(line: str) -> tuple[str | None, float | None]:
    prefix = (line or "").split(maxsplit=1)[0] if (line or "").strip() else ""
    parsed = _parse_timestamp(prefix)
    return (prefix, parsed) if parsed is not None else (None, None)


def _status_finished(status_path: Path) -> tuple[bool, int | None, str | None]:
    try:
        lines = status_path.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except Exception:
        return False, None, None
    exit_code: int | None = None
    finished_at: str | None = None
    for line in lines:
        match = re.search(r"finished exit_code=(-?\d+)", line)
        if match:
            exit_code = int(match.group(1))
            timestamp, _parsed = _line_timestamp(line)
            if timestamp:
                finished_at = timestamp
    return exit_code is not None, exit_code, finished_at


def _status_pid(status_path: Path) -> int | None:
    try:
        lines = status_path.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except Exception:
        return None
    pid: int | None = None
    for line in lines:
        match = re.search(r"(?:running|spawned) pid=(\d+)", line)
        if match:
            pid = int(match.group(1))
    return pid


def _pid_is_alive(pid: int) -> bool:
    if pid <= 0:
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except (PermissionError, OSError):
        return True
    return True


def _status_is_stale(status_path: Path, receipt: dict, *, now: float | None = None) -> bool:
    raw_timeout = receipt.get("timeout_seconds")
    try:
        timeout = float(raw_timeout) if raw_timeout is not None else DEFAULT_WAITER_TIMEOUT_SECONDS
    except (TypeError, ValueError):
        timeout = DEFAULT_WAITER_TIMEOUT_SECONDS
    if timeout <= 0:
        return False
    try:
        modified_at = status_path.stat().st_mtime
    except OSError:
        return False
    current = time.time() if now is None else float(now)
    return current - modified_at > timeout + WAITER_STALE_GRACE_SECONDS


def _clean_task_log(text: str) -> str:
    lines = []
    for line in text.splitlines():
        if line.startswith("[CCB_TASK_START]") or line.startswith("[CCB_TASK_END]"):
            continue
        lines.append(line)
    return "\n".join(lines).strip()


def _codex_log_work_dir(log_path: Path) -> str:
    try:
        with log_path.open("r", encoding="utf-8", errors="replace") as handle:
            entry = json.loads(handle.readline())
    except Exception:
        return ""
    if entry.get("type") != "session_meta":
        return ""
    payload = entry.get("payload") if isinstance(entry.get("payload"), dict) else {}
    cwd = payload.get("cwd")
    if not isinstance(cwd, str) or not cwd.strip():
        return ""
    try:
        return str(Path(cwd).expanduser().resolve())
    except Exception:
        return cwd.strip()


def _recover_codex_reply(receipt: dict) -> str | None:
    """Recover an exact completed reply when the transport waiter failed."""
    task_id = str(receipt.get("task_id") or "").strip()
    work_dir = str(receipt.get("work_dir") or "").strip()
    if not task_id or not work_dir:
        return None
    try:
        expected_work_dir = str(Path(work_dir).expanduser().resolve())
    except Exception:
        expected_work_dir = work_dir
    root = Path(os.environ.get("CODEX_SESSION_ROOT") or (Path.home() / ".codex" / "sessions")).expanduser()
    if not root.is_dir():
        return None
    marker = f"{REQ_ID_PREFIX} {task_id}"
    try:
        candidates = sorted(
            (path for path in root.glob("**/*.jsonl") if path.is_file()),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
    except OSError:
        return None
    for candidate in candidates[:400]:
        if _codex_log_work_dir(candidate) != expected_work_dir:
            continue
        anchor_seen = False
        chunks: list[str] = []
        final_chunks: list[str] = []
        try:
            with candidate.open("r", encoding="utf-8", errors="replace") as handle:
                for line in handle:
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue
                    event = CodexLogReader._extract_event(entry)
                    if event is None:
                        continue
                    role, text, phase = event
                    if role == "user":
                        if marker in text:
                            anchor_seen = True
                            chunks = []
                            final_chunks = []
                        continue
                    if role != "assistant" or not anchor_seen:
                        continue
                    chunks.append(text)
                    combined = "\n".join(chunks)
                    done_now = is_done_text(combined, task_id)
                    if (phase == "final_answer" or done_now) and (not final_chunks or final_chunks[-1] != text):
                        final_chunks.append(text)
                    if done_now:
                        reply = "\n".join(final_chunks) if final_chunks else combined
                        return strip_done_text(reply, task_id).strip()
        except OSError:
            continue
    return None


def _recover_provider_reply(receipt: dict) -> str | None:
    if str(receipt.get("provider") or "").strip().lower() == "codex":
        return _recover_codex_reply(receipt)
    return None


def _show_receipt(receipt: dict) -> int:
    task_id = str(receipt.get("task_id") or "")
    status_path = Path(str(receipt.get("status_file") or ""))
    log_path = Path(str(receipt.get("log_file") or ""))
    peer_reply = read_peer_reply(receipt)
    if peer_reply:
        print(peer_reply)
        return EXIT_OK
    finished, exit_code, _finished_at = _status_finished(status_path)
    if not finished or exit_code != 0:
        recovered = _recover_provider_reply(receipt)
        if recovered:
            print(recovered)
            return EXIT_OK
    if not finished:
        pid = _status_pid(status_path)
        if pid is not None and not _pid_is_alive(pid) and _status_is_stale(status_path, receipt):
            print(
                f"[INCOMPLETE] task={task_id} provider={receipt.get('provider', '')} "
                f"waiter_pid={pid} is no longer running",
                file=sys.stderr,
            )
            return EXIT_ERROR
        print(f"[PENDING] task={task_id} provider={receipt.get('provider', '')}", file=sys.stderr)
        return EXIT_NO_REPLY
    if (
        exit_code == 0
        and str(receipt.get("provider") or "").startswith("peer-")
        and bool(receipt.get("reply_expected"))
    ):
        print(
            f"[PENDING] task={task_id} provider={receipt.get('provider', '')} awaiting peer reply",
            file=sys.stderr,
        )
        return EXIT_NO_REPLY
    try:
        output = _clean_task_log(log_path.read_text(encoding="utf-8-sig", errors="replace"))
    except Exception as exc:
        print(f"[ERROR] Failed to read task log for {task_id}: {exc}", file=sys.stderr)
        return EXIT_ERROR
    if output:
        print(output)
    elif exit_code == 0:
        recovered = _recover_provider_reply(receipt)
        if recovered:
            print(recovered)
            return EXIT_OK
        print(f"[ERROR] Task {task_id} completed without a reply", file=sys.stderr)
        return EXIT_NO_REPLY
    return EXIT_OK if exit_code == 0 else EXIT_ERROR


def _receipt_has_completed_reply(receipt: dict) -> bool:
    provider = str(receipt.get("provider") or "").strip().lower()
    if provider.startswith("peer-"):
        return bool(read_peer_reply(receipt))
    status_path = Path(str(receipt.get("status_file") or ""))
    finished, _exit_code, _finished_at = _status_finished(status_path)
    return finished


def classify_receipt_state(receipt: dict) -> str:
    """Classify receipt state without printing or attempting reply recovery."""
    if read_peer_reply(receipt):
        return RECEIPT_COMPLETED
    status_path = Path(str(receipt.get("status_file") or ""))
    finished, exit_code, _finished_at = _status_finished(status_path)
    if not finished:
        pid = _status_pid(status_path)
        if pid is not None and not _pid_is_alive(pid) and _status_is_stale(status_path, receipt):
            return RECEIPT_INCOMPLETE
        return RECEIPT_PENDING
    if (
        exit_code == 0
        and str(receipt.get("provider") or "").startswith("peer-")
        and bool(receipt.get("reply_expected"))
    ):
        return RECEIPT_PEER_AWAITING
    return RECEIPT_COMPLETED


def _path_mtime(path: Path) -> float | None:
    try:
        return path.stat().st_mtime
    except OSError:
        return None


def _peer_reply_time(receipt: dict) -> float | None:
    status_path = Path(str(receipt.get("status_file") or ""))
    latest: float | None = None
    try:
        lines = status_path.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except Exception:
        lines = []
    for line in lines:
        if "peer_reply_saved" not in line:
            continue
        _raw, parsed = _line_timestamp(line)
        if parsed is not None and (latest is None or parsed > latest):
            latest = parsed
    if latest is not None:
        return latest
    reply_path = Path(str(receipt.get("peer_reply_file") or ""))
    if read_peer_reply(receipt):
        return _path_mtime(reply_path)
    return None


def _receipt_timestamp(receipt: dict, state: str) -> float:
    submitted = _parse_timestamp(receipt.get("submitted_at"))
    if state != RECEIPT_COMPLETED:
        return submitted if submitted is not None else 0.0

    provider = str(receipt.get("provider") or "").strip().lower()
    if provider.startswith("peer-"):
        peer_time = _peer_reply_time(receipt)
        if peer_time is not None:
            return peer_time
    else:
        status_path = Path(str(receipt.get("status_file") or ""))
        _finished, _exit_code, finished_at = _status_finished(status_path)
        finished_time = _parse_timestamp(finished_at)
        if finished_time is not None:
            return finished_time
    if submitted is not None:
        return submitted
    status_path = Path(str(receipt.get("status_file") or ""))
    return _path_mtime(status_path) or 0.0


def _overlay_items(
    project_id: str,
    session_id: str,
    responder: str,
    records: list[tuple[Path, dict]],
    *,
    requested: int,
    explicit_count: bool,
) -> list[OverlayItem]:
    receipt_ids = {
        str(receipt.get("task_id") or "").strip()
        for _path, receipt in records
        if str(receipt.get("task_id") or "").strip()
    }
    items: list[OverlayItem] = []
    sequence = 0
    for _path, receipt in records:
        state = classify_receipt_state(receipt)
        if explicit_count and not _receipt_has_completed_reply(receipt):
            continue
        sequence -= 1
        items.append(
            OverlayItem(
                timestamp=_receipt_timestamp(receipt, state),
                sequence=sequence,
                source="receipt",
                state=state,
                receipt=receipt,
            )
        )

    record = _current_tab_registry(project_id, session_id)
    work_dir_raw = str((record or {}).get("work_dir") or Path.cwd()).strip()
    try:
        work_dir = Path(work_dir_raw).expanduser()
    except Exception:
        work_dir = Path.cwd()
    reader = provider_log_reader(
        responder,
        work_dir,
        project_id,
        strict_tab=True,
        ccb_session_id=session_id,
        registry_record=record,
        update_registry=False,
    )
    exchanges = reader.latest_exchanges(requested + len(records)) if reader is not None else []
    for exchange in reversed(exchanges):
        req_id = str(exchange.get("req_id") or "").strip()
        if req_id in receipt_ids:
            # Matching current-tab tasks are represented by their richer receipt.
            continue
        if req_id:
            # Unmatched IDs are old/foreign CCB deliveries, never manual history.
            continue
        reply = str(exchange.get("reply") or "").strip()
        if not reply:
            continue
        sequence -= 1
        items.append(
            OverlayItem(
                timestamp=_parse_timestamp(exchange.get("ts")) or 0.0,
                sequence=sequence,
                source="transcript",
                state=RECEIPT_COMPLETED,
                reply=reply,
            )
        )

    items.sort(key=lambda item: (item.timestamp, item.sequence), reverse=True)
    return items[:requested]


def _show_overlay_items(items: list[OverlayItem], *, prefix_task_ids: bool) -> int:
    result = EXIT_OK
    for index, item in enumerate(items):
        if item.source == "receipt" and item.receipt is not None:
            if prefix_task_ids:
                print(f"[TASK {item.receipt.get('task_id', '')}]")
            current = _show_receipt(item.receipt)
        else:
            print(item.reply)
            current = EXIT_OK
        if current == EXIT_ERROR:
            result = EXIT_ERROR
        elif current == EXIT_NO_REPLY and result == EXIT_OK:
            result = EXIT_NO_REPLY
        if index < len(items) - 1:
            print("---")
    return result


def _show_receipts(records: list[tuple[Path, dict]], *, prefix_task_ids: bool) -> int:
    result = EXIT_OK
    for index, (_path, receipt) in enumerate(records):
        if prefix_task_ids:
            print(f"[TASK {receipt.get('task_id', '')}]")
        current = _show_receipt(receipt)
        if current == EXIT_ERROR:
            result = EXIT_ERROR
        elif current == EXIT_NO_REPLY and result == EXIT_OK:
            result = EXIT_NO_REPLY
        if index < len(records) - 1:
            print("---")
    return result


def _positive_count(value: str) -> int:
    try:
        count = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("count must be an integer") from exc
    if count < 1:
        raise argparse.ArgumentTypeError("count must be at least 1")
    return count


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="pend")
    parser.add_argument("target", nargs="?", default="", help="Provider, peer/local relation, or exact task ID")
    parser.add_argument("count", nargs="?", type=_positive_count, help="Show the latest N task replies")
    parser.add_argument("--legacy", action="store_true", help="Use the provider's legacy conversation reader")
    args = parser.parse_intermixed_args(argv[1:])

    target = args.target.strip().lower()
    if TASK_ID_RE.match(target):
        if args.legacy or args.count is not None:
            print("[ERROR] Exact task lookup does not accept a count or --legacy", file=sys.stderr)
            return EXIT_ERROR
        found = find_receipt(target)
        if not found:
            print(f"[ERROR] Unknown or ambiguous task ID: {target}", file=sys.stderr)
            return EXIT_ERROR
        return _show_receipt(found[1])

    if args.legacy:
        if target not in PROVIDER_PENDS:
            print("[ERROR] --legacy requires an explicit provider name", file=sys.stderr)
            return EXIT_ERROR
        legacy_args = [str(args.count)] if args.count is not None else []
        return _legacy_pend(target, legacy_args)

    project_id, session_id, current_provider = _current_session_context()
    responder = ""
    if target:
        responder, error = _resolve_responder(target, current_provider)
        if error:
            print(f"[ERROR] {error}", file=sys.stderr)
            print(f"[ERROR] Available providers: {', '.join(PROVIDER_PENDS)}", file=sys.stderr)
            return EXIT_ERROR
    if not project_id or not session_id:
        print(
            "[NO SESSION] Implicit pend unavailable for the current CCB session; "
            "use an exact task ID",
            file=sys.stderr,
        )
        return EXIT_NO_REPLY

    if not target:
        records = _current_session_receipts(project_id, session_id)
        if not records:
            print(
                "[NO TASK] No task in current CCB session; use exact task ID",
                file=sys.stderr,
            )
            return EXIT_NO_REPLY
        if len(records) > 1:
            candidates = ", ".join(str(data.get("task_id") or "") for _path, data in records[:5])
            print(
                f"[AMBIGUOUS] Multiple tasks match the current CCB session: {candidates}; "
                "use an exact task ID, provider, peer, or local",
                file=sys.stderr,
            )
            return EXIT_ERROR
        return _show_receipt(records[0][1])

    records = _current_session_receipts(project_id, session_id, responder)
    if responder in {"codex", "claude"}:
        count = args.count if args.count is not None else 1
        items = _overlay_items(
            project_id,
            session_id,
            responder,
            records,
            requested=count,
            explicit_count=args.count is not None,
        )
        if not items:
            if args.count is not None:
                print(
                    f"[NO TASK] No completed {target} replies in current CCB session; "
                    "use exact task ID to inspect a pending task",
                    file=sys.stderr,
                )
            else:
                print(
                    f"[NO TASK] No {target} task in current CCB session; use exact task ID",
                    file=sys.stderr,
                )
            return EXIT_NO_REPLY
        return _show_overlay_items(items, prefix_task_ids=args.count is not None)

    if not records:
        print(
            f"[NO TASK] No {target} task in current CCB session; use exact task ID",
            file=sys.stderr,
        )
        return EXIT_NO_REPLY
    if args.count is not None:
        records = [record for record in records if _receipt_has_completed_reply(record[1])]
        if not records:
            print(
                f"[NO TASK] No completed {target} replies in current CCB session; "
                "use exact task ID to inspect a pending task",
                file=sys.stderr,
            )
            return EXIT_NO_REPLY
    count = args.count if args.count is not None else 1
    selected = records[:count]
    return _show_receipts(selected, prefix_task_ids=args.count is not None)


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/env python3
"""View the reply for an exact CCB task or the current caller's latest task."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path


script_dir = Path(__file__).resolve().parent
lib_dir = script_dir.parent / "lib"
sys.path.insert(0, str(lib_dir))

from cli_output import EXIT_ERROR, EXIT_NO_REPLY, EXIT_OK
from ccb_protocol import REQ_ID_PREFIX, is_done_text, strip_done_text
from codex_comm import CodexLogReader
from project_id import compute_ccb_project_id
from session_utils import find_project_session_file
from task_receipts import caller_pane, caller_session_id, find_receipt, iter_receipts, read_peer_reply


PROVIDER_PENDS = {
    "gemini": "gpend",
    "codex": "cpend",
    "opencode": "opend",
    "claude": "lpend",
}
TASK_ID_RE = re.compile(r"^\d{8}-\d{6}-\d{3}-\d+(?:-\d+)?$")
CALLER_SESSION_FILES = {
    "claude": ".claude-session",
    "codex": ".codex-session",
    "gemini": ".gemini-session",
    "opencode": ".opencode-session",
}
VALID_CALLERS = set(CALLER_SESSION_FILES) | {"email", "manual"}


def _legacy_pend(provider: str, extra: list[str]) -> int:
    pend_path = script_dir / PROVIDER_PENDS[provider]
    if not pend_path.exists():
        print(f"[ERROR] Command not found: {pend_path}", file=sys.stderr)
        return EXIT_ERROR
    cmd = [sys.executable, str(pend_path), *extra] if sys.platform == "win32" else [str(pend_path), *extra]
    try:
        return subprocess.run(cmd).returncode
    except Exception as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return EXIT_ERROR


def _current_caller(pane_id: str) -> str:
    direct = (os.environ.get("CCB_CALLER") or "").strip().lower()
    if direct in VALID_CALLERS:
        return direct
    if pane_id:
        for caller, filename in CALLER_SESSION_FILES.items():
            try:
                session_file = find_project_session_file(Path.cwd(), filename)
                data = json.loads(session_file.read_text(encoding="utf-8-sig")) if session_file else {}
            except Exception:
                data = {}
            session_pane = str(data.get("pane_id") or data.get("tmux_session") or "").strip()
            if session_pane == pane_id:
                return caller
    return "manual" if not pane_id else ""


def _latest_for_current_caller(provider: str) -> tuple[Path, dict] | None:
    try:
        project_id = compute_ccb_project_id(Path.cwd())
    except Exception:
        project_id = ""
    records = [
        (path, data)
        for path, data in iter_receipts()
        if data.get("provider") == provider
        and project_id
        and data.get("ccb_project_id") == project_id
    ]
    if not records:
        return None

    session_id = caller_session_id()
    pane_id, terminal = caller_pane()
    caller = _current_caller(pane_id)
    caller_records = (
        [item for item in records if str(item[1].get("caller") or "").strip().lower() == caller]
        if caller
        else []
    )
    legacy_records = [item for item in records if not str(item[1].get("caller") or "").strip()]
    if session_id and pane_id:
        matches = [
            item
            for item in caller_records + legacy_records
            if str(item[1].get("caller_session_id") or "") == session_id
            and str(item[1].get("caller_pane_id") or "") == pane_id
            and str(item[1].get("caller_terminal") or "") == terminal
        ]
        if matches:
            return matches[0]

    if pane_id:
        matches = [
            item
            for item in caller_records
            if str(item[1].get("caller_pane_id") or "") == pane_id
            and str(item[1].get("caller_terminal") or "") == terminal
        ]
        if matches:
            return matches[0]

    # CCB enforces one provider instance per project. After a restart, pane and
    # session IDs legitimately change. The persisted caller field is stable
    # across that restart and prevents a sibling provider pane from winning.
    return caller_records[0] if caller_records else None


def _status_finished(status_path: Path) -> tuple[bool, int | None]:
    try:
        lines = status_path.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except Exception:
        return False, None
    exit_code: int | None = None
    for line in lines:
        match = re.search(r"finished exit_code=(-?\d+)", line)
        if match:
            exit_code = int(match.group(1))
    return exit_code is not None, exit_code


def _status_pid(status_path: Path) -> int | None:
    try:
        lines = status_path.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except Exception:
        return None
    pid: int | None = None
    for line in lines:
        match = re.search(r"(?:running|spawned) pid=(\d+)", line)
        if match:
            pid = int(match.group(1))
    return pid


def _pid_is_alive(pid: int) -> bool:
    if pid <= 0:
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except (PermissionError, OSError):
        return True
    return True


def _clean_task_log(text: str) -> str:
    lines = []
    for line in text.splitlines():
        if line.startswith("[CCB_TASK_START]") or line.startswith("[CCB_TASK_END]"):
            continue
        lines.append(line)
    return "\n".join(lines).strip()


def _codex_log_work_dir(log_path: Path) -> str:
    try:
        with log_path.open("r", encoding="utf-8", errors="replace") as handle:
            entry = json.loads(handle.readline())
    except Exception:
        return ""
    if entry.get("type") != "session_meta":
        return ""
    payload = entry.get("payload") if isinstance(entry.get("payload"), dict) else {}
    cwd = payload.get("cwd")
    if not isinstance(cwd, str) or not cwd.strip():
        return ""
    try:
        return str(Path(cwd).expanduser().resolve())
    except Exception:
        return cwd.strip()


def _recover_codex_reply(receipt: dict) -> str | None:
    """Recover an exact completed reply when the transport waiter failed."""
    task_id = str(receipt.get("task_id") or "").strip()
    work_dir = str(receipt.get("work_dir") or "").strip()
    if not task_id or not work_dir:
        return None
    try:
        expected_work_dir = str(Path(work_dir).expanduser().resolve())
    except Exception:
        expected_work_dir = work_dir
    root = Path(os.environ.get("CODEX_SESSION_ROOT") or (Path.home() / ".codex" / "sessions")).expanduser()
    if not root.is_dir():
        return None
    marker = f"{REQ_ID_PREFIX} {task_id}"
    try:
        candidates = sorted(
            (path for path in root.glob("**/*.jsonl") if path.is_file()),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
    except OSError:
        return None
    for candidate in candidates[:400]:
        if _codex_log_work_dir(candidate) != expected_work_dir:
            continue
        anchor_seen = False
        chunks: list[str] = []
        final_chunks: list[str] = []
        try:
            with candidate.open("r", encoding="utf-8", errors="replace") as handle:
                for line in handle:
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue
                    event = CodexLogReader._extract_event(entry)
                    if event is None:
                        continue
                    role, text, phase = event
                    if role == "user":
                        if marker in text:
                            anchor_seen = True
                            chunks = []
                            final_chunks = []
                        continue
                    if role != "assistant" or not anchor_seen:
                        continue
                    chunks.append(text)
                    combined = "\n".join(chunks)
                    done_now = is_done_text(combined, task_id)
                    if (phase == "final_answer" or done_now) and (not final_chunks or final_chunks[-1] != text):
                        final_chunks.append(text)
                    if done_now:
                        reply = "\n".join(final_chunks) if final_chunks else combined
                        return strip_done_text(reply, task_id).strip()
        except OSError:
            continue
    return None


def _recover_provider_reply(receipt: dict) -> str | None:
    if str(receipt.get("provider") or "").strip().lower() == "codex":
        return _recover_codex_reply(receipt)
    return None


def _show_receipt(receipt: dict) -> int:
    task_id = str(receipt.get("task_id") or "")
    status_path = Path(str(receipt.get("status_file") or ""))
    log_path = Path(str(receipt.get("log_file") or ""))
    peer_reply = read_peer_reply(receipt)
    if peer_reply:
        print(peer_reply)
        return EXIT_OK
    finished, exit_code = _status_finished(status_path)
    if not finished or exit_code != 0:
        recovered = _recover_provider_reply(receipt)
        if recovered:
            print(recovered)
            return EXIT_OK
    if not finished:
        pid = _status_pid(status_path)
        if pid is not None and not _pid_is_alive(pid):
            print(
                f"[INCOMPLETE] task={task_id} provider={receipt.get('provider', '')} "
                f"waiter_pid={pid} is no longer running",
                file=sys.stderr,
            )
            return EXIT_ERROR
        print(f"[PENDING] task={task_id} provider={receipt.get('provider', '')}", file=sys.stderr)
        return EXIT_NO_REPLY
    if (
        exit_code == 0
        and str(receipt.get("provider") or "").startswith("peer-")
        and bool(receipt.get("reply_expected"))
    ):
        print(
            f"[PENDING] task={task_id} provider={receipt.get('provider', '')} awaiting peer reply",
            file=sys.stderr,
        )
        return EXIT_NO_REPLY
    try:
        output = _clean_task_log(log_path.read_text(encoding="utf-8-sig", errors="replace"))
    except Exception as exc:
        print(f"[ERROR] Failed to read task log for {task_id}: {exc}", file=sys.stderr)
        return EXIT_ERROR
    if output:
        print(output)
    elif exit_code == 0:
        recovered = _recover_provider_reply(receipt)
        if recovered:
            print(recovered)
            return EXIT_OK
        print(f"[ERROR] Task {task_id} completed without a reply", file=sys.stderr)
        return EXIT_NO_REPLY
    return EXIT_OK if exit_code == 0 else EXIT_ERROR


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="pend")
    parser.add_argument("target", help="Provider name or exact task ID")
    parser.add_argument("legacy_args", nargs="*", help=argparse.SUPPRESS)
    parser.add_argument("--legacy", action="store_true", help="Use the provider's legacy conversation reader")
    args = parser.parse_args(argv[1:])

    target = args.target.strip().lower()
    if TASK_ID_RE.match(target):
        found = find_receipt(target)
        if not found:
            print(f"[ERROR] Unknown or ambiguous task ID: {target}", file=sys.stderr)
            return EXIT_ERROR
        return _show_receipt(found[1])

    if target not in PROVIDER_PENDS:
        print(f"[ERROR] Unknown provider or task ID: {target}", file=sys.stderr)
        print(f"[ERROR] Available providers: {', '.join(PROVIDER_PENDS)}", file=sys.stderr)
        return EXIT_ERROR
    if args.legacy or args.legacy_args:
        return _legacy_pend(target, args.legacy_args)

    try:
        found = _latest_for_current_caller(target)
    except RuntimeError:
        return EXIT_ERROR
    if found:
        return _show_receipt(found[1])
    print(f"[NO TASK] No {target} task receipt for the current caller", file=sys.stderr)
    return EXIT_NO_REPLY


if __name__ == "__main__":
    sys.exit(main(sys.argv))
